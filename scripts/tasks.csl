TASK_DROPDOWN_SLICE_PX   :: 16.0;

TASK_TEX_CHECKBOX         :: "UI/task list/checkbox.png";
TASK_TEX_CHECKBOX_FILLED  :: "UI/task list/checkbox_filled.png";
TASK_TEX_HEADER           :: "UI/task list/task_backing.png";
TASK_TEX_DROPDOWN_ARROW   :: "UI/task list/dropdown_arrow.png";
TASK_TEX_LIST_BG          :: "UI/task list/task_list_dropdown_area.png";
TASK_TEX_HELP_BG          :: "UI/task list/task_help_backing.png";
TASK_TEX_INFO_ICON        :: "UI/info_icon_b.png";
