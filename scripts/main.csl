    ensure_entity_override_rig :: method() -> bool {
        if entity_override_state_machine != null {
            //entity_override_state_machine.debug_enabled = true;
            return #alive(override_rig) && override_rig.instance != null;
        }

        if entity_override_rig_asset == null {
            entity_override_rig_asset = get_asset(Spine_Asset, ENTITY_OVERRIDE_RIG_PATH);
        }

        if entity_override_rig_asset == null || !#alive(override_rig) || override_rig.instance == null {
            return false;
        }

        override_rig.instance.set_skeleton(entity_override_rig_asset);
        override_rig.instance.disable_all_skins();
        override_rig.instance.enable_skin("default");
        override_rig.instance.refresh_skins();

        sm := State_Machine.create();
        //sm.debug_enabled = true;
        entity_override_state_machine = sm;

        layer := sm.create_layer("main", 0);
        idle_state := layer.create_state("idle", true);
        run_state := layer.create_state("run", true);
        run_fast_state := layer.create_state("run_fast", true);
        bite_state := layer.create_state("bite", false);
        convertbreath_state := layer.create_state("convertbreath", false);
        scream_state := layer.create_state("scream", false);
        teleport_appear_state := layer.create_state("teleport_appear", false);
        teleport_disappear_state := layer.create_state("teleport_disapear", false);
        vomit_state := layer.create_state("vomit", false);

        layer.set_initial_state(idle_state);

        is_moving_var := sm.create_variable("is_moving", .BOOL);
        is_lurching_var := sm.create_variable("is_lurching", .BOOL);
        bite_var := sm.create_variable("bite", .TRIGGER);
        convertbreath_var := sm.create_variable("convertbreath", .TRIGGER);
        scream_var := sm.create_variable("scream", .TRIGGER);
        teleport_appear_var := sm.create_variable("teleport_appear", .TRIGGER);
        teleport_disappear_var := sm.create_variable("teleport_disapear", .TRIGGER);
        vomit_var := sm.create_variable("vomit", .TRIGGER);

        idle_to_run := layer.create_transition(idle_state, run_state, false);
        idle_to_run.create_bool_condition(is_moving_var, true);
        idle_to_run.create_bool_condition(is_lurching_var, false);

        idle_to_run_fast := layer.create_transition(idle_state, run_fast_state, false);
        idle_to_run_fast.create_bool_condition(is_moving_var, true);
        idle_to_run_fast.create_bool_condition(is_lurching_var, true);

        layer.create_transition(run_state, idle_state, false).create_bool_condition(is_moving_var, false);
        layer.create_transition(run_state, run_fast_state, false).create_bool_condition(is_lurching_var, true);

        layer.create_transition(run_fast_state, idle_state, false).create_bool_condition(is_moving_var, false);
        run_fast_to_run := layer.create_transition(run_fast_state, run_state, false);
        run_fast_to_run.create_bool_condition(is_moving_var, true);
        run_fast_to_run.create_bool_condition(is_lurching_var, false);

        to_bite := layer.create_global_transition(bite_state, true);
        to_bite.create_trigger_condition(bite_var);
        layer.create_transition(bite_state, idle_state, true);

        to_convertbreath := layer.create_global_transition(convertbreath_state, true);
        to_convertbreath.create_trigger_condition(convertbreath_var);
        layer.create_transition(convertbreath_state, idle_state, true);

        to_scream := layer.create_global_transition(scream_state, true);
        to_scream.create_trigger_condition(scream_var);
        layer.create_transition(scream_state, idle_state, true);

        to_teleport_appear := layer.create_global_transition(teleport_appear_state, true);
        to_teleport_appear.create_trigger_condition(teleport_appear_var);
        layer.create_transition(teleport_appear_state, idle_state, true);

        to_teleport_disappear := layer.create_global_transition(teleport_disappear_state, true);
        to_teleport_disappear.create_trigger_condition(teleport_disappear_var);
        layer.create_transition(teleport_disappear_state, idle_state, true);

        to_vomit := layer.create_global_transition(vomit_state, true);
        to_vomit.create_trigger_condition(vomit_var);
        layer.create_transition(vomit_state, idle_state, true);

        override_rig.instance.set_state_machine(sm, true);
        return true;
    }

    ensure_minion_override_rig :: method() -> bool {
        if minion_override_state_machine != null {
            return #alive(override_rig) && override_rig.instance != null;
        }

        if minion_override_rig_asset == null {
            minion_override_rig_asset = get_asset(Spine_Asset, MINION_OVERRIDE_RIG_PATH);
        }

        if minion_override_rig_asset == null || !#alive(override_rig) || override_rig.instance == null {
            return false;
        }

        override_rig.instance.set_skeleton(minion_override_rig_asset);
        override_rig.instance.disable_all_skins();
        override_rig.instance.enable_skin("default");
        override_rig.instance.refresh_skins();

        sm := State_Machine.create();
        minion_override_state_machine = sm;

        layer := sm.create_layer("main", 0);
        idle_state := layer.create_state("beast/idle", true);
        run_state := layer.create_state("beast/run", true);
        hatch_state := layer.create_state("beast/hatch", false);

        layer.set_initial_state(idle_state);

        is_moving_var := sm.create_variable("is_moving", .BOOL);
        hatch_var := sm.create_variable("hatch", .TRIGGER);

        layer.create_transition(idle_state, run_state, false).create_bool_condition(is_moving_var, true);
        layer.create_transition(run_state, idle_state, false).create_bool_condition(is_moving_var, false);

        to_hatch := layer.create_global_transition(hatch_state, true);
        to_hatch.create_trigger_condition(hatch_var);
        layer.create_transition(hatch_state, idle_state, true);

        override_rig.instance.set_state_machine(sm, true);
        return true;
    }

    set_entity_override_active :: method(active: bool) {
        if #alive(override_rig) {
            override_rig.entity.set_local_enabled(active);
            if round_minion {
                offset := MINION_OVERRIDE_OFFSET;
                scale := MINION_OVERRIDE_SCALE;
                if active && is_entity_flashbanged(this) {
                    alpha := get_entity_flashbang_alpha(this);
                    t := get_time();
                    offset.x += sin(t * MINION_FLASHBANG_SHAKE_SPEED) * MINION_FLASHBANG_SHAKE_DISTANCE * alpha;
                    offset.y += cos(t * MINION_FLASHBANG_SHAKE_SPEED * 1.37) * MINION_FLASHBANG_SHAKE_DISTANCE * 0.55 * alpha;
                    pulse := 1.0 + sin(t * MINION_FLASHBANG_SCALE_PULSE_SPEED) * MINION_FLASHBANG_SCALE_PULSE * alpha;
                    scale = v2.{MINION_OVERRIDE_SCALE.x * pulse, MINION_OVERRIDE_SCALE.y * pulse};
                }
                override_rig.entity.set_local_position(offset);
                override_rig.entity.set_local_scale(scale);
            } else {
                override_rig.entity.set_local_position(ENTITY_OVERRIDE_OFFSET);
                override_rig.entity.set_local_scale(ENTITY_OVERRIDE_SCALE);
            }
        }
        if animator != null {
            animator.set_enabled(!active);
            if active {
                this.set_animator_alpha(0.0);
            } else {
                this.set_animator_alpha(1.0);
            }
        }
    }

    destroy_held_item_visual :: method() {
        if held_item_entity != null && #alive(held_item_entity) {
            held_item_entity.destroy();
        }
        held_item_entity = null;
        held_item_sprite = null;
        held_item_weapon_type = .NONE;
    }

    destroy_jumpscare_overlay :: method() {
        if !this.is_local_or_server() {
            return;
        }
        if jumpscare_overlay_spine != null {
            jumpscare_overlay_spine.destroy();
            jumpscare_overlay_spine = null;
        }
        jumpscare_overlay_ends_at = 0.0;
    }

    force_viewfinder_off :: method() {
        if !viewfinder_active {
            return;
        }

        viewfinder_active = false;
        if this.is_local() {
            sync_all_viewfinder_only_visibility();
        }
    }

    start_jumpscare_overlay :: method() {
        if !this.is_local_or_server() {
            return;
        }

        this.force_viewfinder_off();
        this.destroy_jumpscare_overlay();
        if jumpscare_overlay_asset == null {
            jumpscare_overlay_asset = get_asset(Spine_Asset, JUMPSCARE_OVERLAY_SPINE_PATH);
        }
        if jumpscare_overlay_asset == null {
            return;
        }

        jumpscare_overlay_spine = Spine_Instance.create();
        jumpscare_overlay_spine.set_skeleton(jumpscare_overlay_asset);
        jumpscare_overlay_spine.set_animation("appear", false, 0);
        jumpscare_overlay_ends_at = get_time() + JUMPSCARE_OVERLAY_SECONDS;
    }

    update_jumpscare_overlay :: method(dt: float) {
        if !this.is_local_or_server() {
            return;
        }
        if jumpscare_overlay_request_id > jumpscare_overlay_seen_request_id {
            jumpscare_overlay_seen_request_id = jumpscare_overlay_request_id;
            this.start_jumpscare_overlay();
        }
        if jumpscare_overlay_spine == null {
            return;
        }
        if get_time() >= jumpscare_overlay_ends_at {
            this.destroy_jumpscare_overlay();
            return;
        }

        jumpscare_overlay_spine.update(dt);
    }

    draw_jumpscare_overlay :: method() {
        if !this.is_local_or_server() || jumpscare_overlay_spine == null {
            return;
        }
        UI.push_screen_draw_context();
        defer UI.pop_draw_context();

        UI.push_layer(JUMPSCARE_OVERLAY_LAYER);
        defer UI.pop_layer();

        screen := UI.get_safe_screen_rect();
        UI.spine(screen.center(), jumpscare_overlay_spine, JUMPSCARE_OVERLAY_SCALE, 0.0);
    }

    ensure_held_item_visual :: method(wt: Weapon_Type) {
        if wt == held_item_weapon_type && held_item_entity != null && #alive(held_item_entity) && held_item_sprite != null {
            return;
        }

        this.destroy_held_item_visual();

        if wt != .FLASHBANG && wt != .NOISEMAKER && wt != .STIM {
            return;
        }

        texture_path := get_weapon_config(wt).weapon_icon_path;
        if texture_path.count == 0 {
            return;
        }

        held_texture := get_asset(Texture_Asset, texture_path);
        if held_texture == null {
            return;
        }

        new_held_item := Scene.create_entity();
        new_held_item.set_parent(entity, false);
        new_held_item.set_local_enabled(true);
        new_held_item.set_local_position(v2.{0.0, 0.0});
        new_held_item.set_local_rotation(0.0);
        new_held_item.set_local_scale(HELD_ITEM_SCALE);

        sprite := new_held_item.add_component(Sprite_Renderer);
        sprite.set_texture(held_texture);
        sprite.layer = HELD_ITEM_RENDER_LAYER;
        sprite.mask_in_shadow = true;

        held_item_entity = new_held_item;
        held_item_sprite = sprite;
        held_item_weapon_type = wt;
    }

    update_held_item_visual :: method() {
        if !this.is_round_survivor() || round_dead || round_downed {
            this.destroy_held_item_visual();
            return;
        }

        if equipped_weapon_type != .FLASHBANG && equipped_weapon_type != .NOISEMAKER && equipped_weapon_type != .STIM {
            this.destroy_held_item_visual();
            return;
        }

        if animator == null || animator.instance == null {
            this.destroy_held_item_visual();
            return;
        }

        this.ensure_held_item_visual(equipped_weapon_type);
        if held_item_entity == null || !#alive(held_item_entity) {
            return;
        }

        if held_item_sprite != null && animator != null {
            tint := held_item_sprite.color;
            tint.w = animator.color_multiplier.w;
            held_item_sprite.color = tint;
        }

        hand_local := animator.get_bone_local_position(HELD_ITEM_BONE_NAME);
        hand_scale := animator.scale;

        held_item_entity.set_local_position(v2{hand_local.x * hand_scale.x, hand_local.y * hand_scale.y});

        held_scale_x := HELD_ITEM_SCALE.x;
        if hand_scale.x < 0.0 {
            held_scale_x = -HELD_ITEM_SCALE.x;
        }
        held_item_entity.set_local_scale(v2{held_scale_x, HELD_ITEM_SCALE.y});
    }

    sync_local_camera_size :: proc(using this: Player) {
        if !this.is_local() {
            return;
        }

        gm := get_game_manager();
        if #alive(gm) && gm.is_end_game_cutscene_active() {
            camera.follow_player = false;
            camera.position = gm.get_end_game_cutscene_position();
            camera.size = END_GAME_CUTSCENE_CAMERA_SIZE;
            return;
        }

        if security_cameras_open {
            security_camera := get_security_camera_by_wrapped_index(security_camera_index);
            if security_camera != null {
                security_camera_index = wrap_security_camera_index(security_camera_index, get_live_security_camera_count());
                camera.follow_player = false;
                camera.position = security_camera.get_view_position();
                camera.size = security_camera.get_view_size();
                return;
            }

            close_security_cameras_for_player(this);
        }

        camera.follow_player = true;

        desired_camera_size := default_camera_size;
        if desired_camera_size <= 0.0 {
            desired_camera_size = camera.size;
            default_camera_size = desired_camera_size;
        }

        if #alive(gm) && gm.is_round_in_progress() {
            desired_camera_size += ROUND_CAMERA_SIZE_DELTA;
        }

        if this.is_round_dead() {
            desired_camera_size += ROUND_DEAD_CAMERA_SIZE_DELTA;
        } else if this.is_round_entity() {
            desired_camera_size += ENTITY_CAMERA_SIZE_DELTA;
        }

        if cheat_wide_view_active {
            desired_camera_size = max(desired_camera_size, CHEAT_WIDE_VIEW_CAMERA_SIZE);
        }

        camera.size = desired_camera_size;
    }

    sync_local_wide_view_shadows :: method() {
        if !this.is_local() {
            return;
        }

        gm := get_game_manager();
        if #alive(gm) && #alive(gm.Shadows) {
            gm.Shadows.set_local_enabled(!cheat_wide_view_active);
        }
    }

    handle_wide_view_cheat_keybind :: method() {
        if !is_local_or_server() || device_kind != .PC {
            cheat_wide_view_key_was_held = false;
            return;
        }

        register_wide_view_cheat_keybind();
        held := Keybinds.get_keybind_held(this, wide_view_cheat_keybind);
        if held && !cheat_wide_view_key_was_held {
            toggle_wide_view_cheat(this);
        }
        cheat_wide_view_key_was_held = held;
    }

    snap_local_camera_to_player :: method() {
        if !this.is_local() || !#alive(entity) {
            return;
        }

        camera.follow_player = true;
        camera.position = entity.world_position;
    }

    trigger_warp_to_backrooms_static :: method() {
        warp_to_backrooms_static_started_at = get_time();
    }

    draw_warp_to_backrooms_static_ui :: method() {
        if !this.is_local() || warp_to_backrooms_static_started_at <= 0.0 {
            return;
        }

        elapsed := get_time() - warp_to_backrooms_static_started_at;
        if elapsed < 0.0 || elapsed >= WARP_TO_BACKROOMS_STATIC_SECONDS * 2.0 {
            return;
        }

        static_alpha := 0.0;
        chromatic_t := 0.0;
        if elapsed < WARP_TO_BACKROOMS_STATIC_SECONDS {
            t := clamp(elapsed / WARP_TO_BACKROOMS_STATIC_SECONDS, 0.0, 1.0);
            static_alpha = 1.0 - pow(t, 2.0);
            chromatic_t = t;
        } else {
            t := clamp((elapsed - WARP_TO_BACKROOMS_STATIC_SECONDS) / WARP_TO_BACKROOMS_STATIC_SECONDS, 0.0, 1.0);
            chromatic_t = 1.0 - t;
        }

        draw_survivor_static_effect(static_alpha, chromatic_t);
    }

    update_local_voice_chat_range_cache :: method() {
        if !this.is_local() || local_voice_chat_muted_for_round_dead {
            return;
        }

        current_voice_range := Voice.get_range();
        if current_voice_range > 0.0 {
            local_voice_chat_enabled_range = current_voice_range;
        }
    }

    set_local_round_dead_voice_chat_muted :: method(muted: bool) {
        if !this.is_local() {
            return;
        }

        if muted {
            if local_voice_chat_muted_for_round_dead {
                return;
            }

            current_voice_range := Voice.get_range();
            if current_voice_range > 0.0 {
                local_voice_chat_enabled_range = current_voice_range;
            }

            Voice.set_range(0.0);
            local_voice_chat_muted_for_round_dead = true;
            return;
        }

        if !local_voice_chat_muted_for_round_dead {
            return;
        }

        local_voice_chat_muted_for_round_dead = false;
        if local_voice_chat_enabled_range > 0.0 {
            Voice.set_range(local_voice_chat_enabled_range);
        }
    }

    sync_camera_item_mouse_ik :: method() {
        if equipped_weapon_type != .CAMERA {
            return;
        }
        if round_dead || round_downed || this.is_round_entity() {
            this.set_mouse_ik_enabled(false);
            return;
        }

        this.set_mouse_ik_enabled(true);
        aim_dir := last_aim_direction;
        if this.is_local() {
            aim_offset := get_mouse_world_position() - entity.world_position;
            if length_squared(aim_offset) > 0.0001 {
                aim_dir = normalize(aim_offset);
                last_aim_direction = aim_dir;
            }
        }
        if length_squared(aim_dir) <= 0.0001 {
            aim_dir = v2{1.0, 0.0};
        }
        this.set_aim_target(entity.world_position + aim_dir * 5.0);
    }

    ao_start :: method() {
        entity_opt_in = false;
        current_zone = .None;
        active_tasks = List(Task_Base).{};
        task_list_inited = false;
        task_list_open = true;
        task_help_open = false;
        chat_mode_inited = false;
        sabotage_modal_open = false;
        jumpscare_target_modal_open = false;
        security_cameras_open = false;
        security_camera_index = 0;
        jumpscare_request_target_user_id = "";
        jumpscare_request_id = 0;
        jumpscare_processed_request_id = 0;
        jumpscare_cooldown_ends_at = 0.0;
        jumpscare_overlay_request_id = 0;
        jumpscare_overlay_seen_request_id = 0;
        jumpscare_overlay_ends_at = 0.0;
        jumpscare_overlay_spine = null;
        ensure_sprint_resources();
        footstep_stride_accum = 0.0;
        footstep_left_next = false;
        entity_local_view_alpha = 0.0;
        entity_local_view_is_active = false;
        entity_local_view_fade_out_seconds = ENTITY_VIEW_PLAYER_REVEAL_FADE_OUT_SECONDS;
        entity_scream_reveal_remaining = 0.0;
        entity_scream_arrow_remaining = 0.0;
        entity_scream_arrow_zone = .None;
        entity_scream_arrow_target_user_ids.clear();
        entity_target_ping_remaining = 0.0;
        entity_target_ping_user_id = "";
        entity_target_ping_requires_same_zone = false;
        entity_target_ping_source_zone = .None;
        ghost_item_ping_cooldown_ends_at = 0.0;
        entity_name_hidden = false;
        silhouette_material_applied = false;
        current_stamina = SPRINT_STAMINA_MAX;
        max_stamina = SPRINT_STAMINA_MAX;
        default_camera_size = camera.size;
        cheat_wide_view_active = false;
        cheat_wide_view_key_was_held = false;
        sprint_last_applied_speed = 0.0;
        sprint_has_applied_speed = false;
        sprint_lockout_remaining = 0.0;
        sprint_input_held = false;
        sprint_active = false;
        entity_lurch_remaining = 0.0;
        minion_bite_hit_react_remaining = 0.0;
        round_downed = false;
        round_dead = false;
        round_dead_was_minion = false;
        round_minion = false;
        round_revive_request_id = 0;
        round_revive_seen_request_id = 0;
        round_minion_hatch_request_id = 0;
        round_minion_hatch_seen_request_id = 0;
        round_dead_ghost_state_active = false;
        local_voice_chat_enabled_range = 0.0;
        local_voice_chat_muted_for_round_dead = false;
        downed_scream_remaining = 0.0;
        downed_bleed_out_ends_at = 0.0;
        vent_cooldown_ends_at = 0.0;
        warp_to_backrooms_static_started_at = 0.0;
        end_game_cutscene_dance_triggered = false;
        entity_cached_facing_right = true;
        playerWins = Save.get_int(this, PLAYER_WINS_SAVE_KEY, 0);
        this.sync_player_wins_leaderboard();
        held_item_weapon_type = .NONE;
        viewfinder_active = false;
        dropped_item_visibility_initialized = false;
        dropped_item_visibility_hidden_for_entity = false;
        dropped_item_visibility_refresh_elapsed = 0.0;
        this.update_local_voice_chat_range_cache();

        wt := entity.add_component(Weapon_Target);
        wt.health = 100.0;
        wt.max_health = 100.0;
        wt.owner_entity_id = entity.id;
        weapon_target = wt;

        downed_revive_interactable = entity.add_component(Downed_Revive_Interactable);
        downed_revive_interactable.target_player = this;

        last_selected_index = -1;

        override_entity := Scene.create_entity();
        override_entity.set_parent(this.entity, false);
        override_entity.set_local_enabled(true);
        override_entity.set_local_position(v2.{0.0, 0.0});
        override_entity.set_local_rotation(0.0);
        override_entity.set_local_scale(ENTITY_OVERRIDE_SCALE);
        override_entity.set_local_enabled(false);

        override_rig = override_entity.add_component(Spine_Animator);
        override_rig.mask_in_shadow = true;

        init_weapon_items();
        setup_reusable_weapons_player_state_machine(this);
        if animator != null && animator.state_machine != null {
            //animator.state_machine.debug_enabled = true;
        }
        if #alive(agent) {
            base_movement_speed = agent.movement_speed;
        }
        lock_player_to_game_navmesh(this);

        gm := get_game_manager();
        if #alive(gm) {
            gm.teleport_player_to_lobby_spawn(this);
            gm.handle_round_player_joined(this);
        }
    }

    increment_player_wins :: method() {
        if !is_local_or_server() {
            return;
        }
        playerWins += 1;
        Save.set_int(this, PLAYER_WINS_SAVE_KEY, playerWins);
        this.sync_player_wins_leaderboard();
    }

    sync_player_wins_leaderboard :: method() {
        if !Game.is_server() || playerWins <= 0 {
            return;
        }
        Save.ordered_set(PLAYER_WINS_SAVE_KEY, this.get_user_id(), playerWins.(f64));
    }

    is_round_entity :: method() -> bool {
        gm := get_game_manager();
        if !#alive(gm) {
            return false;
        }
        if gm.phase != .SURVIVOR_HEAD_START && gm.phase != .ACTIVE {
            return false;
        }
        return gm.is_entity_player(this);
    }

    is_round_minion :: method() -> bool {
        gm := get_game_manager();
        if !#alive(gm) {
            return false;
        }
        if gm.phase != .SURVIVOR_HEAD_START && gm.phase != .ACTIVE {
            return false;
        }
        return round_minion && !round_dead;
    }

    is_round_survivor :: method() -> bool {
        gm := get_game_manager();
        if !#alive(gm) {
            return false;
        }
        if round_dead {
            return false;
        }
        if round_minion {
            return false;
        }
        if gm.phase != .SURVIVOR_HEAD_START && gm.phase != .ACTIVE {
            return false;
        }
        return gm.is_survivor_player(this);
    }

    is_round_dead :: method() -> bool {
        return round_dead;
    }

    is_round_downed :: method() -> bool {
        return round_downed && !round_dead;
    }

    update_chat_mode :: proc(using this: Player) {
        desired := Chat.Mode.DEFAULT;
        // In-game: bubble-only chat for alive players (ghosts stay in default chat).
        if this.is_round_entity() || this.is_round_minion() || this.is_round_survivor() {
            desired = Chat.Mode.BUBBLE_ONLY;
        }

        if chat_mode_inited && desired == chat_mode_last_applied return;

        Chat.set_mode(desired);
        chat_mode_last_applied = desired;
        chat_mode_inited = true;
    }

    clear_round_downed_state :: method(reset_animation: bool = false) {
        round_downed = false;
        downed_scream_remaining = 0.0;
        downed_bleed_out_ends_at = 0.0;

        if animator != null && animator.instance != null {
            animator.state_machine.set_bool("downed", false);
            animator.state_machine.set_bool("downed_hit_reacting", false);
            if reset_animation {
                animator.state_machine.set_trigger("RESET");
            }
        }
    }

    clear_round_death_state :: method(reset_animation: bool = true) {
        this.clear_round_downed_state();
        footstep_stride_accum = 0.0;
        round_dead = false;
        round_dead_was_minion = false;
        round_minion = false;
        round_minion_hatch_request_id = 0;
        round_minion_hatch_seen_request_id = 0;
        round_dead_ghost_state_active = false;
        this.set_local_round_dead_voice_chat_muted(false);
        entity_local_view_alpha = 0.0;
        entity_local_view_is_active = false;
        entity_local_view_fade_out_seconds = ENTITY_VIEW_PLAYER_REVEAL_FADE_OUT_SECONDS;
        entity_scream_reveal_remaining = 0.0;
        entity_scream_arrow_remaining = 0.0;
        entity_scream_arrow_zone = .None;
        entity_scream_arrow_target_user_ids.clear();
        entity_target_ping_remaining = 0.0;
        entity_target_ping_user_id = "";
        entity_target_ping_requires_same_zone = false;
        entity_target_ping_source_zone = .None;
        ghost_item_ping_cooldown_ends_at = 0.0;

        if #alive(agent) {
            agent.velocity = v2{0.0, 0.0};
            agent.movement_speed = base_movement_speed;
        }
        lock_player_to_game_navmesh(this);

        if animator != null && animator.instance != null {
            animator.state_machine.set_bool("round_dead", false);
            animator.state_machine.set_bool("ghost_form", false);
            animator.state_machine.set_bool("sprinting", false);
        }
        if reset_animation && animator != null && animator.instance != null {
            animator.state_machine.set_trigger("RESET");
        }
    }

    clear_round_minion_state :: method() {
        if !round_minion {
            return;
        }

        round_minion = false;
        round_minion_hatch_request_id = 0;
        round_minion_hatch_seen_request_id = 0;
        minion_override_state_machine = null;
        sprint_input_held = false;
        sprint_active = false;
        current_stamina = SPRINT_STAMINA_MAX;
        max_stamina = SPRINT_STAMINA_MAX;
        sprint_lockout_remaining = 0.0;
        entity_local_view_alpha = 0.0;
        entity_local_view_is_active = false;
        entity_scream_reveal_remaining = 0.0;
        entity_scream_arrow_remaining = 0.0;
        entity_scream_arrow_zone = .None;
        entity_scream_arrow_target_user_ids.clear();
        entity_target_ping_remaining = 0.0;
        entity_target_ping_user_id = "";
        entity_target_ping_requires_same_zone = false;
        entity_target_ping_source_zone = .None;

        if #alive(agent) {
            agent.velocity = v2{0.0, 0.0};
            agent.movement_speed = base_movement_speed;
        }
        this.set_entity_override_active(false);
        lock_player_to_game_navmesh(this);
    }

    convert_to_minion :: method() -> bool {
        gm := get_game_manager();
        if !#alive(gm) || (gm.phase != .SURVIVOR_HEAD_START && gm.phase != .ACTIVE) {
            return false;
        }
        if !#alive(entity) || round_dead || round_minion {
            return false;
        }
        if gm.is_entity_player(this) {
            return false;
        }

        was_survivor := this.is_round_survivor() || round_downed;
        remove_all_effects(entity);
        this.clear_round_downed_state(true);
        clear_player_tasks(this);
        this.clear_round_inventory();
        this.force_viewfinder_off();
        close_security_cameras_for_player(this);

        round_minion = true;
        round_dead = false;
        round_dead_ghost_state_active = false;
        round_minion_hatch_request_id += 1;
        round_minion_hatch_seen_request_id = 0;
        sprint_input_held = false;
        sprint_active = false;
        current_stamina = MINION_SPRINT_STAMINA_MAX;
        max_stamina = MINION_SPRINT_STAMINA_MAX;
        sprint_lockout_remaining = 0.0;
        entity_lurch_remaining = 0.0;
        entity_local_view_alpha = 0.0;
        entity_local_view_is_active = false;
        entity_scream_reveal_remaining = 0.0;
        entity_scream_arrow_remaining = 0.0;
        entity_scream_arrow_zone = .None;
        entity_scream_arrow_target_user_ids.clear();
        entity_target_ping_remaining = 0.0;
        entity_target_ping_user_id = "";
        entity_target_ping_requires_same_zone = false;
        entity_target_ping_source_zone = .None;

        if #alive(agent) {
            agent.velocity = v2{0.0, 0.0};
        }

        if was_survivor {
            gm.register_survivor_eliminated();
        }

        this.ensure_minion_override_rig();
        this.set_entity_override_active(true);
        return true;
    }

    mark_round_downed :: method() {
        if round_dead || round_downed {
            return;
        }

        round_downed = true;
        downed_scream_remaining = DOWNED_SCREAM_INTERVAL_SECONDS;
        downed_bleed_out_ends_at = get_time() + DOWNED_BLEED_OUT_SECONDS;
        sprint_input_held = false;
        sprint_active = false;

        if equipped_weapon_type != .NONE {
            weapon_unequip(this, equipped_weapon_type);
            equipped_weapon_type = .NONE;
            equipped_item_def = null;
            last_selected_index = -1;
        }

        if #alive(agent) {
            agent.velocity = v2{0.0, 0.0};
        }

        if animator != null && animator.instance != null {
            animator.state_machine.set_bool("ghost_form", false);
            animator.state_machine.set_bool("sprinting", false);
            animator.state_machine.set_bool("downed", true);
        }
    }

    start_downed_hit_reaction :: method() {
        if animator == null || animator.instance == null {
            return;
        }

        animator.state_machine.set_bool("ghost_form", false);
        animator.state_machine.set_bool("sprinting", false);
        animator.state_machine.set_bool("downed", true);
        animator.state_machine.set_bool("downed_hit_reacting", true);
        animator.state_machine.set_trigger("hit_downed");
    }

    end_downed_hit_reaction :: method() {
        if animator == null || animator.instance == null {
            return;
        }

        animator.state_machine.set_bool("downed_hit_reacting", false);
    }

    mark_round_dead :: method(count_as_survivor_elimination: bool = true) {
        if round_dead {
            return;
        }

        was_round_survivor := this.is_round_survivor();
        death_position := entity.world_position;
        clear_footstep_echoes_for_player(this);

        this.clear_round_downed_state();
        round_dead = true;
        round_dead_was_minion = round_minion;
        round_minion = false;
        round_dead_ghost_state_active = false;
        this.set_local_round_dead_voice_chat_muted(true);
        entity_local_view_alpha = 0.0;
        entity_local_view_is_active = false;
        entity_local_view_fade_out_seconds = ENTITY_VIEW_PLAYER_REVEAL_FADE_OUT_SECONDS;
        entity_scream_reveal_remaining = 0.0;
        entity_scream_arrow_remaining = 0.0;
        entity_scream_arrow_zone = .None;
        entity_scream_arrow_target_user_ids.clear();
        entity_target_ping_remaining = 0.0;
        entity_target_ping_user_id = "";
        entity_target_ping_requires_same_zone = false;
        entity_target_ping_source_zone = .None;
        ghost_item_ping_cooldown_ends_at = 0.0;
        sprint_input_held = false;
        sprint_active = false;

        if equipped_weapon_type != .NONE {
            weapon_unequip(this, equipped_weapon_type);
            equipped_weapon_type = .NONE;
            equipped_item_def = null;
            last_selected_index = -1;
        }

        if #alive(agent) {
            agent.velocity = v2{0.0, 0.0};
            agent.set_navmesh_to_lock_to(null);
        }

        if animator != null && animator.instance != null {
            animator.state_machine.set_bool("ghost_form", false);
            animator.state_machine.set_bool("sprinting", false);
        }

        gm := get_game_manager();
        if count_as_survivor_elimination && was_round_survivor && #alive(gm) && (gm.phase == .SURVIVOR_HEAD_START || gm.phase == .ACTIVE) {
            spawn_corpse_for_player(this);
            entity_player := find_round_entity_for_mold_vomit("");
            spawn_mold_vomit_at_position(death_position, entity_player);
        }
        if count_as_survivor_elimination && was_round_survivor && #alive(gm) {
            gm.register_survivor_eliminated();
        }
    }

    start_round_death_animation :: method() {
        if animator == null || animator.instance == null {
            return;
        }

        round_dead_ghost_state_active = false;
        this.clear_round_downed_state();
        animator.state_machine.set_bool("ghost_form", false);
        animator.state_machine.set_bool("sprinting", false);
        animator.state_machine.set_trigger("death");
    }

    tick_downed_scream_state :: method(dt: float) {
        if !this.is_round_downed() {
            downed_scream_remaining = 0.0;
            return;
        }

        downed_scream_remaining -= dt;
        if downed_scream_remaining > 0.0 {
            return;
        }

        if entity.get_active_effect() != null {
            return;
        }

        effect := new(Downed_Scream_Effect);
        entity.set_active_effect(effect);
        while downed_scream_remaining <= 0.0 {
            downed_scream_remaining += DOWNED_SCREAM_INTERVAL_SECONDS;
        }
    }

    get_downed_bleed_out_seconds_remaining :: method() -> s64 {
        if !this.is_round_downed() {
            return 0;
        }

        rem := downed_bleed_out_ends_at - get_time();
        if rem <= 0.0 {
            return 0;
        }

        secs := (rem + 0.999).(s64);
        one: s64 = 1;
        if secs < one {
            secs = one;
        }
        return secs;
    }

    tick_downed_bleed_out_state :: method() {
        if !this.is_round_downed() {
            downed_bleed_out_ends_at = 0.0;
            return;
        }

        if downed_bleed_out_ends_at <= 0.0 {
            downed_bleed_out_ends_at = get_time() + DOWNED_BLEED_OUT_SECONDS;
        }
        if get_time() < downed_bleed_out_ends_at {
            return;
        }

        if animator != null && animator.instance != null {
            this.start_round_death_animation();
        }
        this.mark_round_dead();
    }

    enter_round_dead_ghost_state :: method() {
        if !round_dead || round_dead_ghost_state_active {
            return;
        }

        round_dead_ghost_state_active = true;

        if animator == null || animator.instance == null {
            return;
        }

        animator.state_machine.set_bool("sprinting", false);
        animator.state_machine.set_bool("ghost_form", true);
        animator.state_machine.set_trigger("RESET");
    }

    handle_round_revive_request :: method() {
        if round_revive_seen_request_id == round_revive_request_id {
            return;
        }
        round_revive_seen_request_id = round_revive_request_id;

        this.set_local_round_dead_voice_chat_muted(false);
        if animator != null && animator.instance != null {
            animator.state_machine.set_bool("round_dead", false);
            animator.state_machine.set_bool("ghost_form", false);
            animator.state_machine.set_bool("downed", false);
            animator.state_machine.set_bool("downed_hit_reacting", false);
            animator.state_machine.set_bool("sprinting", false);
            animator.state_machine.set_trigger("RESET");
        }
        if #alive(agent) {
            agent.velocity = v2{0.0, 0.0};
            agent.movement_speed = base_movement_speed;
        }
        lock_player_to_game_navmesh(this);
    }

    tick_end_game_cutscene_dance_state :: method() {
        gm := get_game_manager();
        if !#alive(gm) || !gm.is_end_game_cutscene_active() {
            end_game_cutscene_dance_triggered = false;
            return;
        }

        if animator == null || animator.state_machine == null {
            return;
        }
        if end_game_cutscene_dance_triggered {
            return;
        }

        animator.state_machine.set_bool("end_game_cutscene", true);
        end_game_cutscene_dance_triggered = true;
    }

    ao_update :: method(dt: float) {
        this.handle_wide_view_cheat_keybind();
        this.sync_local_wide_view_shadows();
        this.sync_local_camera_size();
        this.update_local_voice_chat_range_cache();

        if equipped_weapon_type == .NONE {
            this.set_mouse_ik_enabled(false);
        } else if equipped_weapon_type == .CAMERA {
            this.sync_camera_item_mouse_ik();
        }

        active_effect := entity.get_active_effect();
        gm := get_game_manager();
        if (round_dead || round_downed) &&
            active_effect == null &&
            (!#alive(gm) || (gm.phase != .SURVIVOR_HEAD_START && gm.phase != .ACTIVE)) {
            this.clear_round_death_state();
        }
        this.handle_round_revive_request();

        this.tick_downed_bleed_out_state();

        should_use_entity_override := false;
        if this.is_round_entity() {
            should_use_entity_override = this.ensure_entity_override_rig();
        } else if this.is_round_minion() {
            should_use_entity_override = this.ensure_minion_override_rig();
        }
        this.set_entity_override_active(should_use_entity_override);

        if should_use_entity_override && equipped_weapon_type != .NONE {
            weapon_unequip(this, equipped_weapon_type);
            equipped_weapon_type = .NONE;
            equipped_item_def = null;
        }
        this.update_held_item_visual();

        is_moving := false;
        if #alive(agent) {
            vel := agent.velocity;
            speed_sq := vel.x * vel.x + vel.y * vel.y;
            if speed_sq > 0.0001 {
                is_moving = true;
            }
        }
        if should_use_entity_override && entity_override_state_machine != null {
            entity_override_state_machine.set_bool("is_moving", is_moving);
            entity_override_state_machine.set_bool("is_lurching", entity_lurch_remaining > 0.0);
        }
        if should_use_entity_override && minion_override_state_machine != null {
            minion_override_state_machine.set_bool("is_moving", is_moving);
            if round_minion_hatch_request_id > round_minion_hatch_seen_request_id {
                round_minion_hatch_seen_request_id = round_minion_hatch_request_id;
                minion_override_state_machine.set_trigger("hatch");
            }
        }

        if this.is_round_entity() || round_dead || round_downed {
            sprint_input_held = false;
        }

        if sprint_lockout_remaining > 0.0 {
            sprint_lockout_remaining -= dt;
            sprint_lockout_remaining = max(sprint_lockout_remaining, 0.0);
        }

        if entity_lurch_remaining > 0.0 {
            entity_lurch_remaining -= dt;
            entity_lurch_remaining = max(entity_lurch_remaining, 0.0);
        }
        if minion_bite_hit_react_remaining > 0.0 {
            minion_bite_hit_react_remaining -= dt;
            minion_bite_hit_react_remaining = max(minion_bite_hit_react_remaining, 0.0);
        }

        desired_stamina_max := SPRINT_STAMINA_MAX;
        stamina_drain_per_second := SPRINT_STAMINA_DRAIN_PER_SECOND;
        stamina_regen_per_second := SPRINT_STAMINA_REGEN_PER_SECOND;
        stamina_moving_regen_per_second := SPRINT_STAMINA_MOVING_REGEN_PER_SECOND;
        sprint_exhaust_lockout_seconds := SPRINT_EXHAUST_LOCKOUT_SECONDS;
        if this.is_round_minion() {
            desired_stamina_max = MINION_SPRINT_STAMINA_MAX;
            stamina_drain_per_second = MINION_SPRINT_STAMINA_DRAIN_PER_SECOND;
            stamina_regen_per_second = MINION_SPRINT_STAMINA_REGEN_PER_SECOND;
            stamina_moving_regen_per_second = MINION_SPRINT_STAMINA_MOVING_REGEN_PER_SECOND;
            sprint_exhaust_lockout_seconds = MINION_SPRINT_EXHAUST_LOCKOUT_SECONDS;
        }
        if max_stamina != desired_stamina_max {
            stamina_pct := 1.0;
            if max_stamina > 0.0 {
                stamina_pct = clamp(current_stamina / max_stamina, 0.0, 1.0);
            }
            max_stamina = desired_stamina_max;
            current_stamina = max_stamina * stamina_pct;
        }

        wants_sprint := !round_dead && !round_downed && sprint_input_held && sprint_lockout_remaining <= 0.0 && current_stamina > 0.0;
        sprint_active = wants_sprint && is_moving;

        if sprint_active {
            current_stamina -= stamina_drain_per_second * dt;
            if current_stamina <= 0.0 {
                current_stamina = 0.0;
                sprint_active = false;
                sprint_lockout_remaining = sprint_exhaust_lockout_seconds;
            }
        } else if current_stamina < max_stamina {
            regen_per_second := stamina_regen_per_second;
            if is_moving && !sprint_input_held {
                regen_per_second = stamina_moving_regen_per_second;
            }
            current_stamina += regen_per_second * dt;
            current_stamina = min(current_stamina, max_stamina);
        }

        if #alive(agent) {
            if agent.input_this_frame.x > 0.05 {
                entity_cached_facing_right = true;
            } else if agent.input_this_frame.x < -0.05 {
                entity_cached_facing_right = false;
            } else if agent.velocity.x > 0.05 {
                entity_cached_facing_right = true;
            } else if agent.velocity.x < -0.05 {
                entity_cached_facing_right = false;
            }

            movement_speed_multiplier := 1.0;
            if round_downed {
                movement_speed_multiplier = DOWNED_SURVIVOR_MOVEMENT_MULTIPLIER;
            } else if round_dead {
                movement_speed_multiplier = SPRINT_MOVEMENT_MULTIPLIER;
            } else if sprint_active {
                if this.is_round_minion() {
                    movement_speed_multiplier = MINION_SPRINT_MOVEMENT_MULTIPLIER;
                } else {
                    movement_speed_multiplier = SPRINT_MOVEMENT_MULTIPLIER;
                }
            } else if this.is_round_entity() && entity_lurch_remaining > 0.0 {
                movement_speed_multiplier = ENTITY_LURCH_MOVEMENT_MULTIPLIER;
            } else if this.is_round_entity() {
                movement_speed_multiplier = ROUND_ENTITY_NORMAL_MOVEMENT_MULTIPLIER;
            } else if this.is_round_minion() {
                movement_speed_multiplier = ROUND_MINION_NORMAL_MOVEMENT_MULTIPLIER;
            } else if this.is_round_survivor() {
                movement_speed_multiplier = ROUND_SURVIVOR_NORMAL_MOVEMENT_MULTIPLIER;
            }
            if this.is_round_minion() && is_entity_flashbanged(this) {
                movement_speed_multiplier *= MINION_FLASHBANG_MOVEMENT_MULTIPLIER;
                agent.velocity = v2{0.0, 0.0};
            } else if this.is_round_entity() && is_entity_flashbanged(this) {
                movement_speed_multiplier *= ENTITY_FLASHBANG_MOVEMENT_MULTIPLIER;
            }
            if has_effect(entity, Stim_Speed_Effect) {
                movement_speed_multiplier *= STIM_SPEED_BUFF_MULTIPLIER;
            }
            if has_effect(entity, Minion_Bite_Slow_Effect) {
                movement_speed_multiplier *= MINION_BITE_SLOW_MOVEMENT_MULTIPLIER;
            }

            current_speed := agent.movement_speed;
            if movement_speed_multiplier > 0.001 && (!sprint_has_applied_speed || abs(current_speed - sprint_last_applied_speed) > 0.001) {
                base_movement_speed = current_speed / movement_speed_multiplier;
            }

            target_speed := base_movement_speed * movement_speed_multiplier;
            agent.movement_speed = target_speed;
            sprint_last_applied_speed = target_speed;
            sprint_has_applied_speed = true;
        }

        this.tick_downed_scream_state(dt);
        process_entity_jumpscare_sabotage_request(this);
        this.update_jumpscare_overlay(dt);

        if animator != null && animator.instance != null {
            animator.state_machine.set_bool("downed", round_downed);
            animator.state_machine.set_bool("round_dead", round_dead);
            animator.state_machine.set_bool("sprinting", sprint_active);
            minion_slowed := has_effect(entity, Minion_Bite_Slow_Effect);
            minion_bite_hit_reacting := minion_bite_hit_react_remaining > 0.0;
            animator.state_machine.set_bool("minion_slowed", minion_slowed);
            animator.state_machine.set_bool("minion_bite_hit_reacting", minion_bite_hit_reacting);
            animator.instance.speed_multiplier = 1.0;
            if round_dead_ghost_state_active {
                animator.state_machine.set_bool("ghost_form", true);
            }
        }
        this.tick_end_game_cutscene_dance_state();
        if #alive(override_rig) && override_rig.instance != null {
            override_rig.instance.speed_multiplier = 1.0;
            if this.is_round_entity() && entity_lurch_remaining > 0.0 && is_moving {
                override_rig.instance.speed_multiplier = ENTITY_LURCH_ANIMATION_SPEED_MULTIPLIER;
            } else if this.is_round_minion() && sprint_active && is_moving {
                override_rig.instance.speed_multiplier = MINION_SPRINT_ANIMATION_SPEED_MULTIPLIER;
            }
        }

        if round_dead && active_effect == null {
            this.enter_round_dead_ghost_state();
        }

        if this.is_local_or_server() && this.is_local() {
            this.update_chat_mode();
            this.update_local_vision_light();
        }
        this.tick_entity_local_view_reveal_state(dt);
        this.tick_entity_scream_reveal_state(dt);
        this.tick_entity_scream_arrow_state(dt);
        this.tick_entity_target_ping_arrow_state(dt);
        this.update_entity_local_player_visibility(dt);
        this.sync_entity_local_silhouette_material();
        this.update_entity_local_nameplate_visibility();
        this.update_dropped_item_visibility_for_local_entity(dt);
        tick_footstep_echo_for_player(this, dt);
    }

    ao_late_update :: method(dt: float) {
        if this.is_local() && (this.is_round_entity() || this.is_round_minion() || security_cameras_open) {
            this.apply_entity_local_post_processing();
        }
        if this.is_local() && this.is_lights_out_local_effect_active() {
            this.apply_lights_out_local_post_processing();
        }
        if this.is_local() && viewfinder_active && equipped_weapon_type == .CAMERA {
            this.apply_viewfinder_post_processing();
        }

        if is_local_or_server() {
            task_info_was_open := task_help_open;
            if task_info_was_open {
                draw_task_list_ui(this);
                this.draw_warp_to_backrooms_static_ui();
                this.draw_viewfinder_screen_overlay();
                return;
            }

            draw_match_lobby_ui(this);
            draw_role_selection_ui(this);
            draw_survivor_intro_static_ui(this);
            this.draw_warp_to_backrooms_static_ui();
            draw_intro_spawn_transition_ui(this);
            draw_game_start_vignette_ui(this);
            draw_head_start_ui(this);
            draw_hunt_begin_banner_ui(this);
            draw_exit_unlocked_banner_ui(this);
            draw_match_timer_ui(this);
            draw_match_end_ui(this);
            draw_task_list_ui(this);
            update_tasks(this);
            if task_info_was_open || task_help_open {
                this.draw_viewfinder_screen_overlay();
                return;
            }
            draw_vitals_hud(this, dt);
            draw_entity_sabotage_modal_ui(this);
            draw_entity_jumpscare_target_modal_ui(this);
            draw_radio_hint_arrows(this);
            draw_radio_tuning_ui(this, dt);
            draw_generator_restart_ui(this, dt);
            draw_wire_puzzle_ui(this, dt);
            draw_keypad_ui(this);
            this.draw_round_dead_player_pointers();
            this.draw_revealed_survivor_eye_icons();
            this.draw_downed_bleed_out_ui();
            for lb: component_iterator(Leaderboard) {
                lb.draw();
            }
            gm := get_game_manager();
            if #alive(gm) && gm.phase == .LOBBY {
                if entity_opt_in {
                    draw_ability_button(this, Lobby_Withdraw_Entity_Ability, 0);
                } else {
                    draw_ability_button(this, Lobby_Volunteer_Entity_Ability, 0);
                }
            }
        }

        if is_local_or_server() {
            active_effect := entity.get_active_effect();
            if this.is_round_entity() {
                if active_effect == null {
                    draw_entity_ability_button(this, Entity_Bite_Ability, 0, "AbilityIcons/Bite.png");
                    draw_entity_ability_button(this, Entity_Scream_Ability, 1, "AbilityIcons/Scream.png");
                    draw_entity_ability_button(this, Entity_Vomit_Ability, 2, ENTITY_VOMIT_ICON_PATH);
                    draw_entity_ability_button(this, Entity_Lurch_Ability, 3, "AbilityIcons/SprintIcon.png");
                    draw_entity_ability_button(this, Entity_Wall_Seep_Ability, 4, "AbilityIcons/Scream.png");
                    if is_entity_ability_type_unlocked(this, Entity_Convert_Minion_Ability) && find_downed_minion_conversion_target(this) != null {
                        draw_ability_button(this, Entity_Convert_Minion_Ability, 5);
                    } else {
                        draw_ability_button(this, Entity_Sabotage_Ability, 5);
                    }
                }
                if equipped_weapon_type != .NONE {
                    weapon_unequip(this, equipped_weapon_type);
                    equipped_weapon_type = .NONE;
                    equipped_item_def = null;
                    last_selected_index = -1;
                }
            } else if this.is_round_minion() {
                if active_effect == null {
                    draw_ability_button(this, Minion_Bite_Ability, 0);
                    draw_ability_button(this, Minion_Sprint_Ability, 1);
                }
                if equipped_weapon_type != .NONE {
                    weapon_unequip(this, equipped_weapon_type);
                    equipped_weapon_type = .NONE;
                    equipped_item_def = null;
                    last_selected_index = -1;
                }
            } else if !round_dead && round_downed {
                draw_ability_button(this, Survivor_Danger_Ping_Ability, 4);
            } else if !round_dead && active_effect == null {
                draw_ability_button(this, Sprint_Ability, 2);
                if this.is_round_survivor() {
                    draw_ability_button(this, Survivor_Info_Ping_Ability, 3);
                    draw_ability_button(this, Survivor_Danger_Ping_Ability, 4);
                }
                // Draw fire ability button based on equipped weapon
                if equipped_weapon_type != .NONE {
                    config := get_weapon_config(equipped_weapon_type);
                    switch config.fire_mode {
                        case .CONTINUOUS:  { draw_ability_button(this, Continuous_Fire_Ability, 0); }
                        case .SINGLE_SHOT: { draw_ability_button(this, Single_Shot_Ability, 0); }
                        case .SPREAD:      { draw_ability_button(this, Spread_Shot_Ability, 0); }
                        case .LOBBED:      { draw_ability_button(this, Lobbed_Shot_Ability, 0); }
                        case .BEAM:        { draw_ability_button(this, Beam_Ability, 0); }
                        case .NONE: {
                            if equipped_weapon_type == .CAMERA {
                                draw_ability_button(this, Viewfinder_Ability, 0);
                            }
                        }
                        case .SPECIAL: {
                            if equipped_weapon_type == .STIM {
                                draw_ability_button(this, Stim_Boost_Ability, 0);
                            } else {
                                draw_ability_button(this, Special_Ability, 0);
                            }
                        }
                    }
                } else if is_barricade_item_def(equipped_item_def) {
                    draw_ability_button(this, Place_Barricade_Ability, 0);
                }

                // Draw hotbar and handle equip/unequip
                options := Inventory_Draw_Options.default();
                hotbar := Items.draw_hotbar(this, default_inventory, options);
                handle_equipped_item_changing(hotbar.selected_item_index);
            }
        }

        if should_draw_stamina_bar_for_player(this) && (current_stamina < max_stamina || sprint_active || sprint_lockout_remaining > 0.0) {
            draw_stamina_bar(this);
        }

        this.draw_entity_status_debuff_icons();
        this.draw_jumpscare_overlay();

        if this.is_local() && (this.is_round_entity() || this.is_round_minion()) && is_entity_flashbanged(this) {
            this.draw_entity_flashbang_blackout_overlay();
        }

        this.draw_viewfinder_screen_overlay();
    }

    ao_end :: method() {
        clear_footstep_echoes_for_player(this);

        gm := get_game_manager();
        if #alive(gm) {
            gm.handle_round_player_left(this);
        }

        this.remove_name_invisibility_reason(ENTITY_NAME_INVISIBILITY_REASON);
        entity_name_hidden = false;

        if silhouette_material_applied && animator != null {
            animator.set_material(null, false);
        }
        if silhouette_material != null {
            silhouette_material.destroy();
            silhouette_material = null;
        }
        silhouette_material_applied = false;

        this.destroy_held_item_visual();
        this.destroy_jumpscare_overlay();
        destroy_vitals_ui_entries(this);
        close_security_cameras_for_player(this);

        // Local-only: destroy LOS light entity.
        if this.is_local_or_server() {
            if local_light_entity != null && #alive(local_light_entity) {
                local_light_entity.destroy();
            }
            local_light_entity = null;
            local_light = null;
            local_light_caster = null;
        }

        if #alive(agent) {
            agent.movement_speed = base_movement_speed;
        }
        if animator != null && animator.instance != null {
            animator.instance.speed_multiplier = 1.0;
        }
        if #alive(override_rig) && override_rig.instance != null {
            override_rig.instance.speed_multiplier = 1.0;
        }
    }

    ao_can_use_ability :: method(ability: Ability_Base) -> bool {
        // Called to determine if the player is allowed to use the given ability
        if round_dead || round_downed {
            if round_downed && ability.#type == Survivor_Danger_Ping_Ability {
                return true;
            }
            return false;
        }
        if (this.is_round_entity() || this.is_round_minion()) && is_entity_flashbanged(this) {
            return false;
        }
        if (this.is_round_entity() || this.is_round_minion()) && ability.#type == Sprint_Ability {
            return false;
        }
        if this.is_round_entity() && !is_entity_ability_unlocked(ability) {
            return false;
        }
        if this.is_round_minion() && ability.#type != Minion_Bite_Ability && ability.#type != Minion_Sprint_Ability {
            return false;
        }
        return true;
    }

    ao_can_use_interactable :: method(interactable: Interactable) -> bool {
        // Called to determine if the player is allowed to use the given interactable
        if round_dead || round_downed {
            if round_dead {
                listener := interactable.listener;
                if #alive(listener) && listener.#type == Ghost_Item_Ping_Interactable {
                    return true;
                }
            }
            return false;
        }

        if this.is_round_entity() || this.is_round_minion() {
            listener := interactable.listener;
            if #alive(listener) && listener.#type == Dropped_Item {
                return false;
            }
        }

        listener := interactable.listener;
        if #alive(listener) && listener.#type == Dropped_Item {
            dropped_item := listener.(Dropped_Item);
            if is_blocked_broken_camera_pickup(this, dropped_item) {
                return false;
            }
            if is_blocked_vhs_tape_pickup(this, dropped_item) {
                return false;
            }
        }

        return true;
    }

    ao_on_interactable_used :: method(interactable: Interactable) {
        // Called when the player uses the given interactable
    }

    ao_on_holding_interactable :: method(interactable: Interactable) {
        // Called once per frame while the player is holding on the interactable
    }

    ao_on_state_sync :: method() {
        // Called on the client after applying a state sync from the server
        // Use this to override things for the local player only like name colors or lighting for example
        this.sync_entity_local_silhouette_material();
    }

    get_local_light_radii :: proc(using this: Player) -> v2 {
        if this.is_lights_out_local_effect_active() {
            return v2.{LIGHTS_OUT_LOS_INNER_RADIUS, LIGHTS_OUT_LOS_OUTER_RADIUS};
        }

        // When integrating global darkness / phases, drive night_blend from Game_Manager (or similar).
        night_blend := 0.0;

        base_inner := PLAYER_LIGHT_BASE_INNER_RADIUS.(float);
        min_inner := PLAYER_LIGHT_MIN_INNER_RADIUS.(float);
        min_outer := PLAYER_LIGHT_MIN_OUTER_RADIUS.(float);

        inner_radius := lerp(base_inner, min_inner, night_blend);
        inner_radius = max(inner_radius, min_inner);

        outer_radius := inner_radius + PLAYER_LIGHT_RADIUS_Y_PADDING;
        outer_radius = max(outer_radius, min_outer);

        return v2.{inner_radius, outer_radius};
    }

    is_lights_out_local_effect_active :: proc(using this: Player) -> bool {
        gm := get_game_manager();
        if !#alive(gm) {
            return false;
        }
        return gm.lights_out_active && this.is_round_survivor();
    }

    apply_lights_out_local_post_processing :: proc(using this: Player) {
        vignette: Post_Processing.Vignette_Config;
        vignette.radius = LIGHTS_OUT_VIGNETTE_RADIUS;
        vignette.softness = LIGHTS_OUT_VIGNETTE_SOFTNESS;
        Post_Processing.vignette(vignette);
    }

    apply_entity_local_post_processing :: proc(using this: Player) {
        contrast := ENTITY_COLOR_GRADE_CONTRAST;
        if (this.is_round_entity() || this.is_round_minion()) && current_zone == .Zone2 {
            contrast = ENTITY_COLOR_GRADE_CONTRASTZ2;
        }

        color_grade := Post_Processing.Color_Grade_Config{
            color_filter = ENTITY_COLOR_GRADE_FILTER,
            saturation = ENTITY_COLOR_GRADE_SATURATION,
            contrast = contrast
        };
        Post_Processing.color_grade(color_grade);

        film_grain := Post_Processing.Film_Grain_Config{
            strength = ENTITY_FILM_GRAIN_STRENGTH,
            noise_scale = ENTITY_FILM_GRAIN_NOISE_SCALE
        };
        Post_Processing.film_grain(film_grain);

        if has_effect(entity, Entity_Flashbang_Effect) {
            this.apply_entity_flashbang_local_post_processing(get_entity_flashbang_alpha(this), contrast);
        }
    }

    apply_entity_flashbang_local_post_processing :: proc(using this: Player, alpha: float, base_contrast: float) {
        alpha = clamp(alpha, 0.0, 1.0);
        flashbang_grade := Post_Processing.Color_Grade_Config{
            color_filter = v3{
                lerp(ENTITY_COLOR_GRADE_FILTER.x, 0.0, alpha),
                lerp(ENTITY_COLOR_GRADE_FILTER.y, 0.0, alpha),
                lerp(ENTITY_COLOR_GRADE_FILTER.z, 0.0, alpha)
            },
            saturation = lerp(ENTITY_COLOR_GRADE_SATURATION, -1.0, alpha),
            contrast = lerp(base_contrast, 0.0, alpha)
        };
        Post_Processing.color_grade(flashbang_grade);

        flashbang_grain := Post_Processing.Film_Grain_Config{
            strength = lerp(ENTITY_FILM_GRAIN_STRENGTH, 0.0, alpha),
            noise_scale = lerp(ENTITY_FILM_GRAIN_NOISE_SCALE, 1.0, alpha)
        };
        Post_Processing.film_grain(flashbang_grain);
    }

    apply_viewfinder_post_processing :: proc(using this: Player) {
        color_grade := Post_Processing.Color_Grade_Config{
            color_filter = VIEWFINDER_COLOR_FILTER,
            saturation = VIEWFINDER_SATURATION,
            contrast = VIEWFINDER_CONTRAST
        };
        Post_Processing.color_grade(color_grade);

        chromatic := Post_Processing.Chromatic_Aberration_Config{
            channel_offsets = VIEWFINDER_CHROMATIC_OFFSET,
            focal_point = v2{0.5, 0.5}
        };
        Post_Processing.chromatic_aberration(chromatic);

        film_grain := Post_Processing.Film_Grain_Config{
            strength = VIEWFINDER_FILM_GRAIN_STRENGTH,
            noise_scale = VIEWFINDER_FILM_GRAIN_NOISE_SCALE
        };
        Post_Processing.film_grain(film_grain);
    }

    draw_viewfinder_screen_overlay :: proc(using this: Player) {
        if !this.is_local() || !viewfinder_active || equipped_weapon_type != .CAMERA {
            return;
        }

        overlay := get_asset(Texture_Asset, VIEWFINDER_OVERLAY_TEXTURE_PATH);
        if overlay == null {
            return;
        }

        UI.push_screen_draw_context();
        defer UI.pop_draw_context();

        UI.push_layer(VIEWFINDER_OVERLAY_LAYER);
        defer UI.pop_layer();

        screen := UI.get_screen_rect().center_rect();
        screen = screen.grow(378, 672, 378, 672);
        UI.quad(screen, overlay, v4{1.0, 1.0, 1.0, 1.0});

        battery := get_asset(Texture_Asset, VIEWFINDER_OVERLAY_BATTERY_TEXTURE_PATH);
        if battery == null {
            return;
        }
        batteryRect := screen.bottom_center_rect().offset(265, 78).grow(30);
        UI.quad(batteryRect, battery, v4{1.0, 1.0, 1.0, 1.0});
        // Second battery bar (should flash)
        batteryRect = batteryRect.offset(65, 0);
        blink_phase := get_time() % (VIEWFINDER_BATTERY_BLINK_SECONDS * 2.0);
        if blink_phase < VIEWFINDER_BATTERY_BLINK_SECONDS {
            UI.quad(batteryRect, battery, v4{1.0, 1.0, 1.0, 1.0});
        }
    }

    draw_entity_flashbang_blackout_overlay :: proc(using this: Player) {
        alpha := get_entity_flashbang_alpha(this);
        if alpha <= 0.0 {
            return;
        }

        UI.push_screen_draw_context();
        defer UI.pop_draw_context();

        UI.push_layer(2000);
        defer UI.pop_layer();

        full_screen := UI.get_screen_rect();
        UI.quad(full_screen, core_globals.white_sprite, v4{
            ENTITY_FLASHBANG_BLACKOUT_COLOR.x,
            ENTITY_FLASHBANG_BLACKOUT_COLOR.y,
            ENTITY_FLASHBANG_BLACKOUT_COLOR.z,
            alpha
        });
    }

    draw_entity_status_debuff_icons :: proc(using this: Player) {
        if !this.is_local_or_server() || !this.is_round_entity() {
            return;
        }

        icon_paths: [6]string;
        icon_alphas: [6]float;
        icon_count: s64 = 0;

        flashbang_alpha := get_entity_flashbang_alpha(this);
        if flashbang_alpha > 0.0 {
            icon_paths[icon_count] = ENTITY_FLASHBANG_DEBUFF_ICON_PATH;
            icon_alphas[icon_count] = flashbang_alpha;
            icon_count += 1;
        }

        if is_entity_sound_sight_interfered() {
            icon_paths[icon_count] = ENTITY_NOISEMAKER_DEBUFF_ICON_PATH;
            icon_alphas[icon_count] = 1.0;
            icon_count += 1;
        }

        if icon_count <= 0 {
            return;
        }

        debuff_rect := UIK.rect_topbar().offset(0.0, -(MATCH_TIMER_TOP_DOWN_OFFSET + ENTITY_DEBUFF_ICON_TIMER_GAP));
        UIK.begin(UIK.window(debuff_rect));

        shell := UIK.layout_centered(UIK.flex(1), UIK.flex(1));
        shell.show_background = false;
        UIK.panel_begin(shell);

        row := UIK.layout_row(UIK.fit(), UIK.pixels(ENTITY_DEBUFF_ICON_SIZE), ENTITY_DEBUFF_ICON_SPACING - ENTITY_DEBUFF_ICON_SIZE);
        row.main_align = .CENTER;
        row.cross_align = .CENTER;
        row.show_background = false;
        UIK.panel_begin(row);

        i: s64 = 0;
        while i < icon_count {
            icon := get_asset(Texture_Asset, icon_paths[i]);
            if icon != null {
                icon_slot := UIK.layout_centered(UIK.pixels(ENTITY_DEBUFF_ICON_SIZE), UIK.pixels(ENTITY_DEBUFF_ICON_SIZE));
                icon_slot.show_background = false;
                UIK.panel_begin(icon_slot);
                UIK.image_fitted(icon, UIK.image_desc(.CONTAIN), v4{1.0, 1.0, 1.0, icon_alphas[i]});
                UIK.panel_end();
            }
            i += 1;
        }

        UIK.panel_end();
        UIK.panel_end();
        UIK.end();
    }

    draw_revealed_survivor_eye_icons :: proc(using this: Player) {
        if !this.is_local() || !this.is_round_survivor() {
            return;
        }
        if this.should_hide_revealed_eye_for_local_ui() {
            return;
        }

        icon := get_asset(Texture_Asset, ENTITY_REVEALED_EYE_ICON_PATH);
        if icon == null {
            return;
        }

        UI.push_screen_draw_context();
        defer UI.pop_draw_context();

        UI.push_layer(ENTITY_REVEALED_EYE_ICON_LAYER);
        defer UI.pop_layer();

        this.draw_revealed_survivor_eye_icon_for_player(this, icon);
    }

    should_hide_revealed_eye_for_local_ui :: proc(using this: Player) -> bool {
        if sabotage_modal_open || jumpscare_target_modal_open || task_help_open || security_cameras_open {
            return true;
        }
        if entity != null {
            active_effect := entity.get_active_effect();
            if active_effect != null && active_effect.#type != Jumpscared_Effect {
                return true;
            }
        }
        return false;
    }

    should_hide_arrow_overlays_for_modal_ui :: proc(using this: Player) -> bool {
        if task_help_open || sabotage_modal_open || jumpscare_target_modal_open || security_cameras_open {
            return true;
        }
        if get_radio_tuning_effect(this) != null {
            return true;
        }
        if get_generator_restart_effect(this) != null {
            return true;
        }
        if get_wire_puzzle_effect(this) != null {
            return true;
        }
        if get_keypad_entry_effect(this) != null {
            return true;
        }
        return false;
    }

    draw_revealed_survivor_eye_icon_for_player :: proc(using this: Player, survivor: Player, icon: Texture_Asset) {
        if survivor == null || !#alive(survivor.entity) return;
        if !is_entity_reveal_active(survivor) return;
        if survivor.is_round_dead() return;

        nameplate_rect := survivor.full_nameplate_rect;
        screen_pos := nameplate_rect.top_center_rect().center();
        

        screen_pos = world_to_screen(survivor.entity.world_position + v2{0.0, 2.0});

        alpha := clamp(survivor.entity_local_view_alpha, 0.0, 1.0);
        if is_revealed_by_jumpscare_effect(survivor) {
            alpha = 1.0;
        }
        pulse := 1.0 + sin(get_time() * 8.0 + survivor.entity.world_position.x) * 0.045;
        half_size := ENTITY_REVEALED_EYE_ICON_HALF_SIZE * pulse;
        rect := Rect{screen_pos, screen_pos}.grow(half_size);
        glow_rect := rect.grow(7.0);

        UI.quad(glow_rect.fit_aspect(icon.get_aspect(), .KEEP_BIGGER), icon, v4{0.25, 0.78, 1.0, alpha * 0.22});
        UI.quad(rect.fit_aspect(icon.get_aspect(), .KEEP_BIGGER), icon, v4{1.0, 1.0, 1.0, alpha});
    }

    set_animator_alpha :: proc(using this: Player, alpha: float) {
        if animator == null return;

        tint := animator.color_multiplier;
        tint.w = alpha;
        animator.color_multiplier = tint;

        if held_item_sprite != null {
            held_tint := held_item_sprite.color;
            held_tint.w = alpha;
            held_item_sprite.color = held_tint;
        }
    }

    reveal_for_entity_local_view :: proc(using this: Player) {
        this.reveal_for_entity_local_view_with_duration(ENTITY_VIEW_PLAYER_REVEAL_FADE_OUT_SECONDS);
    }

    reveal_for_entity_local_view_with_duration :: proc(using this: Player, fade_out_seconds: float) {
        if this.is_round_entity() return;
        if is_entity_sound_sight_interfered() return;

        if fade_out_seconds <= 0.0 {
            fade_out_seconds = ENTITY_VIEW_PLAYER_REVEAL_FADE_OUT_SECONDS;
        }

        current_remaining := 0.0;
        if entity_local_view_is_active {
            current_remaining = entity_local_view_alpha * entity_local_view_fade_out_seconds;
        }

        entity_local_view_alpha = 1.0;
        entity_local_view_is_active = true;
        entity_local_view_fade_out_seconds = max(current_remaining, fade_out_seconds);
    }

    reveal_for_entity_scream_local_view :: proc(using this: Player, fade_out_seconds: float) {
        if is_entity_sound_sight_interfered() {
            clear_entity_local_view_reveal(this);
            return;
        }
        if fade_out_seconds <= 0.0 {
            fade_out_seconds = ENTITY_VIEW_PLAYER_REVEAL_FADE_OUT_SECONDS;
        }

        this.reveal_for_entity_local_view_with_duration(fade_out_seconds);
        entity_scream_reveal_remaining = max(entity_scream_reveal_remaining, fade_out_seconds);
    }

    reveal_for_entity_jumpscare_local_view :: proc(using this: Player, fade_out_seconds: float) {
        if this.is_round_entity() return;
        if fade_out_seconds <= 0.0 {
            fade_out_seconds = ENTITY_VIEW_PLAYER_REVEAL_FADE_OUT_SECONDS;
        }

        current_remaining := 0.0;
        if entity_local_view_is_active {
            current_remaining = entity_local_view_alpha * entity_local_view_fade_out_seconds;
        }

        entity_local_view_alpha = 1.0;
        entity_local_view_is_active = true;
        entity_local_view_fade_out_seconds = max(current_remaining, fade_out_seconds);
        entity_scream_reveal_remaining = max(entity_scream_reveal_remaining, fade_out_seconds);
    }

    show_entity_scream_arrows :: proc(using this: Player, duration_seconds: float) {
        if duration_seconds <= 0.0 {
            return;
        }

        entity_scream_arrow_remaining = max(entity_scream_arrow_remaining, duration_seconds);
        entity_scream_arrow_zone = current_zone;
        entity_scream_arrow_target_user_ids.clear();
    }

    add_entity_scream_arrow_target :: proc(using this: Player, target: Player) {
        if target == null {
            return;
        }

        target_user_id := target.get_user_id();
        if target_user_id.count <= 0 {
            return;
        }

        for user_id: entity_scream_arrow_target_user_ids {
            if user_id == target_user_id {
                return;
            }
        }

        entity_scream_arrow_target_user_ids.append(target_user_id);
    }

    show_entity_target_ping_arrow :: proc(using this: Player, target: Player, duration_seconds: float, require_same_zone: bool = false) {
        if target == null || duration_seconds <= 0.0 {
            return;
        }

        entity_target_ping_user_id = target.get_user_id();
        entity_target_ping_remaining = max(entity_target_ping_remaining, duration_seconds);
        entity_target_ping_requires_same_zone = require_same_zone;
        if require_same_zone {
            entity_target_ping_source_zone = current_zone;
        } else {
            entity_target_ping_source_zone = .None;
        }
    }

    tick_entity_local_view_reveal_state :: proc(using this: Player, dt: float) {
        if this.is_round_entity() return;
        if is_entity_sound_sight_interfered() {
            clear_entity_local_view_reveal(this);
            return;
        }
        if !entity_local_view_is_active return;

        fade_out_seconds := entity_local_view_fade_out_seconds;
        if fade_out_seconds <= 0.0 {
            fade_out_seconds = ENTITY_VIEW_PLAYER_REVEAL_FADE_OUT_SECONDS;
        }

        entity_local_view_alpha -= dt / fade_out_seconds;
        entity_local_view_alpha = clamp(entity_local_view_alpha, 0.0, 1.0);
        if entity_local_view_alpha <= 0.0 {
            entity_local_view_alpha = 0.0;
            entity_local_view_is_active = false;
            entity_local_view_fade_out_seconds = ENTITY_VIEW_PLAYER_REVEAL_FADE_OUT_SECONDS;
        }
    }

    tick_entity_scream_reveal_state :: proc(using this: Player, dt: float) {
        if this.is_round_entity() return;
        if entity_scream_reveal_remaining <= 0.0 return;

        entity_scream_reveal_remaining -= dt;
        entity_scream_reveal_remaining = max(entity_scream_reveal_remaining, 0.0);
    }

    tick_entity_scream_arrow_state :: proc(using this: Player, dt: float) {
        if !this.is_round_entity() return;
        if entity_scream_arrow_remaining <= 0.0 return;

        entity_scream_arrow_remaining -= dt;
        entity_scream_arrow_remaining = max(entity_scream_arrow_remaining, 0.0);
        if entity_scream_arrow_remaining <= 0.0 {
            entity_scream_arrow_zone = .None;
            entity_scream_arrow_target_user_ids.clear();
        }
    }

    tick_entity_target_ping_arrow_state :: proc(using this: Player, dt: float) {
        if !this.is_round_entity() {
            entity_target_ping_remaining = 0.0;
            entity_target_ping_user_id = "";
            entity_target_ping_requires_same_zone = false;
            entity_target_ping_source_zone = .None;
            return;
        }
        if entity_target_ping_remaining <= 0.0 return;

        entity_target_ping_remaining -= dt;
        entity_target_ping_remaining = max(entity_target_ping_remaining, 0.0);
        if entity_target_ping_remaining <= 0.0 {
            entity_target_ping_user_id = "";
            entity_target_ping_requires_same_zone = false;
            entity_target_ping_source_zone = .None;
        }
    }

    is_facing_right_for_vomit :: method() -> bool {
        return entity_cached_facing_right;
    }

    update_entity_local_player_visibility :: proc(using this: Player, dt: float) {
        if animator == null return;

        if this.is_round_entity() {
            return;
        }

        local_player := get_local_player();
        if this.is_round_dead() {
            if #alive(local_player) && local_player.is_round_dead() {
                this.set_animator_alpha(ROUND_DEAD_LOCAL_PLAYER_ALPHA);
            } else {
                this.set_animator_alpha(0.0);
            }
            return;
        }

        if !is_hidden_by_entity_local_view(this) {
            this.set_animator_alpha(1.0);
            return;
        }
        if is_revealed_by_jumpscare_effect(this) {
            this.set_animator_alpha(1.0);
            return;
        }

        this.set_animator_alpha(entity_local_view_alpha);
    }

    sync_entity_local_silhouette_material :: proc(using this: Player) {
        if animator == null return;

        should_apply := is_hidden_by_entity_local_view(this) && !is_revealed_in_entity_local_view(this);
        if should_apply {
            if silhouette_material == null {
                silhouette_material = create_player_spine_silhouette_material();
            }
            if silhouette_material == null return;

            if !silhouette_material_applied {
                animator.set_material(silhouette_material, false);
                silhouette_material_applied = true;
            }
            return;
        }

        if silhouette_material_applied {
            animator.set_material(null, false);
            silhouette_material_applied = false;
        }
    }

    sync_entity_name_visibility :: proc(using this: Player) {
        should_hide_name := this.is_round_entity() || this.is_round_minion() || is_hidden_by_round_dead_local_view(this) || (is_hidden_by_entity_local_view(this) && !is_revealed_in_entity_local_view(this));
        if should_hide_name == entity_name_hidden {
            return;
        }

        entity_name_hidden = should_hide_name;
        if should_hide_name {
            this.add_name_invisibility_reason(ENTITY_NAME_INVISIBILITY_REASON);
            return;
        }

        this.remove_name_invisibility_reason(ENTITY_NAME_INVISIBILITY_REASON);
    }

    update_entity_local_nameplate_visibility :: proc(using this: Player) {
        this.sync_entity_name_visibility();

        if this.is_round_entity() || this.is_round_minion() {
            do_name_color_override = false;
            return;
        }

        if is_hidden_by_round_dead_local_view(this) || (is_hidden_by_entity_local_view(this) && !is_revealed_in_entity_local_view(this)) {
            do_name_color_override = true;
            name_color_override = v4.{1.0, 1.0, 1.0, 0.0};
            return;
        }

        do_name_color_override = false;
    }

    update_dropped_item_visibility_for_local_entity :: method(dt: float) {
        if !this.is_local() {
            return;
        }

        hide_for_entity := this.is_round_entity();
        dropped_item_visibility_refresh_elapsed += dt;
        if !hide_for_entity &&
            dropped_item_visibility_initialized &&
            dropped_item_visibility_hidden_for_entity == hide_for_entity &&
            dropped_item_visibility_refresh_elapsed < 0.25 {
            return;
        }

        dropped_item_visibility_initialized = true;
        dropped_item_visibility_hidden_for_entity = hide_for_entity;
        dropped_item_visibility_refresh_elapsed = 0.0;
        for di: component_iterator(Dropped_Item) {
            if !#alive(di) || !#alive(di.entity) {
                continue;
            }
            if hide_for_entity {
                di.entity.set_local_enabled(false);
            } else {
                di.update_visibility();
            }
        }
    }

    ensure_local_vision_light :: proc(using this: Player) {
        if local_light_entity != null && #alive(local_light_entity) {
            local_light_entity.set_local_enabled(true);
            return;
        }

        local_light_entity = Scene.create_entity();
        local_light_entity.set_parent(this.entity, false);
        local_light_entity.set_local_enabled(true);
        local_light_entity.set_local_position(v2.{0.0, 0.0});
        local_light_entity.set_local_rotation(0.0);
        local_light_entity.set_local_scale(v2.{1.0, 1.0});

        local_light = local_light_entity.add_component(Light);
        local_light.color = PLAYER_LIGHT_COLOR;
        local_light.intensity = PLAYER_LIGHT_INTENSITY;
        local_light.radii = v2.{PLAYER_LIGHT_FIXED_RADIUS, PLAYER_LIGHT_FIXED_RADIUS + PLAYER_LIGHT_RADIUS_Y_PADDING};

        local_light_caster = local_light_entity.add_component(LOS_Caster);
        local_light_caster.radii = this.get_local_light_radii();
    }

    suspend_local_vision_light :: proc(using this: Player) {
        if local_light_entity != null && #alive(local_light_entity) {
            local_light_entity.set_local_enabled(false);
        }
    }

    update_local_vision_light :: proc(using this: Player) {
        if !this.is_local() return;
        if !#alive(this.entity) return;

        if security_cameras_open {
            this.suspend_local_vision_light();
            return;
        }

        this.ensure_local_vision_light();

        if local_light == null && local_light_entity != null {
            local_light = local_light_entity.get_component(Light);
        }
        if local_light_caster == null && local_light_entity != null {
            local_light_caster = local_light_entity.get_component(LOS_Caster);
        }
        if local_light == null || local_light_caster == null return;

        radii := this.get_local_light_radii();
        local_light.intensity = PLAYER_LIGHT_INTENSITY;
        local_light.radii = v2.{PLAYER_LIGHT_FIXED_RADIUS, PLAYER_LIGHT_FIXED_RADIUS + PLAYER_LIGHT_RADIUS_Y_PADDING};
        local_light_caster.radii = radii;
    }

    clear_round_inventory :: method() {
        if equipped_weapon_type != .NONE {
            weapon_unequip(this, equipped_weapon_type);
            equipped_weapon_type = .NONE;
        }
        equipped_item_def = null;
        last_selected_index = -1;

        slot_index: s64 = 0;
        while slot_index < default_inventory.capacity {
            item := default_inventory.get_item(slot_index);
            if item != null {
                Items.destroy_item_instance(item);
            }
            slot_index += 1;
        }
    }

    get_equipped_item_instance :: method() -> Item_Instance {
        if last_selected_index < 0 || last_selected_index >= default_inventory.capacity {
            return null;
        }

        item := default_inventory.get_item(last_selected_index);
        if item == null {
            return null;
        }
        if item.get_definition() != equipped_item_def {
            return null;
        }
        return item;
    }

    revive_from_downed :: method() -> bool {
        if !this.is_round_downed() {
            return false;
        }

        remove_all_effects(entity);
        this.clear_round_downed_state(true);
        round_revive_request_id += 1;
        sprint_input_held = false;
        sprint_active = false;
        if #alive(agent) {
            agent.velocity = v2{0.0, 0.0};
        }
        return true;
    }

    revive_from_dead :: method() -> bool {
        if !this.is_round_dead() {
            return false;
        }

        remove_all_effects(entity);
        this.clear_round_death_state(true);
        round_revive_request_id += 1;
        clear_corpses_for_player(this);
        sprint_input_held = false;
        sprint_active = false;
        entity_lurch_remaining = 0.0;
        if #alive(agent) {
            agent.velocity = v2{0.0, 0.0};
        }
        return true;
    }

    trigger_end_game_cutscene_dance :: method() {
        if animator == null || animator.state_machine == null {
            return;
        }

        animator.state_machine.set_bool("end_game_cutscene", true);
    }

    prepare_for_end_game_cutscene :: method(position: v2, look_at: v2, dance_index: s64) {
        if !#alive(entity) {
            return;
        }

        remove_all_effects(entity);
        if animator != null && animator.state_machine != null {
            animator.state_machine.set_bool("end_game_cutscene", true);
        }
        this.clear_round_death_state(false);
        sprint_input_held = false;
        sprint_active = false;
        entity_lurch_remaining = 0.0;

        if equipped_weapon_type != .NONE {
            weapon_unequip(this, equipped_weapon_type);
            equipped_weapon_type = .NONE;
        }
        equipped_item_def = null;
        this.destroy_held_item_visual();

        entity.set_local_position(position);
        entity.mark_teleported();
        if #alive(agent) {
            agent.velocity = v2{0.0, 0.0};
        }

        this.set_facing_right(position.x < look_at.x);
        entity_cached_facing_right = position.x < look_at.x;
        this.add_disable_movement_input_reason(END_GAME_CUTSCENE_REASON);
        end_game_cutscene_dance_triggered = true;
    }

    cleanup_end_game_cutscene :: method() {
        this.remove_disable_movement_input_reason(END_GAME_CUTSCENE_REASON);
        if #alive(agent) {
            agent.velocity = v2{0.0, 0.0};
        }

        if animator != null && animator.state_machine != null {
            animator.state_machine.set_bool("end_game_cutscene", false);
            animator.state_machine.set_trigger("RESET");
        }
        end_game_cutscene_dance_triggered = false;
    }

    handle_equipped_item_changing :: method(selected_index: s64) {
        // Resolve item from hotbar index
        selected_item: Item_Instance;
        if selected_index >= 0 && selected_index < default_inventory.capacity {
            selected_item = default_inventory.get_item(selected_index);
        }

        new_def: Item_Definition;
        if selected_item != null {
            new_def = selected_item.get_definition();
        }

        // Skip if nothing changed
        if selected_index == last_selected_index && new_def == equipped_item_def return;
        last_selected_index = selected_index;

        // Skip if same item definition
        if new_def == equipped_item_def return;

        // Unequip old weapon
        if equipped_weapon_type != .NONE {
            weapon_unequip(this, equipped_weapon_type);
            equipped_weapon_type = .NONE;
        }
        this.set_mouse_ik_enabled(false);
        equipped_item_def = null;

        // Equip new weapon if it's a registered weapon
        if new_def != null {
            wt := get_weapon_type_for_item(new_def);
            if wt != .NONE {
                weapon_equip(this, wt);
                equipped_weapon_type = wt;
                equipped_item_def = new_def;
            } else if is_barricade_item_def(new_def) {
                equipped_item_def = new_def;
            }
        }

        this.update_held_item_visual();
    }

    draw_round_dead_player_pointers :: proc(using this: Player) {
        if !this.is_local() || !this.is_round_dead() || !#alive(entity) {
            return;
        }

        entity_player := get_round_entity_player();
        if #alive(entity_player) && entity_player != this && #alive(entity_player.entity) {
            offset := entity_player.entity.world_position - entity.world_position;
            if length_squared(offset) > ROUND_DEAD_ENTITY_POINTER_DISTANCE * ROUND_DEAD_ENTITY_POINTER_DISTANCE {
                this.DrawArrowToPosition(entity_player.entity.world_position, "AbilityIcons/Bite.png");
            }
        }

        for other: component_iterator(Player) {
            if other == this || other == entity_player {
                continue;
            }
            if !other.is_round_survivor() || !#alive(other.entity) {
                continue;
            }

            offset := other.entity.world_position - entity.world_position;
            if length_squared(offset) <= ROUND_DEAD_ENTITY_POINTER_DISTANCE * ROUND_DEAD_ENTITY_POINTER_DISTANCE {
                continue;
            }

            this.DrawArrowToPosition(other.entity.world_position, "UI/schleem_hologram.png");
        }
    }

    draw_downed_bleed_out_ui :: proc(using this: Player) {
        if !this.is_local() || !this.is_round_downed() {
            return;
        }

        seconds_remaining := this.get_downed_bleed_out_seconds_remaining();
        if seconds_remaining <= 0 {
            return;
        }

        if downed_bleed_out_ends_at > 0.0 {
            elapsed := DOWNED_BLEED_OUT_SECONDS - (downed_bleed_out_ends_at - get_time());
            t := clamp(elapsed / DOWNED_BLEED_OUT_SECONDS, 0.0, 1.0);
            eased := pow(t, 1.4);

            overlay_tex := get_asset(Texture_Asset, DOWNED_BLEED_OUT_OVERLAY_PATH);
            if overlay_tex != null {
                UI.push_screen_draw_context();
                UI.push_layer(DOWNED_BLEED_OUT_OVERLAY_LAYER);

                full_screen := UI.get_screen_rect();
                alpha := lerp(0.06, 0.94, eased);
                red := lerp(1.0, 0.35, eased);
                green_blue := lerp(0.55, 0.04, eased);
                tint := v4{red, green_blue, green_blue, alpha};
                UI.quad(full_screen, overlay_tex, tint);

                UI.pop_layer();
                UI.pop_draw_context();
            }
        }

        UIK.begin(UIK.window(UIK.rect_window_small()));

        shell := UIK.panel_modal(.TRANSP_BLACK);
        shell.cross_align = .CENTER;
        shell.main_align = .CENTER;
        shell.gap = 4;
        shell.padding = v4{16, 12, 16, 12};
        UIK.panel_begin(shell);

        UIK.text("Bleeding Out", UIK.text_body());
        UIK.text(format_string("%", {seconds_remaining}), UIK.text_title());
        UIK.text("seconds until death", UIK.text_body());

        UIK.panel_end();
        UIK.end();
    }

    draw_arrow_distance_label :: proc(anchor: v2, label: string, screen: Rect) {
        if label.count <= 0 return;

        label_width :: 92.0;
        label_height :: 30.0;
        label_gap :: 52.0;

        center := anchor + v2{0.0, label_gap};
        half := v2{label_width * 0.5, label_height * 0.5};
        rect := Rect{min=center - half, max=center + half};

        if rect.min.x < screen.min.x {
            rect = rect.offset(screen.min.x - rect.min.x, 0.0);
        }
        if rect.max.x > screen.max.x {
            rect = rect.offset(screen.max.x - rect.max.x, 0.0);
        }
        if rect.max.y > screen.max.y {
            rect = rect.offset(0.0, screen.max.y - rect.max.y);
        }
        if rect.min.y < screen.min.y {
            rect = rect.offset(0.0, screen.min.y - rect.min.y);
        }

        bg := core_globals.white_sprite;
        UI.quad(rect, bg, v4{0.0, 0.0, 0.0, 0.62});

        ts := UI.default_text_settings();
        ts.size = 21;
        ts.color = v4{1.0, 1.0, 1.0, 1.0};
        ts.outline_thickness = 1.7;
        ts.outline_color = v4{0.0, 0.0, 0.0, 0.9};
        ts.do_drop_shadow = true;
        ts.drop_shadow_offset = v2{1.0, -1.5};
        ts.drop_shadow_color = v4{0.0, 0.0, 0.0, 0.55};
        ts.weight = 0.68;

        UI.text(rect, ts, label);
    }

    // Port of the provided C# DrawArrowToPosition.
    // Draws a screen-space arrow pointing toward a world-space `position`.
    DrawArrowToPosition :: proc(using this: Player, position: v2, texture_path: string = "", label: string = "", icon_upright: bool = false, arrow_size_px: float = 40.0) {
        if this == null return;
        if entity == null || entity.self == null return;
        if this.is_local() {
            if this.should_hide_arrow_overlays_for_modal_ui() {
                return;
            }

        // Screen-space overlay so it can't be occluded by world sprites.
        UI.push_screen_draw_context();
        defer UI.pop_draw_context();

        // Above almost everything else in the HUD.
        UI.push_layer(1000);
        defer UI.pop_layer();

        screen := UI.get_screen_rect();
        screen_height := screen.height();
        if screen_height <= 0 {
            return;
        }
        aspect := screen.width() / screen_height;
        if aspect <= 0 {
            aspect = 1.0;
        }

        world_offset := position - entity.world_position;
        distance := length(world_offset);

        target_screen := world_to_screen(position + v2{0, 1.5});
        player_screen := world_to_screen(entity.world_position + v2{0, 1.5});

        delta_screen := target_screen - player_screen;
        dir := v2{1, 0};
        if length_squared(delta_screen) >= 0.00001 {
            dir = normalize(delta_screen);
        }

        anim := pow(abs(sin(PI * get_time())), 0.75);

        // distanceThreshold = ((dir * threshold) / (1, aspect)).Length
        distance_threshold_world :: 6.5;
        dvec := v2{dir.x * distance_threshold_world, dir.y * distance_threshold_world};
        scaled := v2{dvec.x, dvec.y / aspect};
        distance_threshold := length(scaled);

        arrow_tex: Texture_Asset;
        if texture_path.count > 0 {
            arrow_tex = get_asset(Texture_Asset, texture_path);
        }
        else {
            #static default_arrow_tex := get_asset(Texture_Asset, "UI/Arrow.png");
            arrow_tex = default_arrow_tex;
        }
        if arrow_tex == null {
            return;
        }

        if distance >= (distance_threshold + 0.5) {
            t := 1.0 - Ease.T(distance - distance_threshold, 1.0);
            t = clamp(t, 0.0, 1.0);

            arrow_screen := Rect{player_screen, player_screen}.offset(dir.x * 300.0, dir.y * 300.0).center();
            arrow_screen = lerp(arrow_screen, target_screen, t);

            rect := Rect{arrow_screen, arrow_screen}.grow(arrow_size_px);
            rotation := to_degrees(atan2(dir.y, dir.x));

            if icon_upright {
                UI.quad(rect, arrow_tex, {1, 1, 1, 1});
            } else {
                // Rotate around rect center via UI matrix.
                c := rect.center();
                UI.push_matrix(Matrix4.translate(v3{c.x, c.y, 0}));
                UI.push_matrix(Matrix4.rotate(rotation, v3{0, 0, 1}));
                UI.push_matrix(Matrix4.translate(v3{-c.x, -c.y, 0}));
                UI.quad(rect, arrow_tex, {1, 1, 1, 1});
                UI.pop_matrix();
                UI.pop_matrix();
                UI.pop_matrix();
            }

            draw_arrow_distance_label(rect.center(), label, screen);
        }
        else {
            rect := Rect{target_screen, target_screen}.grow(arrow_size_px);
            rect = rect.offset(0, anim * 50.0);

            if icon_upright {
                UI.quad(rect, arrow_tex, {1, 1, 1, 1});
            } else {
                // Near target: fixed "down" arrow (270 degrees).
                c := rect.center();
                UI.push_matrix(Matrix4.translate(v3{c.x, c.y, 0}));
                UI.push_matrix(Matrix4.rotate(270, v3{0, 0, 1}));
                UI.push_matrix(Matrix4.translate(v3{-c.x, -c.y, 0}));
                UI.quad(rect, arrow_tex, {1, 1, 1, 1});
                UI.pop_matrix();
                UI.pop_matrix();
                UI.pop_matrix();
            }

            draw_arrow_distance_label(rect.center(), label, screen);
        }
        }
    }

}

is_entity_ability_type_unlocked :: proc(player: Player, $T: typeid) -> bool {
    if player == null {
        return false;
    }

    for i: 0..player.abilities.count - 1 {
        ability := player.abilities[i];
        if ability.type == T {
            return is_entity_ability_unlocked(ability);
        }
    }

    return false;
}

draw_entity_ability_button :: proc(player: Player, $T: typeid, index: int, unlocked_icon_path: string) {
    for i: 0..player.abilities.count - 1 {
        ability := player.abilities[i];
        if ability.type == T {
            if is_entity_ability_unlocked(ability) {
                ability.icon = get_asset(Texture_Asset, unlocked_icon_path);
            } else {
                ability.icon = get_asset(Texture_Asset, ENTITY_LOCKED_ABILITY_ICON_PATH);
            }
            break;
        }
    }

    draw_ability_button(player, T, index);
}

draw_ability_name_label :: proc(button_rect: Rect, label: string) {
	if label.count <= 0 return;

	bg := get_asset(Texture_Asset, "$AO/white.png");

	// Draw a small strip at the bottom of the button for readability.
	label_rect := button_rect.inset(8).cut_bottom(30);
	UI.quad(label_rect, bg, v4.{0, 0, 0, 0.55});

	ts := UI.default_text_settings();
	ts.size = 22;
	ts.color = v4.{1, 1, 1, 1};
	ts.halign = .CENTER;
	ts.valign = .CENTER;
	ts.do_outline = true;
	ts.outline_thickness = 2;
	ts.outline_color = v4.{0, 0, 0, 1};
	UI.text(label_rect, ts, label);
}
