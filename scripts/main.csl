braam2_next_play_at: float;

BRAAM2_REPLAY_SECONDS :: 45.0;
ROUND_CAMERA_SIZE_DELTA :: 1.0;
ENTITY_CAMERA_SIZE_DELTA :: 1.5;
ROUND_DEAD_CAMERA_SIZE_DELTA :: 2.5;
CHEAT_WIDE_VIEW_CAMERA_SIZE :: 28.0;
ROUND_DEAD_LOCAL_PLAYER_ALPHA :: 150.0 / 255.0;
ROUND_DEAD_ENTITY_POINTER_DISTANCE :: 15.0;
WARP_TO_BACKROOMS_STATIC_SECONDS :: 1.0;

wide_view_cheat_keybind: Keybind;

register_wide_view_cheat_keybind :: proc() {
    if wide_view_cheat_keybind == 0 {
        wide_view_cheat_keybind = Keybinds.register("Wide View", .NR_3);
    }
}

CurrentZone :: enum {
    None;
    Zone1;
    Zone2;
    Zone3;
}

is_round_audio_active :: proc() -> bool {
    gm := get_game_manager();
    if !#alive(gm) {
        return false;
    }
    return gm.phase == .SURVIVOR_HEAD_START || gm.phase == .ACTIVE;
}

get_round_entity_player :: proc() -> Player {
    gm := get_game_manager();
    if !#alive(gm) || gm.entity_user_id.count == 0 {
        return null;
    }

    entity_player, ok := find_player_by_user_id(gm.entity_user_id);
    if !ok || !#alive(entity_player) || !#alive(entity_player.entity) {
        return null;
    }
    return entity_player;
}

stop_round_atmosphere_loop :: proc() {
    if round_atmosphere_loop_sound_id != 0 {
        SFX.stop(round_atmosphere_loop_sound_id);
        round_atmosphere_loop_sound_id = 0;
    }
}

stop_entity_ambience_sound :: proc() {
    if entity_ambience_sound_id != 0 {
        SFX.stop(entity_ambience_sound_id);
        entity_ambience_sound_id = 0;
    }
    entity_ambience_user_id = "";
}

has_round_entity_assignment :: proc() -> bool {
    gm := get_game_manager();
    if !#alive(gm) {
        return false;
    }
    return gm.entity_user_id.count != 0;
}

toggle_wide_view_cheat :: proc(player: Player) {
    if player == null {
        return;
    }

    if !player.cheat_wide_view_active {
        player.cheat_wide_view_active = true;
        log_info("z: % enabled wide view cheat", {player.get_username()});
        return;
    }

    player.cheat_wide_view_active = false;
    log_info("z: % restored normal view", {player.get_username()});
}

z :: proc(player: Player) {
    toggle_wide_view_cheat(player);
} @chat_command

ao_before_scene_load :: proc() {
    // Called before the scene is loaded
    register_sprint_keybinds();
    register_wide_view_cheat_keybind();
}

ao_start :: proc() {
    // Called after the scene is loaded
    if ambient_light_loop_sound_id == 0 {
        light_loop_desc := SFX.default_sfx_desc();
        light_loop_desc.loop = true;
        light_loop_desc.volume = 0.45;
        light_loop_desc.channel = .MUSIC;
        ambient_light_loop_sound_id = SFX.play(get_asset(SFX_Asset, "SFX/lightslongloop.wav"), light_loop_desc);
    }
}

ao_update :: proc(dt: float) {
    rr_backup_maybe_auto();
    round_audio_active := is_round_audio_active();

    if round_audio_active {
        if round_atmosphere_loop_sound_id == 0 {
            atmosphere_desc := SFX.default_sfx_desc();
            atmosphere_desc.loop = true;
            atmosphere_desc.volume = 0.55;
            atmosphere_desc.channel = .MUSIC;
            round_atmosphere_loop_sound_id = SFX.play(get_asset(SFX_Asset, "SFX/atmosphere.wav"), atmosphere_desc);
        }
    } else {
        stop_round_atmosphere_loop();
    }

    entity_assigned := has_round_entity_assignment();
    if !round_audio_active || !entity_assigned {
        stop_entity_ambience_sound();
        braam2_next_play_at = 0.0;
        return;
    }

    if braam2_next_play_at <= 0.0 || get_time() >= braam2_next_play_at {
        braam2_desc := SFX.default_sfx_desc();
        braam2_desc.volume = 0.85;
        braam2_desc.channel = .MUSIC;
        SFX.play(get_asset(SFX_Asset, "SFX/braam2.wav"), braam2_desc);
        braam2_next_play_at = get_time() + BRAAM2_REPLAY_SECONDS;
    }

    entity_player := get_round_entity_player();
    if !#alive(entity_player) {
        stop_entity_ambience_sound();
        return;
    }

    if entity_ambience_sound_id != 0 && entity_ambience_user_id != entity_player.get_user_id() {
        stop_entity_ambience_sound();
    }

    if entity_ambience_sound_id == 0 {
        entity_ambience_desc := SFX.default_sfx_desc();
        entity_ambience_desc.local_only = false;
        entity_ambience_desc.loop = true;
        entity_ambience_desc.volume = 1;
        entity_ambience_desc.channel = .MUSIC;
        entity_ambience_desc.range_multiplier = 2.0;
        entity_ambience_desc.entity_to_follow = entity_player.entity.id;
        entity_ambience_sound_id = SFX.play(get_asset(SFX_Asset, "SFX/entityambience.wav"), entity_ambience_desc);
        entity_ambience_user_id = entity_player.get_user_id();
    }
}

ao_late_update :: proc(dt: float) {
    // Called once per frame after physics has been resolved
}

ao_end :: proc() {
    if ambient_light_loop_sound_id != 0 {
        SFX.stop(ambient_light_loop_sound_id);
        ambient_light_loop_sound_id = 0;
    }
    stop_round_atmosphere_loop();
    stop_entity_ambience_sound();
    braam2_next_play_at = 0.0;
}

