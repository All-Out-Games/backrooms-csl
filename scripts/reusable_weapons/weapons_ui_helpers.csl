LOBBED_AIM_SEGMENT_COUNT :: 14;
LOBBED_AIM_SEGMENT_THICKNESS :: 6.0;
LOBBED_RETICLE_SIZE :: 20.0;

draw_lobbed_arc_segment :: proc(start_screen: v2, end_screen: v2, thickness: float, color: v4) {
    if length_squared(end_screen - start_screen) <= 0.01 return;
    UI.line(start_screen, end_screen, thickness, core_globals.white_sprite, color);
}

draw_lobbed_target_reticle :: proc(target_screen: v2) {
    #static reticle := get_asset(Texture_Asset, "$AO/new/Aiming Indicator/line_finite/reticle.png");

    pulse := 1.0 + 0.08 * sin(get_time() * 8.0);
    shadow_rect := Rect{target_screen, target_screen}.grow((LOBBED_RETICLE_SIZE + 8.0) * pulse).fit_aspect(reticle.get_aspect());
    reticle_rect := Rect{target_screen, target_screen}.grow(LOBBED_RETICLE_SIZE * pulse).fit_aspect(reticle.get_aspect());

    UI.quad(shadow_rect, reticle, {0.08, 0.04, 0.02, 0.25});
    UI.quad(reticle_rect, reticle, {1.0, 0.96, 0.82, 0.95});
}

draw_lobbed_aim_preview :: proc(player: Player, direction: v2, aim_distance: float, wt: Weapon_Type) {
    dir := normalize(direction);
    start_pos := get_lobbed_projectile_start_pos(player, dir);
    target_pos := get_lobbed_target_position_from_player(player, dir, aim_distance);
    travel_distance := length(target_pos - start_pos);

    UI.push_layer(-10);
    defer UI.pop_layer();

    for i: 0..LOBBED_AIM_SEGMENT_COUNT-1 {
        start_t := i.(float) / LOBBED_AIM_SEGMENT_COUNT.(float);
        end_t := (i + 1).(float) / LOBBED_AIM_SEGMENT_COUNT.(float);

        segment_start := get_lobbed_arc_position(start_pos, dir, travel_distance * start_t, travel_distance);
        segment_end := get_lobbed_arc_position(start_pos, dir, travel_distance * end_t, travel_distance);

        start_screen := world_to_screen(segment_start);
        end_screen := world_to_screen(segment_end);
        alpha := lerp(0.35, 0.85, end_t);

        draw_lobbed_arc_segment(start_screen, end_screen, LOBBED_AIM_SEGMENT_THICKNESS + 3.0, {0.1, 0.06, 0.02, alpha * 0.35});
        draw_lobbed_arc_segment(start_screen, end_screen, LOBBED_AIM_SEGMENT_THICKNESS, {1.0, 0.94, 0.7, alpha});
    }

    draw_lobbed_target_reticle(world_to_screen(target_pos));
}

draw_health_bar :: proc(player: Player) {
    UI.push_world_draw_context();
    defer UI.pop_draw_context();

    pos := player.entity.world_position;
    UI.push_z(pos.y - 0.0001);
    defer UI.pop_z();

    UI.push_scale_factor(5.0 / 540.0);
    defer UI.pop_scale_factor();

    health_rect := player.username_rect.top_center_rect().offset(0, 5);
    health_rect = health_rect.grow(13, 70, 0, 70);
    border_rect := health_rect.grow(5.5, 4, 5.5, 4).offset(0, -2);

    back := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/hud_elements/health_bar_green/healthbar_back.png");
    fill := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/hud_elements/health_bar_green/healthbar_fill.png");
    pip := get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/hud_elements/health_bar_green/healthbar_pip.png");

    // Background
    UI.quad(border_rect, back, {1, 1, 1, 1});

    // Health fill
    health_pct := player.weapon_target.health / player.weapon_target.max_health;
    fill_rect := health_rect.subrect(0, 0, health_pct, 1);
    UI.quad(fill_rect, fill, {1, 1, 1, 1});

    // Pip markers
    total_pips :: 6;
    health_per_pip := player.weapon_target.max_health / total_pips.(float);
    left_offset :: 0.05;
    right_offset :: 0.05;
    available_width := 1.0 - left_offset - right_offset;
    pip_width := available_width / total_pips.(float);
    shrink :: 0.3;

    i := 0;
    while i < total_pips {
        pip_threshold := (i + 1).(float) * health_per_pip;
        if player.weapon_target.health >= pip_threshold {
            x_min := left_offset + i.(float) * pip_width;
            new_width := pip_width * shrink;
            new_x_min := x_min + (pip_width - new_width) / 2.0;
            new_x_max := new_x_min + new_width;
            pip_rect := health_rect.subrect(new_x_min, 0, new_x_max, 1);
            UI.quad(pip_rect, pip, {1, 1, 1, 1});
        }
        i += 1;
    }
}
