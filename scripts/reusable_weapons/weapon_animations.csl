setup_reusable_weapons_player_state_machine :: proc(player: Player) {
    sm := player.animator.state_machine;
    base_layer := sm.try_get_layer("main");
    additive_layer := sm.create_layer("additive_layer", 1);

    ao_idle := base_layer.try_get_state("Idle");
    ao_run := base_layer.try_get_state("Run_Slow");
    if ao_run == null {
        ao_run = base_layer.create_state("Run_Slow", true);
    }
    ao_run_ghost := base_layer.try_get_state("Run_Ghost");
    if ao_run_ghost == null {
        ao_run_ghost = base_layer.create_state("Run_Ghost", true);
    }
    downed_idle := base_layer.create_state("Downed_idle", true);
    downed_crawl := base_layer.create_state("Downed_crawl", true);
    downed_hit := base_layer.create_state("hit_downed", false);
    minion_slowed_idle := base_layer.create_state("Idle_Drowsy", true);
    minion_slowed_run := base_layer.create_state("Run_Drowsy", true);
    minion_bite_hit := base_layer.create_state("Hit_By_Dart", false);
    //ao_run := base_layer.try_get_state("Run_Slow");
    moving_var := sm.try_get_variable("moving");
    sprinting_var := sm.create_variable("sprinting", .BOOL);
    round_dead_var := sm.create_variable("round_dead", .BOOL);
    ghost_form_var := sm.try_get_variable("ghost_form");
    if ghost_form_var == null {
        ghost_form_var = sm.create_variable("ghost_form", .BOOL);
    }
    downed_var := sm.create_variable("downed", .BOOL);
    downed_hit_reacting_var := sm.create_variable("downed_hit_reacting", .BOOL);
    end_game_cutscene_var := sm.create_variable("end_game_cutscene", .BOOL);
    minion_slowed_var := sm.create_variable("minion_slowed", .BOOL);
    minion_bite_hit_reacting_var := sm.create_variable("minion_bite_hit_reacting", .BOOL);
    minion_bite_hit_var := sm.create_variable("minion_bite_hit", .TRIGGER);
    sprint_state := base_layer.create_state("SL/Sprint", true);

    //--- Base Layer: IK variables ---//
    use_2h_ik := sm.create_variable("use_2h_ik", .BOOL);
    use_1h_ik := sm.create_variable("use_1h_ik", .BOOL);

    idle_to_run := base_layer.create_transition(ao_idle, ao_run, false);
    idle_to_run.create_bool_condition(moving_var, true);
    idle_to_run.create_bool_condition(sprinting_var, false);
    idle_to_run.create_bool_condition(round_dead_var, false);
    idle_to_run.create_bool_condition(downed_var, false);
    idle_to_run.create_bool_condition(minion_slowed_var, false);
    idle_to_run.create_bool_condition(end_game_cutscene_var, false);
    idle_to_run.create_bool_condition(use_2h_ik, false);
    idle_to_run.create_bool_condition(use_1h_ik, false);

    to_normal_run := base_layer.create_global_transition(ao_run, false);
    to_normal_run.create_bool_condition(moving_var, true);
    to_normal_run.create_bool_condition(sprinting_var, false);
    to_normal_run.create_bool_condition(round_dead_var, false);
    to_normal_run.create_bool_condition(downed_var, false);
    to_normal_run.create_bool_condition(minion_slowed_var, false);
    to_normal_run.create_bool_condition(end_game_cutscene_var, false);
    to_normal_run.create_bool_condition(use_2h_ik, false);
    to_normal_run.create_bool_condition(use_1h_ik, false);

    idle_to_ghost_run := base_layer.create_transition(ao_idle, ao_run_ghost, false);
    idle_to_ghost_run.create_bool_condition(moving_var, true);
    idle_to_ghost_run.create_bool_condition(round_dead_var, true);
    idle_to_ghost_run.create_bool_condition(ghost_form_var, true);
    idle_to_ghost_run.create_bool_condition(end_game_cutscene_var, false);
    idle_to_ghost_run.create_bool_condition(use_2h_ik, false);
    idle_to_ghost_run.create_bool_condition(use_1h_ik, false);

    to_ghost_run := base_layer.create_global_transition(ao_run_ghost, false);
    to_ghost_run.create_bool_condition(moving_var, true);
    to_ghost_run.create_bool_condition(round_dead_var, true);
    to_ghost_run.create_bool_condition(ghost_form_var, true);
    to_ghost_run.create_bool_condition(end_game_cutscene_var, false);
    to_ghost_run.create_bool_condition(use_2h_ik, false);
    to_ghost_run.create_bool_condition(use_1h_ik, false);

    run_to_idle := base_layer.create_transition(ao_run, ao_idle, false);
    run_to_idle.create_bool_condition(moving_var, false);

    ghost_run_to_idle := base_layer.create_transition(ao_run_ghost, ao_idle, false);
    ghost_run_to_idle.create_bool_condition(moving_var, false);
    run_to_ghost_run := base_layer.create_transition(ao_run, ao_run_ghost, false);
    run_to_ghost_run.create_bool_condition(round_dead_var, true);
    run_to_ghost_run.create_bool_condition(ghost_form_var, true);
    base_layer.create_transition(ao_run_ghost, ao_run, false).create_bool_condition(round_dead_var, false);

    to_downed_idle := base_layer.create_global_transition(downed_idle, false);
    to_downed_idle.create_bool_condition(downed_var, true);
    to_downed_idle.create_bool_condition(downed_hit_reacting_var, false);
    to_downed_idle.create_bool_condition(round_dead_var, false);
    to_downed_idle.create_bool_condition(moving_var, false);

    to_downed_crawl := base_layer.create_global_transition(downed_crawl, false);
    to_downed_crawl.create_bool_condition(downed_var, true);
    to_downed_crawl.create_bool_condition(downed_hit_reacting_var, false);
    to_downed_crawl.create_bool_condition(round_dead_var, false);
    to_downed_crawl.create_bool_condition(moving_var, true);

    downed_idle_to_crawl := base_layer.create_transition(downed_idle, downed_crawl, false);
    downed_idle_to_crawl.create_bool_condition(moving_var, true);

    downed_crawl_to_idle := base_layer.create_transition(downed_crawl, downed_idle, false);
    downed_crawl_to_idle.create_bool_condition(moving_var, false);

    downed_idle_to_idle := base_layer.create_transition(downed_idle, ao_idle, false);
    downed_idle_to_idle.create_bool_condition(downed_var, false);

    downed_crawl_to_run := base_layer.create_transition(downed_crawl, ao_run, false);
    downed_crawl_to_run.create_bool_condition(downed_var, false);
    downed_crawl_to_run.create_bool_condition(moving_var, true);

    downed_crawl_to_idle_on_recover := base_layer.create_transition(downed_crawl, ao_idle, false);
    downed_crawl_to_idle_on_recover.create_bool_condition(downed_var, false);
    downed_crawl_to_idle_on_recover.create_bool_condition(moving_var, false);

    to_downed_hit := base_layer.create_global_transition(downed_hit, true);
    to_downed_hit.create_trigger_condition(sm.create_variable("hit_downed", .TRIGGER));

    downed_hit_to_idle := base_layer.create_transition(downed_hit, downed_idle, true);
    downed_hit_to_idle.create_bool_condition(moving_var, false);

    downed_hit_to_crawl := base_layer.create_transition(downed_hit, downed_crawl, true);
    downed_hit_to_crawl.create_bool_condition(moving_var, true);

    to_sprint := base_layer.create_global_transition(sprint_state, false);
    to_sprint.create_bool_condition(sprinting_var, true);
    to_sprint.create_bool_condition(moving_var, true);
    to_sprint.create_bool_condition(round_dead_var, false);
    to_sprint.create_bool_condition(downed_var, false);
    to_sprint.create_bool_condition(minion_slowed_var, false);
    to_sprint.create_bool_condition(end_game_cutscene_var, false);
    to_sprint.create_bool_condition(use_2h_ik, false);
    to_sprint.create_bool_condition(use_1h_ik, false);

    base_layer.create_transition(sprint_state, ao_idle, false).create_bool_condition(moving_var, false);
    back_to_run := base_layer.create_transition(sprint_state, ao_run, false);
    back_to_run.create_bool_condition(moving_var, true);
    back_to_run.create_bool_condition(sprinting_var, false);
    back_to_run.create_bool_condition(round_dead_var, false);
    back_to_run.create_bool_condition(minion_slowed_var, false);
    back_to_run.create_bool_condition(end_game_cutscene_var, false);
    back_to_run.create_bool_condition(use_2h_ik, false);
    back_to_run.create_bool_condition(use_1h_ik, false);

    to_minion_slowed_idle := base_layer.create_global_transition(minion_slowed_idle, false);
    to_minion_slowed_idle.create_bool_condition(minion_slowed_var, true);
    to_minion_slowed_idle.create_bool_condition(moving_var, false);
    to_minion_slowed_idle.create_bool_condition(round_dead_var, false);
    to_minion_slowed_idle.create_bool_condition(downed_var, false);
    to_minion_slowed_idle.create_bool_condition(end_game_cutscene_var, false);
    to_minion_slowed_idle.create_bool_condition(minion_bite_hit_reacting_var, false);

    to_minion_slowed_run := base_layer.create_global_transition(minion_slowed_run, false);
    to_minion_slowed_run.create_bool_condition(minion_slowed_var, true);
    to_minion_slowed_run.create_bool_condition(moving_var, true);
    to_minion_slowed_run.create_bool_condition(round_dead_var, false);
    to_minion_slowed_run.create_bool_condition(downed_var, false);
    to_minion_slowed_run.create_bool_condition(end_game_cutscene_var, false);
    to_minion_slowed_run.create_bool_condition(minion_bite_hit_reacting_var, false);

    minion_slowed_idle_to_run := base_layer.create_transition(minion_slowed_idle, minion_slowed_run, false);
    minion_slowed_idle_to_run.create_bool_condition(moving_var, true);
    minion_slowed_idle_to_run.create_bool_condition(minion_slowed_var, true);

    minion_slowed_run_to_idle := base_layer.create_transition(minion_slowed_run, minion_slowed_idle, false);
    minion_slowed_run_to_idle.create_bool_condition(moving_var, false);
    minion_slowed_run_to_idle.create_bool_condition(minion_slowed_var, true);

    minion_slowed_idle_to_idle := base_layer.create_transition(minion_slowed_idle, ao_idle, false);
    minion_slowed_idle_to_idle.create_bool_condition(minion_slowed_var, false);
    minion_slowed_idle_to_idle.create_bool_condition(moving_var, false);

    minion_slowed_run_to_run := base_layer.create_transition(minion_slowed_run, ao_run, false);
    minion_slowed_run_to_run.create_bool_condition(minion_slowed_var, false);
    minion_slowed_run_to_run.create_bool_condition(moving_var, true);

    to_minion_bite_hit := base_layer.create_global_transition(minion_bite_hit, true);
    to_minion_bite_hit.create_trigger_condition(minion_bite_hit_var);

    minion_bite_hit_to_slowed_idle := base_layer.create_transition(minion_bite_hit, minion_slowed_idle, true);
    minion_bite_hit_to_slowed_idle.create_bool_condition(minion_slowed_var, true);
    minion_bite_hit_to_slowed_idle.create_bool_condition(moving_var, false);

    minion_bite_hit_to_slowed_run := base_layer.create_transition(minion_bite_hit, minion_slowed_run, true);
    minion_bite_hit_to_slowed_run.create_bool_condition(minion_slowed_var, true);
    minion_bite_hit_to_slowed_run.create_bool_condition(moving_var, true);

    minion_bite_hit_to_idle := base_layer.create_transition(minion_bite_hit, ao_idle, true);
    minion_bite_hit_to_idle.create_bool_condition(minion_slowed_var, false);
    minion_bite_hit_to_idle.create_bool_condition(moving_var, false);

    minion_bite_hit_to_run := base_layer.create_transition(minion_bite_hit, ao_run, true);
    minion_bite_hit_to_run.create_bool_condition(minion_slowed_var, false);
    minion_bite_hit_to_run.create_bool_condition(moving_var, true);

    //--- Base Layer: 2-handed weapon idle/run ---//
    aim_run_2h := base_layer.create_state("redsun/Run_Fast_mIK_twohands", true);
    aim_idle_2h := base_layer.create_state("redsun/Idle_mIK_twohands", true);

    sprint_to_aim_run_2h := base_layer.create_transition(sprint_state, aim_run_2h, false);
    sprint_to_aim_run_2h.create_bool_condition(moving_var, true);
    sprint_to_aim_run_2h.create_bool_condition(round_dead_var, false);
    sprint_to_aim_run_2h.create_bool_condition(end_game_cutscene_var, false);
    sprint_to_aim_run_2h.create_bool_condition(use_2h_ik, true);
    idle_to_aim_2h := base_layer.create_transition(ao_idle, aim_idle_2h, false);
    idle_to_aim_2h.create_bool_condition(use_2h_ik, true);
    idle_to_aim_2h.create_bool_condition(end_game_cutscene_var, false);
    run_to_aim_2h := base_layer.create_transition(ao_run, aim_run_2h, false);
    run_to_aim_2h.create_bool_condition(use_2h_ik, true);
    run_to_aim_2h.create_bool_condition(end_game_cutscene_var, false);
    idle_to_aim_run_2h := base_layer.create_transition(aim_idle_2h, aim_run_2h, false);
    idle_to_aim_run_2h.create_bool_condition(moving_var, true);
    base_layer.create_transition(aim_run_2h, aim_idle_2h, false).create_bool_condition(moving_var, false);
    base_layer.create_transition(aim_idle_2h, ao_idle, false).create_bool_condition(use_2h_ik, false);
    base_layer.create_transition(aim_run_2h, ao_run, false).create_bool_condition(use_2h_ik, false);

    //--- Base Layer: 1-handed weapon idle/run ---//
    aim_run_1h := base_layer.create_state("redsun/Run_Fast_mIK", true);
    aim_idle_1h := base_layer.create_state("redsun/Idle_mIK", true);

    sprint_to_aim_run_1h := base_layer.create_transition(sprint_state, aim_run_1h, false);
    sprint_to_aim_run_1h.create_bool_condition(moving_var, true);
    sprint_to_aim_run_1h.create_bool_condition(round_dead_var, false);
    sprint_to_aim_run_1h.create_bool_condition(end_game_cutscene_var, false);
    sprint_to_aim_run_1h.create_bool_condition(use_1h_ik, true);
    idle_to_aim_1h := base_layer.create_transition(ao_idle, aim_idle_1h, false);
    idle_to_aim_1h.create_bool_condition(use_1h_ik, true);
    idle_to_aim_1h.create_bool_condition(end_game_cutscene_var, false);
    run_to_aim_1h := base_layer.create_transition(ao_run, aim_run_1h, false);
    run_to_aim_1h.create_bool_condition(use_1h_ik, true);
    run_to_aim_1h.create_bool_condition(end_game_cutscene_var, false);
    idle_to_aim_run_1h := base_layer.create_transition(aim_idle_1h, aim_run_1h, false);
    idle_to_aim_run_1h.create_bool_condition(moving_var, true);
    base_layer.create_transition(aim_run_1h, aim_idle_1h, false).create_bool_condition(moving_var, false);
    base_layer.create_transition(aim_idle_1h, ao_idle, false).create_bool_condition(use_1h_ik, false);
    base_layer.create_transition(aim_run_1h, ao_run, false).create_bool_condition(use_1h_ik, false);

    //--- Additive Layer ---//
    idle_state := additive_layer.create_state("__CLEAR_TRACK__", true);
    additive_layer.set_initial_state(idle_state);

    // Rapid fire 2h: continuous weapons (AR, SMG, BeamMachine, WaterGun, MissileBarrage, HydroCannon)
    shoot_fast_state := additive_layer.create_state("redsun/Shoot_Gun_mIK_AL_twohands_rapid", true);
    additive_layer.create_transition(idle_state, shoot_fast_state, false).create_trigger_condition(sm.create_variable("shoot_fast_start", .TRIGGER));
    additive_layer.create_transition(shoot_fast_state, idle_state, false).create_trigger_condition(sm.create_variable("shoot_fast_end", .TRIGGER));

    // Single shot 2h (ExplosiveShotgun, SunnySideShotty, WaterBalloonRPG, Boomwheel)
    shoot_2h_state := additive_layer.create_state("redsun/Shoot_Gun_mIK_AL_twohands", false);
    additive_layer.create_transition(idle_state, shoot_2h_state, false).create_trigger_condition(sm.create_variable("shoot_2h_weapon", .TRIGGER));
    additive_layer.create_transition(shoot_2h_state, idle_state, true);

    // Single shot 1h (Blunderbuss, RayGun, PlasmaBurst, MegaBlade, Buzzshot, GoldenRocket)
    shoot_1h_state := additive_layer.create_state("redsun/Shoot_Gun_mIK_AL", false);
    additive_layer.create_transition(idle_state, shoot_1h_state, false).create_trigger_condition(sm.create_variable("shoot_1h_weapon", .TRIGGER));
    additive_layer.create_transition(shoot_1h_state, idle_state, true);

    // Throw (PoisonGrenade)
    throw_state := additive_layer.create_state("redsun/Throw_mIK", false);
    additive_layer.create_transition(idle_state, throw_state, false).create_trigger_condition(sm.create_variable("throw", .TRIGGER));
    additive_layer.create_transition(throw_state, idle_state, true);

    // Akimbo pistols
    shoot_akimbo_state := additive_layer.create_state("redsun/special/Shoot_Akimbo_mIK_AL", false);
    additive_layer.create_transition(idle_state, shoot_akimbo_state, false).create_trigger_condition(sm.create_variable("shoot_akimbo_pistols", .TRIGGER));
    additive_layer.create_transition(shoot_akimbo_state, idle_state, true);

    // Gatling gun (continuous loop)
    shoot_gatling_state := additive_layer.create_state("redsun/special/Shoot_Gatling_Gun_Loop_mIK_AL", true);
    additive_layer.create_transition(idle_state, shoot_gatling_state, false).create_trigger_condition(sm.create_variable("shoot_gatling_start", .TRIGGER));
    additive_layer.create_transition(shoot_gatling_state, idle_state, false).create_trigger_condition(sm.create_variable("shoot_gatling_end", .TRIGGER));

    // Fire Ray beam
    shoot_fire_ray_state := additive_layer.create_state("redsun/special/Shoot_Freeze_Ray_Loop_mIK_AL", true);
    additive_layer.create_transition(idle_state, shoot_fire_ray_state, false).create_trigger_condition(sm.create_variable("fire_ray_start", .TRIGGER));
    additive_layer.create_transition(shoot_fire_ray_state, idle_state, false).create_trigger_condition(sm.create_variable("fire_ray_end", .TRIGGER));

    // Ice Launcher / Glaciator beam
    shoot_ice_state := additive_layer.create_state("redsun/special/Shoot_Ice_Launcher_Loop_mIK_AL", true);
    additive_layer.create_transition(idle_state, shoot_ice_state, false).create_trigger_condition(sm.create_variable("fire_ice_launcher", .TRIGGER));
    additive_layer.create_transition(shoot_ice_state, idle_state, false).create_trigger_condition(sm.create_variable("fire_ice_launcher_end", .TRIGGER));

    // Solar Siphoner beam
    shoot_solar_state := additive_layer.create_state("redsun/special/Shoot_Solar_Siphoner_Loop_mIK_AL", true);
    additive_layer.create_transition(idle_state, shoot_solar_state, false).create_trigger_condition(sm.create_variable("fire_solar_siphoner", .TRIGGER));
    additive_layer.create_transition(shoot_solar_state, idle_state, false).create_trigger_condition(sm.create_variable("fire_solar_siphoner_end", .TRIGGER));

    // Octo Siphoner beam
    shoot_octo_state := additive_layer.create_state("redsun/special/shoot_octo_loop", true);
    additive_layer.create_transition(idle_state, shoot_octo_state, false).create_trigger_condition(sm.create_variable("fire_octo_siphoner", .TRIGGER));
    additive_layer.create_transition(shoot_octo_state, idle_state, false).create_trigger_condition(sm.create_variable("fire_octo_siphoner_end", .TRIGGER));

    // Void Splitter beam
    shoot_void_state := additive_layer.create_state("redsun/special/Shoot_Void_Spitter_Loop", true);
    additive_layer.create_transition(idle_state, shoot_void_state, false).create_trigger_condition(sm.create_variable("void_splitter_start", .TRIGGER));
    additive_layer.create_transition(shoot_void_state, idle_state, false).create_trigger_condition(sm.create_variable("void_splitter_end", .TRIGGER));

    // Storms Eye
    shoot_storms_state := additive_layer.create_state("redsun/special/Storms_Eye_Loop_AL", true);
    additive_layer.create_transition(idle_state, shoot_storms_state, false).create_trigger_condition(sm.create_variable("storms_eye_start", .TRIGGER));
    additive_layer.create_transition(shoot_storms_state, idle_state, false).create_trigger_condition(sm.create_variable("storms_eye_end", .TRIGGER));

    // Wind Blaster
    shoot_wind_state := additive_layer.create_state("redsun/special/Shoot_Wind_Blaster_mIK_AL", false);
    additive_layer.create_transition(idle_state, shoot_wind_state, false).create_trigger_condition(sm.create_variable("shoot_wind_blaster", .TRIGGER));
    additive_layer.create_transition(shoot_wind_state, idle_state, true);

    // Hands out (Boomwheel cannon push pose)
    hands_out_state := additive_layer.create_state("redsun/Hands_Out_AL", true);
    additive_layer.create_transition(idle_state, hands_out_state, false).create_trigger_condition(sm.create_variable("hands_out_start", .TRIGGER));
    additive_layer.create_transition(hands_out_state, idle_state, false).create_trigger_condition(sm.create_variable("hands_out_end", .TRIGGER));

    // Melee (katana slash)
    melee_state := additive_layer.create_state("Attack_Melee_1_mIK_AL2", false);
    additive_layer.create_transition(idle_state, melee_state, false).create_trigger_condition(sm.create_variable("melee_AL", .TRIGGER));
    additive_layer.create_transition(melee_state, idle_state, true);

    // Dance
    dance_state := base_layer.try_get_state("Emote/Dance");
    if dance_state == null {
        dance_state = base_layer.create_state("Emote/Dance", true);
    }
    if dance_state != null {
        to_dance := base_layer.create_global_transition(dance_state, false);
        to_dance.create_bool_condition(end_game_cutscene_var, true);
    }

    jumpscare_state := base_layer.try_get_state("Emote/Jumpscare");
    if jumpscare_state == null {
        jumpscare_state = base_layer.create_state("Emote/Jumpscare", false);
    }
    jumpscare_idle_state := base_layer.try_get_state("Idle_Drowsy");
    if jumpscare_idle_state == null {
        jumpscare_idle_state = base_layer.create_state("Idle_Drowsy", true);
    }
    jumpscared_var := sm.try_get_variable("jumpscared");
    if jumpscared_var == null {
        jumpscared_var = sm.create_variable("jumpscared", .BOOL);
    }
    jumpscare_trigger := sm.try_get_variable("jumpscare");
    if jumpscare_trigger == null {
        jumpscare_trigger = sm.create_variable("jumpscare", .TRIGGER);
    }

    base_layer.create_global_transition(jumpscare_state, true).create_trigger_condition(jumpscare_trigger);
    jumpscare_to_idle := base_layer.create_transition(jumpscare_state, jumpscare_idle_state, true);
    jumpscare_to_idle.create_bool_condition(jumpscared_var, true);
    jumpscare_idle_to_idle := base_layer.create_transition(jumpscare_idle_state, ao_idle, false);
    jumpscare_idle_to_idle.create_bool_condition(jumpscared_var, false);
    jumpscare_idle_to_idle.create_bool_condition(minion_slowed_var, false);
}
