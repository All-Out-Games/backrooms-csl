import "core:ao"
import "reusable_weapons"

CAMERA_ZOOM_OUT_MULTIPLIER :: 1.5;
IN_SHIP_INVISIBILITY_REASON :: "in_ship";
SHIP_ROTATION_LERP_SPEED :: 6.0;
SHIP_CANNON_AIM_ROTATION_OFFSET_DEGREES :: -90.0;

ao_before_scene_load :: proc() {
    // Called before the scene is loaded
}

ao_start :: proc() {
    // Called after the scene is loaded
}

ao_update :: proc(dt: float) {
    // Called once per frame
}

ao_late_update :: proc(dt: float) {
    // Called once per frame after physics has been resolved
}



Player :: class : Player_Base {
    ShipRef: Object;
    InShip: bool;
    in_ship_invisibility_applied: bool;
    ship_lerped_rotation_degrees: float;
    ship_cannon_has_aim_target: bool;
    ship_cannon_aim_target: v2;

    weapon_target: Weapon_Target;
    equipped_weapon_type: Weapon_Type;
    equipped_item_def: Item_Definition;
    last_selected_index: s64;
    boomwheel_cannon: Boomwheel_Cannon; // only needed if using Boomwheel

    start_enter_ship_transition :: method() {
        if ShipRef == null return;

        ship := ShipRef.(Ship);
        if !#alive(ship) || !#alive(ship.PilotSpot) return;

        boat_sway := ship.entity.get_component(BoatSway);
        if #alive(boat_sway) {
            ship_lerped_rotation_degrees = boat_sway.ship_rotation_offset_degrees;
        } else {
            ship_lerped_rotation_degrees = ship.entity.local_rotation;
        }

        InShip = true;
        entity.set_local_position(ship.PilotSpot.world_position);
    }

    lerp_ship_rotation :: method(current: float, target: float, t: float) -> float {
        delta := target - current;
        while delta > 180.0 {
            delta -= 360.0;
        }
        while delta < -180.0 {
            delta += 360.0;
        }
        return current + (delta * clamp(t, 0.0, 1.0));
    }

    sync_ship_spine_to_owner :: method(ship: Ship) {
        if !#alive(ship) || !#alive(ship.Spine) return;

        animator.awaken();
        ship.Spine.awaken();
        if animator.instance == null || ship.Spine.instance == null return;

        ship.Spine.instance.disable_all_skins();
        for skin: animator.instance.get_skins() {
            ship.Spine.instance.enable_skin(skin);
        }
        ship.Spine.instance.refresh_skins();
        ship.Spine.instance.set_color_replace_color(avatar_color);
        ship_rotation := ship.entity.local_rotation;
        while ship_rotation < 0.0 {
            ship_rotation += 360.0;
        }
        while ship_rotation >= 360.0 {
            ship_rotation -= 360.0;
        }

        ship.Spine.entity.set_local_rotation(-ship.entity.local_rotation);

        current_spine_scale := ship.Spine.entity.local_scale;
        spine_x_scale := abs(current_spine_scale.x);
        if ship_rotation > 0.0 && ship_rotation < 180.0 {
            spine_x_scale = -spine_x_scale;
        }
        ship.Spine.entity.set_local_scale({spine_x_scale, current_spine_scale.y});
    }

    update_in_ship_visibility :: method() {
        if InShip {
            if !in_ship_invisibility_applied {
                add_invisibility_reason(IN_SHIP_INVISIBILITY_REASON);
                in_ship_invisibility_applied = true;
            }
            return;
        }

        if in_ship_invisibility_applied {
            remove_invisibility_reason(IN_SHIP_INVISIBILITY_REASON);
            in_ship_invisibility_applied = false;
        }
    }

    set_base_moving_state :: method(is_moving: bool) {
        if animator == null return;

        animator.awaken();
        if animator.instance == null return;

        state_machine := animator.instance.state_machine;
        if state_machine == null return;

        if state_machine.try_get_variable("moving") != null {
            state_machine.set_bool("moving", is_moving);
            return;
        }

        if state_machine.try_get_variable("is_moving") != null {
            state_machine.set_bool("is_moving", is_moving);
        }
    }

    set_ship_cannon_aim_target :: method(target: v2) {
        ship_cannon_has_aim_target = true;
        ship_cannon_aim_target = target;
    }

    rotate_ship_cannon_towards_target :: method(ship: Ship) {
        if !ship_cannon_has_aim_target return;
        if !#alive(ship) || !#alive(ship.Cannon) return;

        aim_offset := ship_cannon_aim_target - ship.Cannon.world_position;
        if length_squared(aim_offset) <= 0.0001 return;

        desired_world_rotation := to_degrees(atan2(aim_offset.y, aim_offset.x)) + SHIP_CANNON_AIM_ROTATION_OFFSET_DEGREES;
        desired_local_rotation := desired_world_rotation - ship.entity.local_rotation;
        ship.Cannon.set_local_rotation(desired_local_rotation);
    }

    update_in_ship_transform :: method(dt: float) {
        if !InShip || ShipRef == null return;

        ship := ShipRef.(Ship);
        if !#alive(ship) || !#alive(ship.PilotSpot) {
            InShip = false;
            return;
        }

        sync_ship_spine_to_owner(ship);
        ship.entity.set_local_position(entity.world_position);

        boat_sway := ship.entity.get_component(BoatSway);
        if #alive(agent) {
            vel := agent.velocity;
            speed_sq := (vel.x * vel.x) + (vel.y * vel.y);
            if speed_sq > 0.0001 {
                desired_rotation := to_degrees(atan2(vel.y, vel.x)) - 90.0;
                if #alive(boat_sway) {
                    desired_rotation -= boat_sway.base_local_rotation;
                }
                ship_lerped_rotation_degrees = lerp_ship_rotation(
                    ship_lerped_rotation_degrees,
                    desired_rotation,
                    dt * SHIP_ROTATION_LERP_SPEED
                );
            }
        }

        if #alive(boat_sway) {
            boat_sway.ship_rotation_offset_degrees = ship_lerped_rotation_degrees;
        } else {
            ship.entity.set_local_rotation(ship_lerped_rotation_degrees);
        }

        set_base_moving_state(false);
    }

    ao_start :: method() {
        // Called when this component is created
        camera.size *= CAMERA_ZOOM_OUT_MULTIPLIER;

        for ship: component_iterator(Ship) {
            if ship.PlayerOwner != null continue;

            ShipRef = ship;
            ship.PlayerOwner = this;
            break;
        }

        wt := entity.add_component(Weapon_Target);
        wt.health = 100.0;
        wt.max_health = 100.0;
        wt.owner_entity_id = entity.id;
        weapon_target = wt;

        last_selected_index = -1;

        init_weapon_items();
        setup_reusable_weapons_player_state_machine(this);
    }

    ao_update :: method(dt: float) {
    }

    ao_late_update :: method(dt: float) {
        ship_cannon_has_aim_target = false;
        update_in_ship_transform(dt);
        selected_hotbar_index := last_selected_index;

        if is_local_or_server() {
            // Draw fire ability button based on equipped weapon
            if equipped_weapon_type != .NONE {
                config := get_weapon_config(equipped_weapon_type);
                switch config.fire_mode {
                    case .CONTINUOUS:  { draw_ability_button(this, Continuous_Fire_Ability, 0); }
                    case .SINGLE_SHOT: { draw_ability_button(this, Single_Shot_Ability, 0); }
                    case .SPREAD:      { draw_ability_button(this, Spread_Shot_Ability, 0); }
                    case .LOBBED:      { draw_ability_button(this, Lobbed_Shot_Ability, 0); }
                    case .BEAM:        { draw_ability_button(this, Beam_Ability, 0); }
                    case .SPECIAL:     { draw_ability_button(this, Special_Ability, 0); }
                }
                draw_ability_button(this, Melee_Ability, 1); // optional melee
            }

            // Draw hotbar and handle equip/unequip
            options := Inventory_Draw_Options.default();
            hotbar := Items.draw_hotbar(this, default_inventory, options);
            selected_hotbar_index = hotbar.selected_item_index;
        }

        handle_equipped_item_changing(selected_hotbar_index);

        if !Game.is_server() {
            draw_health_bar(this); // from weapons_ui_helpers.csl
        }

        // Called once per frame after physics has been resolved
        if is_local_or_server() && ShipRef != null && !InShip {
            ship := ShipRef.(Ship);
            if #alive(ship) && #alive(ship.PilotSpot) {
                draw_ability_button(this, Enter_Ship_Ability, 0);
            }
        }

        if InShip && ShipRef != null {
            ship := ShipRef.(Ship);
            if !#alive(ship) || !#alive(ship.PilotSpot) {
                InShip = false;
            } else {
                rotate_ship_cannon_towards_target(ship);
            }
        } else if InShip {
            InShip = false;
        }

        update_in_ship_visibility();

        if !InShip {
            is_moving := false;
            if #alive(agent) {
                vel := agent.velocity;
                speed_sq := (vel.x * vel.x) + (vel.y * vel.y);
                if speed_sq > 0.0001 {
                    is_moving = true;
                }
            }

            set_base_moving_state(is_moving);
        }
    }

    ao_end :: method() {
        // Called when this component is destroyed
        if in_ship_invisibility_applied {
            remove_invisibility_reason(IN_SHIP_INVISIBILITY_REASON);
            in_ship_invisibility_applied = false;
        }
    }

    ao_can_use_ability :: method(ability: Ability_Base) -> bool {
        // Called to determine if the player is allowed to use the given ability
        return true;
    }

    ao_can_use_interactable :: method(interactable: Interactable) -> bool {
        // Called to determine if the player is allowed to use the given interactable
        return true;
    }

    ao_on_interactable_used :: method(interactable: Interactable) {
        // Called when the player uses the given interactable
    }

    ao_on_holding_interactable :: method(interactable: Interactable) {
        // Called once per frame while the player is holding on the interactable
    }

    ao_on_state_sync :: method() {
        // Called on the client after applying a state sync from the server
        // Use this to override things for the local player only like name colors or lighting for example
    }

    handle_equipped_item_changing :: method(selected_index: s64) {
        // Resolve item from hotbar index unless the ship cannon should override it.
        selected_item: Item_Instance;
        if selected_index >= 0 && selected_index < default_inventory.capacity {
            selected_item = default_inventory.get_item(selected_index);
        }

        new_def: Item_Definition;
        if selected_item != null {
            new_def = selected_item.get_definition();
        }

        last_selected_index = selected_index;

        desired_weapon_type: Weapon_Type;
        desired_item_def: Item_Definition;

        if InShip {
            desired_weapon_type = .SHIP_CANNON;
        } else if new_def != null {
            desired_weapon_type = get_weapon_type_for_item(new_def);
            if desired_weapon_type != .NONE {
                desired_item_def = new_def;
            }
        }

        if desired_weapon_type == equipped_weapon_type && desired_item_def == equipped_item_def return;

        if equipped_weapon_type != .NONE {
            weapon_unequip(this, equipped_weapon_type);
            equipped_weapon_type = .NONE;
        }
        equipped_item_def = null;

        if desired_weapon_type != .NONE {
            weapon_equip(this, desired_weapon_type);
            equipped_weapon_type = desired_weapon_type;
            equipped_item_def = desired_item_def;
        }
    }

}
