BoatSway :: class : Component {
    horizontal_amplitude: float @ao_serialize;
    vertical_amplitude: float @ao_serialize;
    rotation_amplitude_degrees: float @ao_serialize;
    position_frequency: float @ao_serialize;
    rotation_frequency: float @ao_serialize;
    position_phase_offset: float @ao_serialize;
    rotation_phase_offset: float @ao_serialize;
    ship_rotation_offset_degrees: float;

    base_local_position: v2;
    base_local_rotation: float;
    time_offset: float;

    ao_start :: method() {
        if horizontal_amplitude == 0.0 { horizontal_amplitude = 0.08; }
        if vertical_amplitude == 0.0 { vertical_amplitude = 0.04; }
        if rotation_amplitude_degrees == 0.0 { rotation_amplitude_degrees = 2.5; }
        if position_frequency <= 0.0 { position_frequency = 1.0; }
        if rotation_frequency <= 0.0 { rotation_frequency = 1.15; }

        base_local_position = entity.local_position;
        base_local_rotation = entity.local_rotation;

        // De-sync multiple boats so they do not sway in perfect unison.
        rng: u64 = rng_seed(entity.id);
        time_offset = rng_range_float(ref rng, 0.0, 1000.0);
    }

    ao_update :: method(dt: float) {
       // if !Game.is_server() return;

        t := get_time() + time_offset;

        x_offset := sin((t * position_frequency) + position_phase_offset) * horizontal_amplitude;
        y_offset := sin((t * position_frequency * 1.31) + position_phase_offset + 1.57) * vertical_amplitude;
        rotation_offset := sin((t * rotation_frequency) + rotation_phase_offset) * rotation_amplitude_degrees;

        entity.set_local_position(base_local_position + v2.{x_offset, y_offset});
        entity.set_local_rotation(base_local_rotation + ship_rotation_offset_degrees + rotation_offset);
    }

    ao_end :: method() {
        if entity == null return;
        entity.set_local_position(base_local_position);
        entity.set_local_rotation(base_local_rotation);
    }
}
