import "core:ao"

VITALS_SPINE_ASSET_PATH :: "Animations/VitalsAnimation/002MURD_Heartbeat_Flatline.spine";
VITALS_LOOP_ALIVE_ANIM :: "Loop_Alive";
VITALS_LOOP_DEAD_ANIM :: "Loop_Dead";
VITALS_STATUS_ALIVE_COLOR := v4.{0.30, 0.95, 0.40, 1.0};
VITALS_STATUS_DOWNED_COLOR := v4.{1.0, 0.65, 0.20, 1.0};
VITALS_STATUS_MIA_COLOR := v4.{1.0, 0.45, 0.20, 1.0};
VITALS_STATUS_DEAD_COLOR := v4.{1.0, 0.30, 0.30, 1.0};
VITALS_MAX_ROWS :: 16;

Vitals_UI_Entry :: struct {
    user_id: string;
    vitals_spine: Spine_Instance;
    last_animation: string;
    last_update_frame: u64;
}

Vitals_Row_Handles :: struct {
    avatar: Interact_Result;
    monitor: Interact_Result;
}

HUD_VITALS_LAYER :: 50;
HUD_VITALS_WIDTH :: 300.0;
HUD_VITALS_TOP_MARGIN :: 180.0;
HUD_VITALS_BOTTOM_MARGIN :: 200.0;
HUD_VITALS_RIGHT_MARGIN :: 16.0;
HUD_VITALS_PTT_CLEARANCE :: 60.0;
HUD_VITALS_ROW_HEIGHT :: 78.0;
HUD_VITALS_AVATAR_SIZE :: 56.0;
HUD_VITALS_MONITOR_WIDTH :: 100.0;
HUD_VITALS_MONITOR_HEIGHT :: 50.0;
HUD_VITALS_MONITOR_SPINE_SCALE := v2.{16.5, 16.5};
HUD_VITALS_MONITOR_SPINE_OFFSET := v2.{0.0, -7.0};

get_vitals_spine_asset :: proc() -> Spine_Asset {
    return get_asset(Spine_Asset, VITALS_SPINE_ASSET_PATH);
}

find_vitals_ui_entry :: proc(local_player: Player, user_id: string) -> s64 {
    if local_player == null || user_id == "" {
        return -1;
    }
    for i: 0..local_player.vitals_ui_entries.count - 1 {
        if local_player.vitals_ui_entries[i].user_id == user_id {
            return i;
        }
    }
    return -1;
}

ensure_vitals_ui_entry :: proc(local_player: Player, target_player: Player) -> s64 {
    if local_player == null || target_player == null {
        return -1;
    }
    user_id := target_player.get_user_id();
    if user_id == "" {
        return -1;
    }

    existing := find_vitals_ui_entry(local_player, user_id);
    if existing >= 0 {
        return existing;
    }

    entry: Vitals_UI_Entry;
    entry.user_id = user_id;
    entry.last_animation = "";

    vitals_asset := get_vitals_spine_asset();
    if vitals_asset != null {
        vi := Spine_Instance.create();
        vi.set_skeleton(vitals_asset);
        vi.disable_all_skins();
        vi.enable_skin("default");
        vi.refresh_skins();
        vi.set_animation(VITALS_LOOP_ALIVE_ANIM, true, 0);
        entry.vitals_spine = vi;
        entry.last_animation = VITALS_LOOP_ALIVE_ANIM;
    }

    local_player.vitals_ui_entries.append(entry);
    return local_player.vitals_ui_entries.count - 1;
}

tick_vitals_ui_entry :: proc(entry: ref Vitals_UI_Entry, dt: float) {
    current_frame := get_frame_number();
    if entry.last_update_frame == current_frame {
        return;
    }
    if entry.vitals_spine != null {
        entry.vitals_spine.update(dt);
    }
    entry.last_update_frame = current_frame;
}

sync_vitals_ui_animation :: proc(entry: ref Vitals_UI_Entry, target_player: Player) {
    if entry.vitals_spine == null {
        return;
    }

    desired := VITALS_LOOP_ALIVE_ANIM;
    desired_speed: float = 1.0;
    if target_player != null && target_player.is_round_dead() {
        desired = VITALS_LOOP_DEAD_ANIM;
    } else if target_player != null && target_player.is_round_minion() {
        desired = VITALS_LOOP_DEAD_ANIM;
    } else if target_player != null && target_player.is_round_downed() {
        desired_speed = 0.5;
    }

    if entry.last_animation != desired {
        entry.vitals_spine.set_animation(desired, true, 0);
        entry.last_animation = desired;
    }
    entry.vitals_spine.speed_multiplier = desired_speed;
}

destroy_vitals_ui_entries :: proc(local_player: Player) {
    if local_player == null {
        return;
    }
    for i: 0..local_player.vitals_ui_entries.count - 1 {
        if local_player.vitals_ui_entries[i].vitals_spine != null {
            local_player.vitals_ui_entries[i].vitals_spine.destroy();
            local_player.vitals_ui_entries[i].vitals_spine = null;
        }
    }
    local_player.vitals_ui_entries.clear();
}

draw_vitals_hud_row_uik :: proc(target_player: Player, row_index: s64) -> Vitals_Row_Handles {
    handles: Vitals_Row_Handles;

    row := UIK.layout_row(UIK.flex(1), UIK.pixels(HUD_VITALS_ROW_HEIGHT), 10);
    row.background = .MODAL_TRANSP_BLACK;
    row.padding = v4{8, 10, 8, 10};
    row.cross_align = .CENTER;
    UIK.panel_begin(row);

    avatar_desc: UIK.Panel_Desc;
    avatar_desc.axis = .VERTICAL;
    avatar_desc.width = UIK.pixels(HUD_VITALS_AVATAR_SIZE);
    avatar_desc.height = UIK.pixels(HUD_VITALS_AVATAR_SIZE);
    avatar_desc.cross_align = .CENTER;
    avatar_desc.main_align = .CENTER;
    avatar_desc.show_background = false;
    avatar_desc.clip_children = true;
    handles.avatar = UIK.panel_begin_interactive(format_string("hud_vitals_avatar_%", {row_index}), avatar_desc, true);
    UIK.panel_end();

    name_panel := UIK.layout_column();
    name_panel.width = UIK.flex(1);
    name_panel.height = UIK.fit();
    name_panel.main_align = .CENTER;
    name_panel.cross_align = .CENTER;
    name_panel.gap = 1;
    name_panel.show_background = false;
    UIK.panel_begin(name_panel);

    name_text := UIK.text_body();
    UIK.text_set_word_wrap(&name_text, false);
    UIK.text_set_size_mult(&name_text, 0.85);
    UIK.text(target_player.get_username(), name_text);

    status_label := "ALIVE";
    status_color := VITALS_STATUS_ALIVE_COLOR;
    if target_player.is_round_dead() {
        status_label = "DEAD";
        status_color = VITALS_STATUS_DEAD_COLOR;
    } else if target_player.is_round_minion() {
        status_label = "MIA";
        status_color = VITALS_STATUS_MIA_COLOR;
    } else if target_player.is_round_downed() {
        status_label = "DOWNED";
        status_color = VITALS_STATUS_DOWNED_COLOR;
    }
    status_text := UIK.text_body();
    UIK.text_set_word_wrap(&status_text, false);
    UIK.text_set_size_mult(&status_text, 0.65);
    UIK.text_set_color(&status_text, status_color);
    UIK.text(status_label, status_text);

    UIK.panel_end();

    monitor_desc: UIK.Panel_Desc;
    monitor_desc.axis = .VERTICAL;
    monitor_desc.width = UIK.pixels(HUD_VITALS_MONITOR_WIDTH);
    monitor_desc.height = UIK.pixels(HUD_VITALS_MONITOR_HEIGHT);
    monitor_desc.cross_align = .CENTER;
    monitor_desc.main_align = .CENTER;
    monitor_desc.show_background = false;
    handles.monitor = UIK.panel_begin_interactive(format_string("hud_vitals_monitor_%", {row_index}), monitor_desc, true);
    UIK.panel_end();

    UIK.panel_end();

    return handles;
}

draw_vitals_hud :: proc(player: Player, dt: float) {
    if player == null || !player.is_local_or_server() {
        return;
    }
    if player.is_round_entity() {
        return;
    }

    gm := get_game_manager();
    if !#alive(gm) || (gm.phase != .SURVIVOR_HEAD_START && gm.phase != .ACTIVE) {
        return;
    }

    row_players: [VITALS_MAX_ROWS]Player;
    row_count: s64 = 0;

    for other: component_iterator(Player) {
        if !#alive(other) {
            continue;
        }
        if !gm.is_survivor_player(other) {
            continue;
        }
        if row_count >= VITALS_MAX_ROWS {
            break;
        }
        row_players[row_count] = other;
        row_count += 1;
    }

    if row_count == 0 {
        return;
    }

    screen := UI.get_safe_screen_rect();
    scale := UI.get_current_scale_factor();
    hud_width_px := HUD_VITALS_WIDTH * scale;
    right_margin_px := HUD_VITALS_RIGHT_MARGIN * scale;
    top_margin_px := HUD_VITALS_TOP_MARGIN * scale;
    bottom_margin_px := HUD_VITALS_BOTTOM_MARGIN * scale;

    hud_top_y := screen.max.y - top_margin_px;
    hud_left_x := screen.max.x - hud_width_px - right_margin_px;
    hud_right_x := screen.max.x - right_margin_px;

    if player.is_ptt_button_visible() {
        ptt_rect := player.get_ptt_rect();
        horizontal_overlap := ptt_rect.max.x > hud_left_x && ptt_rect.min.x < hud_right_x;
        if horizontal_overlap {
            max_allowed_top := ptt_rect.min.y - HUD_VITALS_PTT_CLEARANCE * scale;
            if hud_top_y > max_allowed_top {
                hud_top_y = max_allowed_top;
            }
        }
    }

    hud_rect := Rect{
        min = v2{hud_left_x, screen.min.y + bottom_margin_px},
        max = v2{hud_right_x, hud_top_y}
    };

    UIK.begin(UIK.window(hud_rect));

    column := UIK.layout_column();
    column.width = UIK.flex(1);
    column.height = UIK.fit();
    column.main_align = .START;
    column.cross_align = .STRETCH;
    column.gap = 8;
    column.show_background = false;
    UIK.panel_begin(column);

    row_handles: [VITALS_MAX_ROWS]Vitals_Row_Handles;

    for i: 0..row_count - 1 {
        // Never throw inside a UIK begin/end scope: an exception here leaks the
        // open scope and every later UIK.begin panics with UIK_MULTIPLE_BEGINS.
        if !#alive(row_players[i]) {
            continue;
        }
        row_handles[i] = draw_vitals_hud_row_uik(row_players[i], i);
    }

    UIK.panel_end();
    UIK.end();

    UI.push_screen_draw_context();
    UI.push_layer(HUD_VITALS_LAYER);
    for i: 0..row_count - 1 {
        other := row_players[i];
        if !#alive(other) {
            continue;
        }

        entry_index := ensure_vitals_ui_entry(player, other);
        if entry_index < 0 {
            continue;
        }

        sync_vitals_ui_animation(ref player.vitals_ui_entries[entry_index], other);
        tick_vitals_ui_entry(ref player.vitals_ui_entries[entry_index], dt);

        avatar_rect := row_handles[i].avatar.rect;
        monitor_rect := row_handles[i].monitor.rect;

        UI.player_avatar(avatar_rect, other);

        vitals_spine := player.vitals_ui_entries[entry_index].vitals_spine;
        if vitals_spine != null {
            monitor_pos := monitor_rect.center() + HUD_VITALS_MONITOR_SPINE_OFFSET;
            UI.spine(monitor_pos, vitals_spine, HUD_VITALS_MONITOR_SPINE_SCALE, 0.0);
        }
    }
    UI.pop_layer();
    UI.pop_draw_context();
}
