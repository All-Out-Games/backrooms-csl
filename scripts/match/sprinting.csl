import "core:ao"

SPRINT_STAMINA_MAX :: 100.0;
SPRINT_STAMINA_DRAIN_PER_SECOND :: 25.0;
SPRINT_STAMINA_REGEN_PER_SECOND :: 20.0;
SPRINT_STAMINA_MOVING_REGEN_PER_SECOND :: 5.0;
SPRINT_MOVEMENT_MULTIPLIER :: 1.30;
SPRINT_ANIMATION_SPEED_MULTIPLIER :: 1.15;
SPRINT_EXHAUST_LOCKOUT_SECONDS :: 1.0;

sprint_left_keybind: Keybind;
sprint_right_keybind: Keybind;
sprint_bar_back: Texture_Asset;
sprint_bar_fill: Texture_Asset;
sprint_shift_icon: Texture_Asset;

register_sprint_keybinds :: proc() {
    if sprint_left_keybind == 0 {
        sprint_left_keybind = Keybinds.register("Sprint", .LEFT_SHIFT);
    }
    if sprint_right_keybind == 0 {
        sprint_right_keybind = Keybinds.register("Sprint Alt", .RIGHT_SHIFT);
    }
}

ensure_sprint_resources :: proc() {
    register_sprint_keybinds();
    if sprint_bar_back == null {
        sprint_bar_back = get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/hud_elements/health_bar_green/healthbar_back.png");
    }
    if sprint_bar_fill == null {
        sprint_bar_fill = get_asset(Texture_Asset, "reusable_weapons/sprites/reusable-weapons/hud_elements/health_bar_green/healthbar_fill.png");
    }
    if sprint_shift_icon == null {
        sprint_shift_icon = get_asset(Texture_Asset, "shift.png");
    }
}

get_sprint_input_held :: proc(player: Player, params: ref Ability_Update_Params) -> bool {
    ensure_sprint_resources();

    if params.active {
        return true;
    }

    if player != null && player.device_kind == .PC {
        if Keybinds.get_keybind_held(player, sprint_left_keybind) {
            return true;
        }
        if Keybinds.get_keybind_held(player, sprint_right_keybind) {
            return true;
        }
    }

    return false;
}

should_draw_stamina_bar_for_player :: proc(player: Player) -> bool {
    if player == null || player.is_round_dead() || player.is_round_downed() {
        return false;
    }
    if player.is_round_entity() {
        return false;
    }

    local_player := get_local_player();
    if !#alive(local_player) {
        return false;
    }
    if local_player == player {
        return true;
    }

    if player.is_round_minion() {
        return local_player.is_round_entity() || local_player.is_round_minion();
    }
    if player.is_round_survivor() {
        return local_player.is_round_survivor();
    }

    return false;
}

Sprint_Ability :: class : Ability_Base {
    on_init :: method() {
        ensure_sprint_resources();
        name = "Sprint";
        disable_keybind = true;
    }

    can_use :: method() -> bool {
        if player == null || player.agent == null {
            return false;
        }
        return player.current_stamina > 0.0 && player.sprint_lockout_remaining <= 0.0;
    }

    on_update :: method(params: ref Ability_Update_Params) {
        player.sprint_input_held = get_sprint_input_held(player, ref params) && params.can_use;
    }

    on_draw_button :: proc(instance: Sprint_Ability, rect: Rect) {
        if instance.player.device_kind != .PC return;
        if sprint_shift_icon == null return;

        icon_rect := rect.top_left_rect().grow(35).offset(10, -10);
        UI.quad(icon_rect.fit_aspect(sprint_shift_icon.get_aspect(), .KEEP_BIGGER), sprint_shift_icon);
    }
}

draw_stamina_bar :: proc(player: Player) {
    ensure_sprint_resources();

    UI.push_world_draw_context();
    defer UI.pop_draw_context();

    pos := player.entity.world_position;
    UI.push_z(pos.y - 0.0001);
    defer UI.pop_z();

    UI.push_scale_factor(5.0 / 540.0);
    defer UI.pop_scale_factor();

    material_player := player;
    if player.is_round_minion() {
        local_player := get_local_player();
        if #alive(local_player) {
            material_player = local_player;
        }
    }

    UI.push_player_material(material_player);
    defer UI.pop_material();

    stamina_rect := player.username_rect.top_center_rect().offset(0, 5);
    stamina_rect = stamina_rect.grow(13, 70, 0, 70);
    border_rect := stamina_rect.grow(5.5, 4, 5.5, 4).offset(0, -2);

    UI.quad(border_rect, sprint_bar_back, {1, 1, 1, 1});

    stamina_pct := player.current_stamina / player.max_stamina;
    stamina_pct = clamp(stamina_pct, 0.0, 1.0);
    fill_rect := stamina_rect.subrect(0, 0, stamina_pct, 1);
    if player.is_round_minion() {
        UI.quad(fill_rect, core_globals.white_sprite, {1, 1, 1, 1});
    } else {
        UI.quad(fill_rect, sprint_bar_fill, {1, 1, 1, 1});
    }
}
