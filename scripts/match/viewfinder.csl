is_local_viewfinder_active :: proc() -> bool {
    local_player := get_local_player();
    if !#alive(local_player) {
        return false;
    }
    return local_player.viewfinder_active && local_player.equipped_weapon_type == .CAMERA;
}

is_viewfinder_only_group_child :: proc(target: Entity) -> bool {
    if !#alive(target) {
        return false;
    }

    gm := get_game_manager();
    if !#alive(gm) {
        return false;
    }
    group := gm.ViewfinderEntity;
    if !#alive(group) {
        return false;
    }

    return target.get_parent() == group;
}

sync_viewfinder_only_entity_visibility :: proc(target: Entity) {
    if !#alive(target) {
        return;
    }

    should_show := is_local_viewfinder_active();
    if is_viewfinder_only_group_child(target) {
        target.set_local_enabled(true);
        return;
    }

    dropped_item := target.get_component(Dropped_Item);
    if #alive(dropped_item) && #alive(dropped_item.visual_root) {
        dropped_item.visual_root.set_local_enabled(should_show);
        return;
    }

    target.set_local_enabled(should_show);
}

ViewfinderOnly :: class : Component {
    ao_start :: method() {
        sync_visibility();
    }

    ao_on_state_sync :: method() {
        sync_visibility();
    }

    sync_visibility :: method() {
        sync_viewfinder_only_entity_visibility(entity);
    }
}

sync_all_viewfinder_only_visibility :: proc() {
    gm := get_game_manager();
    if #alive(gm) {
        gm.sync_viewfinder_only_group_visibility();
    }

    for viewfinder_only: component_iterator(ViewfinderOnly) {
        if !#alive(viewfinder_only) {
            continue;
        }
        viewfinder_only.sync_visibility();
    }
}

Viewfinder_Ability :: class : Ability_Base {
    on_init :: method() {
        name = "Viewfinder";
        icon = get_asset(Texture_Asset, "camera_grip.png");
    }

    can_use :: method() -> bool {
        p := player.(Player);
        if p == null {
            return false;
        }
        return p.equipped_weapon_type == .CAMERA;
    }

    on_update :: method(params: ref Ability_Update_Params) {
        if !params.clicked || !params.can_use {
            return;
        }

        p := player.(Player);
        if p == null {
            return;
        }
        p.viewfinder_active = !p.viewfinder_active;
        sync_all_viewfinder_only_visibility();
    }

    on_draw_button :: proc(instance: Viewfinder_Ability, rect: Rect) {
        draw_ability_name_label(rect, "View");
    }
}
