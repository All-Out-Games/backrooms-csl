import "core:ao"

// --- Match layout: 1 Entity vs 4–6 Survivors (5–7 players total) ---

HEAD_START_SECONDS :: 10.0;
ROLE_SELECTION_SECONDS :: 3.5;
INTRO_SPAWN_FADE_TO_BLACK_LEAD_SECONDS :: 1.85;
INTRO_SPAWN_FADE_TO_BLACK_SECONDS :: 0.75;
INTRO_SPAWN_BLACK_HOLD_SECONDS :: 1;
INTRO_SPAWN_FADE_FROM_BLACK_SECONDS :: 0.45;
MATCH_MAX_SECONDS :: 1200.0; // ~8 minutes after survivors' head start ends
ENTITY_SCREAM_UNLOCK_DELAY_SECONDS :: 120.0;
ENTITY_NEXT_ZONE_UNLOCKED_ABILITY_COUNT :: 4;
ENTITY_FINAL_ZONE_UNLOCKED_ABILITY_COUNT :: 5;
ENTITY_ABILITY_UNLOCK_NOTIFICATION :: "The Monster grows stronger...";
ENTITY_LOCKED_ABILITY_ICON_PATH :: "lock_0572b2.png";
HUNT_BEGIN_BANNER_SECONDS :: 4.0;
GAME_START_VIGNETTE_PATH :: "UI/gamestart.png";
GAME_START_VIGNETTE_LAYER :: 9850;
EXIT_UNLOCK_BANNER_SECONDS :: 2.0;
LAST_SURVIVOR_ENTITY_WIN_DELAY_SECONDS :: 5.0;
ENDED_TO_LOBBY_SECONDS :: 10.0;
END_GAME_CUTSCENE_SECONDS :: 5.0;
END_GAME_CUTSCENE_RADIUS :: 2.8;
END_GAME_CUTSCENE_CAMERA_SIZE :: 6.5;
END_GAME_CUTSCENE_REASON :: "end_game_cutscene";
GAMES_PLAYED_SAVE_KEY :: "GamesPlayed";
SURVIVOR_WINS_SAVE_KEY :: "SurvivorWins";
MONSTER_WINS_SAVE_KEY :: "MonsterWins";

MIN_TOTAL_PLAYERS :: 5; // 1 entity + 4 survivors
MAX_TOTAL_PLAYERS :: 7; // 1 entity + 6 survivors
MATCHMAKING_PRIORITY_BETWEEN_ROUNDS :: 0;
MATCHMAKING_PRIORITY_IN_ROUND :: 1;

LOBBY_COUNTDOWN_SECONDS :: 10.0;
ENTITY_SCREAM_ARROW_MIN_DISTANCE :: 20.0;
ENTITY_SCREAM_PATH_LINE_THICKNESS :: 5.0;
ENTITY_SCREAM_PATH_LINE_ALPHA :: 0.86;

// Matchmaking queue name for players who prefer Entity (Server.queue_add_player)
ENTITY_QUEUE_NAME :: "entity";

FREEZE_ENTITY_HEAD_START :: "game_manager_entity_head_start";
FREEZE_INTRO_POPUP :: "game_manager_intro_popup";
ENTITY_HEARING_VISUAL_BUFFER :: 2.0;
ENTITY_HEARING_VISUAL_MAX_ALPHA :: 245.0 / 255.0;
ENTITY_HEARING_VISUAL_FADE_SPEED :: 6.0;
SURVIVOR_SPAWN_RADIUS :: 1.5;
ROUND_ITEM_DESPAWN_TOTAL_SECONDS :: 9999.0;
ROUND_ITEM_ENGINE_DESPAWN_WINDOW_SECONDS :: 40.0; // Dropped_Item warns for 30s and expires over the next 10s.
ROUND_START_FLASHBANG_ITEM_ID :: "flashbang";
SURVIVOR_ESCAPE_ENABLED :: true;
TASK_ZONE_RANDOM_RADIUS :: 7.0;
TASK_ZONE_ARROW_HIDE_DISTANCE :: 20.0;
WORKBENCH_ARROW_ICON_PATH :: "UI/Arrow.png";
RECONNECT_WIRES_ARROW_ICON_PATH :: "UI/WiresArrow.png";
LIGHTS_OUT_SABOTAGE_COOLDOWN_SECONDS :: 120.0;
SABOTAGE_START_COOLDOWN_FRACTION :: 0.5;

Match_Phase :: enum {
    LOBBY;
    SURVIVOR_HEAD_START;
    ACTIVE;
    ENDED;
}

Match_Result :: enum {
    NONE;
    SURVIVORS_WIN;
    ENTITY_WIN;
}

// Set by Game_Manager.ao_start; use get_game_manager() / #alive before use.
game_manager_singleton: Game_Manager;

get_game_manager :: proc() -> Game_Manager {
    return game_manager_singleton;
}

set_matchmaking_priority_for_phase :: proc(phase: Match_Phase) {
    priority := MATCHMAKING_PRIORITY_BETWEEN_ROUNDS;
    if phase == .SURVIVOR_HEAD_START || phase == .ACTIVE {
        priority = MATCHMAKING_PRIORITY_IN_ROUND;
    }
    Server.set_matchmaking_priority(priority);
}

// Prefer this when integrating matchmaking UI (lobby queue for Entity role).
queue_for_entity_matchmaking :: proc(player: Player) {
    Server.queue_add_player(ENTITY_QUEUE_NAME, player);
}

remove_from_entity_matchmaking_queue :: proc(player: Player) {
    Server.queue_remove_player(ENTITY_QUEUE_NAME, player);
}

notify_all_players :: proc(fmt: string, args: [^]any = {}) {
    for player: component_iterator(Player) {
        Notifier.notify(player, fmt, args);
    }
}

collect_players :: proc(out_players: ref [..]Player) {
    out_players.clear();
    for p: component_iterator(Player) {
        out_players.append(p);
    }
}

reset_all_entity_opt_ins :: proc() {
    for p: component_iterator(Player) {
        p.entity_opt_in = false;
    }
}

find_scene_navmesh :: proc() -> Navmesh {
    navmesh_entity := Scene.get_entity_by_name("NavMesh");
    if !#alive(navmesh_entity) {
        return null;
    }
    return navmesh_entity.get_component(Navmesh);
}

find_player_by_user_id :: proc(user_id: string) -> Player, bool {
    for p: component_iterator(Player) {
        if p.get_user_id() == user_id {
            return p, true;
        }
    }
    return null, false;
}

put_entity_abilities_on_standard_cooldown :: proc(player: Player) {
    if player == null {
        return;
    }

    for ability: player.abilities {
        if ability.#type == Entity_Bite_Ability {
            ability.current_cooldown = ENTITY_BITE_COOLDOWN_SECONDS;
        } else if ability.#type == Entity_Scream_Ability {
            ability.current_cooldown = ENTITY_SCREAM_COOLDOWN_SECONDS;
        } else if ability.#type == Entity_Lurch_Ability {
            ability.current_cooldown = ENTITY_LURCH_COOLDOWN_SECONDS;
        } else if ability.#type == Entity_Vomit_Ability {
            ability.current_cooldown = ENTITY_VOMIT_COOLDOWN_SECONDS;
        } else if ability.#type == Entity_Convert_Minion_Ability {
            ability.current_cooldown = ENTITY_CONVERT_MINION_COOLDOWN_SECONDS;
        } else if ability.#type == Entity_Wall_Seep_Ability {
            ability.current_cooldown = ENTITY_WALL_SEEP_COOLDOWN_SECONDS;
        }
    }

    if player.active_ability != null {
        player.active_ability = null;
    }
}

get_entity_ability_unlock_step :: proc(ability: Ability_Base) -> s64 {
    if ability == null {
        return 0;
    }
    if ability.#type == Entity_Bite_Ability {
        return 1;
    }
    if ability.#type == Entity_Scream_Ability {
        return 2;
    }
    if ability.#type == Entity_Vomit_Ability {
        return 3;
    }
    if ability.#type == Entity_Lurch_Ability {
        return 4;
    }
    if ability.#type == Entity_Convert_Minion_Ability {
        return 4;
    }
    if ability.#type == Entity_Wall_Seep_Ability {
        return 5;
    }
    return 0;
}

is_entity_ability_unlocked :: proc(ability: Ability_Base) -> bool {
    step := get_entity_ability_unlock_step(ability);
    if step <= 0 {
        return true;
    }

    gm := get_game_manager();
    if !#alive(gm) {
        return false;
    }
    if ability.#type == Entity_Wall_Seep_Ability && gm.phase == .ACTIVE && are_all_surviving_survivors_at_or_past_zone3() {
        return true;
    }
    return gm.unlocked_entity_ability_count >= step;
}

clear_player_ability_cooldowns :: proc(player: Player) {
    if player == null {
        return;
    }

    for ability: player.abilities {
        ability.current_cooldown = 0.0;
    }

    if player.active_ability != null {
        player.active_ability = null;
    }
}

clear_player_all_cooldowns :: proc(player: Player) {
    if player == null {
        return;
    }

    clear_player_ability_cooldowns(player);
    player.vent_cooldown_ends_at = 0.0;
    player.jumpscare_cooldown_ends_at = 0.0;
    player.toxic_rain_cooldown_ends_at = 0.0;
    player.ghost_item_ping_cooldown_ends_at = 0.0;
    player.stop_toxic_rain_targeting();
}

cooldown :: proc(player: Player, target: Player = null) {
    gm := get_game_manager();
    if #alive(gm) {
        gm.lights_out_cooldown_ends_at = 0.0;
    }

    if target != null {
        clear_player_all_cooldowns(target);
        Notifier.notify(player, "Cleared cooldowns for %.", {target.get_username()});
        if target != player {
            Notifier.notify(target, "Your cooldowns were cleared.");
        }
        return;
    }

    cleared_count := 0;
    for p: component_iterator(Player) {
        clear_player_all_cooldowns(p);
        cleared_count += 1;
    }

    Notifier.notify(player, "Cleared cooldowns for % players.", {cleared_count});
} @chat_command @youtuber

unlock :: proc(player: Player) {
    gm := get_game_manager();
    if !#alive(gm) {
        Notifier.notify(player, "No match manager found.");
        return;
    }

    entity_player := player;
    if !#alive(entity_player) || !entity_player.is_round_entity() {
        entity_player = null;
        if gm.entity_user_id.count > 0 {
            found_player, found := find_player_by_user_id(gm.entity_user_id);
            if found && found_player.is_round_entity() {
                entity_player = found_player;
            }
        }
    }

    if !#alive(entity_player) {
        Notifier.notify(player, "No Entity player found.");
        return;
    }

    gm.unlocked_entity_ability_count = 5;
    gm.next_entity_ability_unlock_at = 0.0;
    gm.entity_next_zone_progression_unlocked = true;
    gm.entity_jumpscare_sabotage_unlocked = true;
    gm.lights_out_cooldown_ends_at = 0.0;

    entity_player.jumpscare_cooldown_ends_at = 0.0;
    entity_player.toxic_rain_cooldown_ends_at = 0.0;
    entity_player.stop_toxic_rain_targeting();
    clear_player_ability_cooldowns(entity_player);

    Notifier.notify(player, "Entity abilities unlocked and cooldowns cleared.");
} @chat_command @youtuber

count_players :: proc() -> s64 {
    n: s64 = 0;
    for p: component_iterator(Player) {
        n += 1;
    }
    return n;
}

lock_player_to_game_navmesh :: proc(player: Player) {
    gm := get_game_manager();
    if !#alive(gm) {
        return;
    }
    gm.lock_player_to_navmesh(player);
}

// UIK must be drawn from Player.ao_late_update (see UIK skill).
draw_match_lobby_ui :: proc(player: Player) {
    gm := get_game_manager();
    if !#alive(gm) {
        return;
    }
    if gm.phase != .LOBBY {
        return;
    }

    n := count_players();

    UIK.begin(UIK.window(UIK.rect_topbar()));

    shell := UIK.panel_modal(.TRANSP_BLACK);
    shell.cross_align = .CENTER;
    shell.main_align = .CENTER;
    shell.gap = 8;
    shell.padding = v4{16, 14, 16, 14};
    UIK.panel_begin(shell);

    UIK.text("Waiting for Players", UIK.text_title());
    min_req: s64 = MIN_TOTAL_PLAYERS.(s64);
    count_line := format_string("%/%", {n, min_req});
    UIK.text(count_line, UIK.text_body());

    if gm.lobby_countdown_ends_at > 0.0 && n >= MIN_TOTAL_PLAYERS && n <= MAX_TOTAL_PLAYERS {
        rem := gm.lobby_countdown_ends_at - get_time();
        if rem < 0.0 {
            rem = 0.0;
        }
        secs := (rem + 0.999).(s64);
        one: s64 = 1;
        if secs < one && rem > 0.0 {
            secs = one;
        }
        countdown_line := format_string("Game Starts in %", {secs});
        UIK.text(countdown_line, UIK.text_title());
    }

    UIK.panel_end();
    UIK.end();
}

format_countdown_mm_ss :: proc(total_seconds: s64) -> string {
    minutes := total_seconds / 60;
    seconds := total_seconds % 60;

    minutes_text := format_string("%", {minutes});
    if minutes < 10 {
        minutes_text = format_string("0%", {minutes});
    }

    seconds_text := format_string("%", {seconds});
    if seconds < 10 {
        seconds_text = format_string("0%", {seconds});
    }

    return format_string("%:%", {minutes_text, seconds_text});
}

MATCH_TIMER_TOP_DOWN_OFFSET :: 90.0;
INTRO_SPAWN_TRANSITION_UI_LAYER :: 10000;

draw_match_status_ui :: proc(title: string, value: string) {
    UIK.begin(UIK.window(UIK.rect_topbar().offset(0.0, -MATCH_TIMER_TOP_DOWN_OFFSET)));

    shell := UIK.panel_modal(.TRANSP_BLACK);
    shell.cross_align = .CENTER;
    shell.main_align = .CENTER;
    shell.gap = 4;
    shell.padding = v4{16, 12, 16, 12};
    shell.show_background = false;
    UIK.panel_begin(shell);

    UIK.text(title, UIK.text_title());
    UIK.text(value, UIK.text_title());

    UIK.panel_end();
    UIK.end();
}

get_head_start_countdown_seconds :: proc(gm: Game_Manager) -> s64 {
    if !#alive(gm) {
        return 0;
    }

    rem := gm.head_start_ends_at - get_time();
    if rem <= 0.0 {
        return 0;
    }

    secs := (rem + 0.999).(s64);
    one: s64 = 1;
    if secs < one {
        secs = one;
    }
    return secs;
}

get_match_countdown_seconds :: proc(gm: Game_Manager) -> s64 {
    if !#alive(gm) {
        return 0;
    }

    rem := gm.match_ends_at - get_time();
    if gm.round_timer_paused {
        rem = gm.round_timer_paused_remaining_seconds;
    }
    if rem <= 0.0 {
        return 0;
    }

    secs := (rem + 0.999).(s64);
    one: s64 = 1;
    if secs < one {
        secs = one;
    }
    return secs;
}

get_round_tapes_found_count :: proc(gm: Game_Manager) -> s64 {
    if !#alive(gm) {
        return 0;
    }

    found: s64 = 0;
    for i: 0..TASK_TAPE_COUNT - 1 {
        if gm.round_tapes_collected[i] {
            found += 1;
        }
    }
    return found;
}

get_round_tapes_found_count_for_zone :: proc(gm: Game_Manager, zone: CurrentZone) -> s64 {
    if !#alive(gm) {
        return 0;
    }

    found: s64 = 0;
    for i: 0..TASK_TAPE_COUNT - 1 {
        if gm.round_tape_zones[i] == zone && gm.round_tapes_collected[i] {
            found += 1;
        }
    }
    return found;
}

get_round_tape_count_for_zone :: proc(gm: Game_Manager, zone: CurrentZone) -> s64 {
    if !#alive(gm) {
        return 0;
    }

    count: s64 = 0;
    for i: 0..TASK_TAPE_COUNT - 1 {
        if gm.round_tape_zones[i] == zone {
            count += 1;
        }
    }
    return count;
}

get_end_countdown_seconds :: proc(gm: Game_Manager) -> s64 {
    if !#alive(gm) {
        return 0;
    }

    rem := (gm.ended_at + ENDED_TO_LOBBY_SECONDS) - get_time();
    if rem <= 0.0 {
        return 0;
    }

    secs := (rem + 0.999).(s64);
    one: s64 = 1;
    if secs < one {
        secs = one;
    }
    return secs;
}

draw_entity_scream_arrow_ui :: proc(player: Player) {
    if !player.is_local() || !player.is_round_entity() {
        return;
    }
    if player.entity_scream_arrow_remaining <= 0.0 {
        return;
    }
    if player.entity_scream_arrow_zone != .None && player.current_zone != player.entity_scream_arrow_zone {
        return;
    }

    for target_user_id: player.entity_scream_arrow_target_user_ids {
        other, found := find_player_by_user_id(target_user_id);
        if !found || other == player continue;
        if !other.is_round_survivor() continue;
        if !#alive(other.entity) continue;
        if player.entity_scream_arrow_zone != .None && other.current_zone != player.entity_scream_arrow_zone continue;

        to_survivor := other.entity.world_position - player.entity.world_position;
        distance := length(to_survivor);
        if distance <= ENTITY_SCREAM_ARROW_MIN_DISTANCE {
            continue;
        }

        distance_units := (distance + 0.5).(s64);
        player.DrawArrowToPosition(other.entity.world_position, "UI/schleem_hologram.png", format_string("%m", {distance_units}), true);
    }
}

draw_entity_target_ping_arrow_ui :: proc(player: Player) {
    if !player.is_local() || !player.is_round_entity() {
        return;
    }
    if player.entity_target_ping_remaining <= 0.0 || player.entity_target_ping_user_id.count <= 0 {
        return;
    }

    target, found := find_player_by_user_id(player.entity_target_ping_user_id);
    if !found || target == player || !#alive(target.entity) || !target.is_round_survivor() {
        return;
    }
    if player.entity_target_ping_requires_same_zone {
        zone := player.entity_target_ping_source_zone;
        if zone == .None || player.current_zone != zone || target.current_zone != zone {
            return;
        }
    }

    to_survivor := target.entity.world_position - player.entity.world_position;
    distance := length(to_survivor);
    if distance <= ENTITY_SCREAM_ARROW_MIN_DISTANCE {
        return;
    }

    distance_units := (distance + 0.5).(s64);
    player.DrawArrowToPosition(target.entity.world_position, "UI/schleem_hologram.png", format_string("%m", {distance_units}), true);
}

find_workbench_entity :: proc() -> Entity {
    for workshop: component_iterator(Workshop) {
        if #alive(workshop.entity) {
            return workshop.entity;
        }
    }

    return Scene.get_entity_by_name("Workbench");
}

draw_broken_camera_workbench_arrow_ui :: proc(player: Player) {
    if player == null || !player.is_local() || !player.is_round_survivor() {
        return;
    }
    if player.is_round_dead() || player.is_round_downed() {
        return;
    }
    if !player_inventory_has_item_id(player, BROKEN_CAMERA_ITEM_ID) {
        return;
    }

    gm := get_game_manager();
    if !#alive(gm) || !gm.is_round_in_progress() {
        return;
    }

    workbench := find_workbench_entity();
    if !#alive(workbench) {
        return;
    }

    player.DrawArrowToPosition(workbench.world_position, WORKBENCH_ARROW_ICON_PATH);
}

draw_reconnect_wires_task_arrow_ui :: proc(player: Player) {
    if player == null || !player.is_local() || !player.is_round_survivor() {
        return;
    }
    if player.is_round_dead() || player.is_round_downed() {
        return;
    }

    current_task := find_current_assigned_task_cheat(player);
    if current_task == null || current_task.id != TASK_ID_RECONNECT_WIRE {
        return;
    }

    gm := get_game_manager();
    if !#alive(gm) || !gm.is_round_in_progress() {
        return;
    }
    if gm.lights_out_active {
        return;
    }

    wires_entity := gm.get_reconnect_wires_entity();
    if !#alive(wires_entity) {
        return;
    }

    player.DrawArrowToPosition(wires_entity.world_position, RECONNECT_WIRES_ARROW_ICON_PATH);
}

draw_entity_scream_nav_path_segment :: proc(a: v2, b: v2, alpha: float) {
    sa := world_to_screen(a);
    sb := world_to_screen(b);
    UI.line(sa, sb, ENTITY_SCREAM_PATH_LINE_THICKNESS, core_globals.white_sprite, v4{0.15, 0.9, 1.0, alpha}, true);
    UI.line(sa, sb, ENTITY_SCREAM_PATH_LINE_THICKNESS * 0.35, core_globals.white_sprite, v4{1.0, 1.0, 1.0, alpha}, true);
}

draw_entity_scream_nav_paths_ui :: proc(player: Player) {
    if !player.is_local() || !player.is_round_entity() {
        return;
    }

    now := get_time();
    UI.push_screen_draw_context();
    defer UI.pop_draw_context();

    UI.push_layer(850);
    defer UI.pop_layer();

    for probe: component_iterator(Entity_Scream_Nav_Path_Probe) {
        if probe.owner_user_id != player.get_user_id() {
            continue;
        }
        if now >= probe.expires_at {
            continue;
        }
        if probe.require_same_zone {
            zone := probe.source_zone;
            if zone == .None || player.current_zone != zone {
                continue;
            }

            target, found := find_player_by_user_id(probe.target_user_id);
            if !found || !#alive(target.entity) || target.current_zone != zone {
                continue;
            }
        }
        if probe.points.count < 2 {
            continue;
        }

        alpha := ENTITY_SCREAM_PATH_LINE_ALPHA;
        remaining := probe.expires_at - now;
        if remaining < 0.45 {
            alpha *= clamp(remaining / 0.45, 0.0, 1.0);
        }

        i: s64 = 0;
        while i < probe.points.count - 1 {
            draw_entity_scream_nav_path_segment(probe.points[i], probe.points[i + 1], alpha);
            i += 1;
        }
    }
}

draw_head_start_ui :: proc(player: Player) {
    gm := get_game_manager();
    if !#alive(gm) {
        return;
    }
    if gm.phase != .SURVIVOR_HEAD_START {
        return;
    }

    countdown := get_head_start_countdown_seconds(gm);
    if countdown <= 0 {
        return;
    }

    title := "Headstart For";
    if gm.is_entity_player(player) {
        title = "Hunt In";
    }

    draw_match_status_ui(title, format_string("%", {countdown}));

    if gm.is_entity_player(player) && player.is_local() {
        UI.push_screen_draw_context();
        defer UI.pop_draw_context();

        box := UI.get_safe_screen_rect().center_rect().grow(50.0, 420.0, 50.0, 420.0).offset(0.0, 80.0);
        ts := UI.default_text_settings();
        ts.size = 34;
        ts.color = v4{1.0, 1.0, 1.0, 1.0};
        ts.halign = .CENTER;
        ts.valign = .CENTER;
        ts.do_outline = true;
        ts.outline_thickness = 2;
        ts.outline_color = v4{0.0, 0.0, 0.0, 1.0};
        UI.text(box, ts, "Survivors Scattering...");
    }
}

draw_intro_spawn_transition_ui :: proc(player: Player) {
    gm := get_game_manager();
    if !#alive(gm) || player == null || !player.is_local() {
        return;
    }
    if gm.phase != .SURVIVOR_HEAD_START || gm.role_selection_ends_at <= 0.0 {
        return;
    }

    now := get_time();
    fade_to_black_starts_at := gm.get_intro_spawn_fade_to_black_starts_at();
    fade_to_black_ends_at := gm.get_intro_spawn_fade_to_black_ends_at();
    teleport_at := gm.get_intro_spawn_teleport_at();
    transition_ends_at := gm.get_intro_spawn_transition_ends_at();

    if now < fade_to_black_starts_at || now >= transition_ends_at {
        return;
    }

    alpha := 1.0;
    if now < fade_to_black_ends_at {
        alpha = clamp((now - fade_to_black_starts_at) / INTRO_SPAWN_FADE_TO_BLACK_SECONDS, 0.0, 1.0);
    } else if now >= teleport_at {
        alpha = 1.0 - clamp((now - teleport_at) / INTRO_SPAWN_FADE_FROM_BLACK_SECONDS, 0.0, 1.0);
    }

    if alpha <= 0.0 {
        return;
    }

    UI.push_screen_draw_context();
    defer UI.pop_draw_context();
    UI.push_layer(INTRO_SPAWN_TRANSITION_UI_LAYER);
    defer UI.pop_layer();

    UI.quad(UI.get_screen_rect(), core_globals.white_sprite, v4{0.0, 0.0, 0.0, alpha});
}

draw_match_timer_ui :: proc(player: Player) {
    gm := get_game_manager();
    if !#alive(gm) {
        return;
    }
    if gm.phase != .ACTIVE {
        return;
    }

    countdown := get_match_countdown_seconds(gm);
    if countdown <= 0 {
        return;
    }

    UIK.begin(UIK.window(UIK.rect_topbar().offset(0.0, -MATCH_TIMER_TOP_DOWN_OFFSET)));

    shell := UIK.panel_modal(.TRANSP_BLACK);
    shell.cross_align = .CENTER;
    shell.main_align = .CENTER;
    shell.gap = 4;
    shell.padding = v4{16, 12, 16, 12};
    shell.show_background = false;
    UIK.panel_begin(shell);

    time_remaining_text := UIK.text_title();
    UIK.text_set_word_wrap(&time_remaining_text, false);
    UIK.text_set_color(&time_remaining_text, v4{1.0, 0.95, 0.60, 1.0});
    UIK.text("Time Remaining", time_remaining_text);
    UIK.text(format_countdown_mm_ss(countdown), UIK.text_title());
    if gm.round_timer_paused {
        UIK.text("Paused", UIK.text_body());
    }
    if player.is_round_survivor() {
        tape_goal_count := get_round_tape_count_for_zone(gm, player.current_zone);
        if tape_goal_count > 0 {
            tapes_found := get_round_tapes_found_count_for_zone(gm, player.current_zone);
            UIK.text(format_string("Tapes Found %/%", {tapes_found, tape_goal_count}), UIK.text_body());
        }
    }

    if player.is_local() && !player.is_round_entity() && player.entity_scream_reveal_remaining > 0.0 {
        UIK.spacer(UIK.pixels(1), UIK.pixels(10));
        remaining_text := format_string("Revealed: %", {format_float(player.entity_scream_reveal_remaining, decimals=1)});
        UIK.text(remaining_text, UIK.text_title());
    }

    UIK.panel_end();
    UIK.end();
    draw_entity_scream_nav_paths_ui(player);
    draw_ghost_item_ping_nav_paths_ui(player);
    draw_danger_ping_nav_paths_ui(player);
    draw_danger_ping_arrows_ui(player);
    draw_entity_scream_arrow_ui(player);
    draw_entity_target_ping_arrow_ui(player);
}

draw_game_start_vignette_ui :: proc(player: Player) {
    gm := get_game_manager();
    if !#alive(gm) {
        return;
    }
    if gm.phase != .SURVIVOR_HEAD_START {
        return;
    }
    if gm.role_selection_started_at <= 0.0 || gm.role_selection_ends_at <= 0.0 {
        return;
    }

    duration := gm.role_selection_ends_at - gm.role_selection_started_at;
    if duration <= 0.0 {
        return;
    }

    elapsed := get_time() - gm.role_selection_started_at;
    if elapsed < 0.0 || elapsed >= duration {
        return;
    }

    tex := get_asset(Texture_Asset, GAME_START_VIGNETTE_PATH);
    if tex == null {
        return;
    }

    t := clamp(elapsed / duration, 0.0, 1.0);
    alpha := sin(t * PI);

    UI.push_screen_draw_context();
    defer UI.pop_draw_context();
    UI.push_layer(GAME_START_VIGNETTE_LAYER);
    defer UI.pop_layer();

    screen := UI.get_screen_rect();
    UI.quad(screen, tex, v4{1.0, 1.0, 1.0, alpha});
}

draw_hunt_begin_banner_ui :: proc(player: Player) {
    gm := get_game_manager();
    if !#alive(gm) {
        return;
    }
    if gm.phase != .ACTIVE {
        return;
    }
    if gm.hunt_started_at <= 0.0 {
        return;
    }

    elapsed := get_time() - gm.hunt_started_at;
    if elapsed < 0.0 || elapsed >= HUNT_BEGIN_BANNER_SECONDS {
        return;
    }

    t := clamp(elapsed / HUNT_BEGIN_BANNER_SECONDS, 0.0, 1.0);
    fade_t := clamp((t - 0.7) / 0.3, 0.0, 1.0);
    alpha := lerp(1.0, 0.0, pow(fade_t, 2.0));
    slide_y := lerp(0.0, 24.0, fade_t);

    text := "Find the Beck Tapes!";
    show_icon := true;
    if gm.is_entity_player(player) {
        text = "The Hunt Begins!";
        show_icon = false;
    }

    box := UI.get_safe_screen_rect().center_rect().grow(70.0, 360.0, 70.0, 360.0).offset(0.0, slide_y);

    begin_desc: UIK.Begin_Desc;
    begin_desc.rect = box;
    begin_desc.layer = 0;
    begin_desc.backdrop = false;
    begin_desc.blocks_input = false;
    UIK.begin(begin_desc);

    shell := UIK.panel_styled(.MODAL_TRANSP_BLACK);
    shell.axis = .HORIZONTAL;
    shell.width = UIK.flex(1);
    shell.height = UIK.flex(1);
    shell.cross_align = .CENTER;
    shell.main_align = .CENTER;
    shell.gap = 18;
    shell.padding = v4{10, 24, 10, 24};
    shell.opacity = alpha;
    UIK.panel_begin(shell);

    if show_icon {
        tape_tex := get_asset(Texture_Asset, "tapes/vhs_yellow.png");
        if tape_tex != null {
            icon_panel := UIK.layout_column();
            icon_panel.width = UIK.pixels(80);
            icon_panel.height = UIK.pixels(80);
            icon_panel.cross_align = .CENTER;
            icon_panel.main_align = .CENTER;
            icon_panel.show_background = false;
            UIK.panel_begin(icon_panel);
            UIK.image_fitted(tape_tex, UIK.image_desc(.CONTAIN));
            UIK.panel_end();
        }
    }

    text_desc := UIK.text_title();
    UIK.text_set_word_wrap(&text_desc, false);
    UIK.text(text, text_desc);

    UIK.panel_end();
    UIK.end();
}

draw_exit_unlocked_banner_ui :: proc(player: Player) {
    gm := get_game_manager();
    if !#alive(gm) {
        return;
    }
    if gm.phase != .ACTIVE {
        return;
    }
    if !player.is_round_survivor() || player.is_round_entity() {
        return;
    }
    if gm.exit_unlocked_at <= 0.0 {
        return;
    }

    elapsed := get_time() - gm.exit_unlocked_at;
    if elapsed < 0.0 || elapsed >= EXIT_UNLOCK_BANNER_SECONDS {
        return;
    }

    t := clamp(elapsed / EXIT_UNLOCK_BANNER_SECONDS, 0.0, 1.0);
    fade_t := pow(t, 2.0);
    alpha := lerp(1.0, 0.0, fade_t);
    slide_y := lerp(0.0, 24.0, t);

    UI.push_screen_draw_context();
    defer UI.pop_draw_context();

    bg := get_asset(Texture_Asset, "$AO/white.png");
    box := UI.get_safe_screen_rect().center_rect().grow(70.0, 360.0, 70.0, 360.0).offset(0.0, slide_y);
    glow := box.grow(8, 8, 8, 8);

    UI.quad(glow, bg, v4{0.08, 0.08, 0.08, alpha * 0.22});
    UI.quad(box, bg, v4{0.0, 0.0, 0.0, alpha * 0.82});

    ts := UI.default_text_settings();
    ts.size = 42;
    ts.color = v4{1.0, 1.0, 1.0, alpha};
    ts.halign = .CENTER;
    ts.valign = .CENTER;
    ts.do_outline = true;
    ts.outline_thickness = 2;
    ts.outline_color = v4{0.0, 0.0, 0.0, alpha};
    UI.text(box, ts, "Exit Unlocked! Escape!");
}

draw_match_end_ui :: proc(player: Player) {
    gm := get_game_manager();
    if !#alive(gm) {
        return;
    }
    if gm.phase != .ENDED {
        return;
    }

    countdown := get_end_countdown_seconds(gm);
    result_text := "Round Over";
    switch gm.result {
        case .SURVIVORS_WIN: result_text = "Survivors Win";
        case .ENTITY_WIN:    result_text = "Entity Wins";
        default: {}
    }

    UIK.begin(UIK.window(UIK.rect_topbar()));

    shell := UIK.panel_modal(.TRANSP_BLACK);
    shell.cross_align = .CENTER;
    shell.main_align = .CENTER;
    shell.gap = 4;
    shell.padding = v4{16, 12, 16, 12};
    UIK.panel_begin(shell);

    UIK.text(result_text, UIK.text_title());
    if countdown > 0 {
        UIK.text(format_string("Returning to Lobby in %", {countdown}), UIK.text_body());
    }

    UIK.panel_end();
    UIK.end();
}

Game_Manager :: class : Component {
    phase: Match_Phase;
    result: Match_Result;
    navmesh_to_lock_to: Navmesh @ao_serialize;
    hearing_radius_entity: Entity @ao_serialize;
    GeneratorEntity: Entity @ao_serialize;
    ReconnectWiresEntity: Entity @ao_serialize;
    BlastDoor: Entity @ao_serialize;
    TaskZoneEntity: Entity @ao_serialize;
    RadioPuzzle: Entity @ao_serialize;
    LobbySpawn: Entity @ao_serialize;
    SurvivorSpawn: Entity @ao_serialize;
    ReconnectWiresSpawns: Entity @ao_serialize;
    RadioSpawns: Entity @ao_serialize;
    EntitySpawns: Entity @ao_serialize;
    BrokenCameraSpawns: Entity @ao_serialize;
    VhsTapeSpawns: Entity @ao_serialize;
    ItemSpawns: Entity @ao_serialize;
    AsyncSpawns: Entity @ao_serialize;
    EndOfGameWarp: Entity @ao_serialize;
    VO: Entity @ao_serialize;
    Shadows: Entity @ao_serialize;
    dimensionalRift: Entity @ao_serialize;
    RoundItemIds: [..]string @ao_serialize;
    RoundItemWeights: [..]s64 @ao_serialize;
    MinRoundItemSpawnCount: s64 @ao_serialize;
    MaxRoundItemSpawnCount: s64 @ao_serialize;
    AsyncSpawnCount: s64 @ao_serialize;

    // Authoritative identity for the Entity this round (synced with gameplay state).
    entity_user_id: string;

    survivors_alive: int;
    emergency_systems_online: bool;

    head_start_ends_at: float;
    role_selection_started_at: float;
    role_selection_ends_at: float;
    hunt_started_at: float;
    next_entity_ability_unlock_at: float;
    unlocked_entity_ability_count: s64;
    exit_unlocked_at: float;
    match_ends_at: float;
    round_timer_paused: bool;
    round_timer_paused_remaining_seconds: float;
    round_timer_pause_started_at: float;
    entity_win_delay_ends_at: float;
    ended_at: float;
    end_game_cutscene_ends_at: float;

    // LOBBY: 0 = countdown not running; otherwise get_time() when autostart fires.
    lobby_countdown_ends_at: float;

    match_rng: u64;
    hearing_radius_sprite: Sprite_Renderer;
    navmesh_lock_refresh_elapsed: float;
    // Includes every world-owned round pickup, including Broken Cameras and VHS tapes.
    spawned_round_items: [..]Dropped_Item;
    spawned_async_deads: [..]Entity;
    spawned_async_molds: [..]Entity;
    round_entity_spawn: Entity;
    round_start_positions_applied: bool;
    round_start_transition_finished: bool;
    task_zone_task_id: string;
    entity_next_zone_progression_unlocked: bool;
    entity_final_zone_progression_unlocked: bool;
    entity_jumpscare_sabotage_unlocked: bool;
    round_tapes_collected: [8]bool;
    round_tape_zones: [8]CurrentZone;
    async_keycard_pickup_notifications_sent: int;
    lights_out_active: bool;
    lights_out_cooldown_ends_at: float;
    lights_out_generator_was_solved: bool;
    lights_out_previous_task_zone_task_id: string;
    lights_out_had_previous_task_zone: bool;
    lights_out_previous_task_zone_position: v2;

    ao_start :: method() {
        if #alive(game_manager_singleton) {
            log_info("Game_Manager: replacing previous singleton instance", {});
        }
        game_manager_singleton = this;

        if !#alive(navmesh_to_lock_to) {
            navmesh_to_lock_to = find_scene_navmesh();
        }

        phase = .LOBBY;
        result = .NONE;
        set_matchmaking_priority_for_phase(phase);
        entity_user_id = "";
        survivors_alive = 0;
        emergency_systems_online = false;
        head_start_ends_at = 0.0;
        role_selection_started_at = 0.0;
        role_selection_ends_at = 0.0;
        hunt_started_at = 0.0;
        next_entity_ability_unlock_at = 0.0;
        unlocked_entity_ability_count = 0;
        exit_unlocked_at = 0.0;
        match_ends_at = 0.0;
        round_timer_paused = false;
        round_timer_paused_remaining_seconds = 0.0;
        round_timer_pause_started_at = 0.0;
        entity_win_delay_ends_at = 0.0;
        ended_at = 0.0;
        end_game_cutscene_ends_at = 0.0;
        lobby_countdown_ends_at = 0.0;
        round_entity_spawn = null;
        round_start_positions_applied = false;
        round_start_transition_finished = false;
        task_zone_task_id = "";
        entity_next_zone_progression_unlocked = false;
        entity_final_zone_progression_unlocked = false;
        entity_jumpscare_sabotage_unlocked = false;
        async_keycard_pickup_notifications_sent = 0;
        lights_out_active = false;
        lights_out_cooldown_ends_at = 0.0;
        lights_out_generator_was_solved = false;
        lights_out_previous_task_zone_task_id = "";
        lights_out_had_previous_task_zone = false;
        lights_out_previous_task_zone_position = v2.{0.0, 0.0};
        reset_round_tapes_collected();
        match_rng = rng_root_seed();
        navmesh_lock_refresh_elapsed = 0.0;
        if !#alive(LobbySpawn) {
            LobbySpawn = Scene.get_entity_by_name("LobbySpawn");
        }
        if !#alive(ReconnectWiresSpawns) {
            ReconnectWiresSpawns = Scene.get_entity_by_name("ReconnectWiresSpawns");
        }
        if !#alive(EndOfGameWarp) {
            EndOfGameWarp = Scene.get_entity_by_name("EndOfGameWarp");
        }
        if !#alive(VO) {
            VO = Scene.get_entity_by_name("ViewfinderOnly");
        }
        sync_viewfinder_only_group_visibility();
        hide_task_zone();
        sync_dimensional_rift_enabled();
        set_blast_door_sprite_enabled(true);
        cache_hearing_radius_sprite();
        sync_entity_hearing_radius_visual(0.0);
        clear_all_footstep_echoes();
        clear_spawned_round_items();
        clear_all_barricades();
        clear_spawned_async_entities();
        clear_all_corpses();

        reset_all_entity_opt_ins();
    }

    ao_end :: method() {
        Server.set_matchmaking_priority(MATCHMAKING_PRIORITY_BETWEEN_ROUNDS);
        clear_all_footstep_echoes();
        clear_spawned_round_items();
        clear_all_barricades();
        clear_spawned_async_entities();
        clear_all_corpses();
        sync_entity_hearing_radius_visual(0.0);
        if #alive(VO) {
            VO.set_local_enabled(false);
        }
        if #alive(dimensionalRift) {
            dimensionalRift.set_local_enabled(false);
        }
        hide_task_zone();
        if game_manager_singleton == this {
            game_manager_singleton = null;
        }
    }

    ao_update :: method(dt: float) {
        sync_viewfinder_only_group_visibility();
        sync_dimensional_rift_enabled();

        if phase == .ENDED {
            sync_entity_hearing_radius_visual(0.0);
            if end_game_cutscene_ends_at > 0.0 && get_time() >= end_game_cutscene_ends_at {
                finish_end_game_cutscene();
            }
            if ended_at > 0.0 && get_time() >= ended_at + ENDED_TO_LOBBY_SECONDS {
                reset_to_lobby();
            }
            return;
        }

        sync_player_navmesh_locks(dt);
        if phase == .SURVIVOR_HEAD_START || phase == .ACTIVE {
            sync_entity_hearing_radius_visual(dt);
        } else {
            sync_entity_hearing_radius_visual(0.0);
        }

        if phase == .LOBBY {
            update_lobby_autostart();
        }

        exit_unlocked_now := phase == .ACTIVE && emergency_systems_online && SURVIVOR_ESCAPE_ENABLED;
        if exit_unlocked_now {
            if exit_unlocked_at <= 0.0 {
                exit_unlocked_at = get_time();
            }
        } else {
            exit_unlocked_at = 0.0;
        }

        if entity_win_delay_ends_at > 0.0 &&
            (phase == .SURVIVOR_HEAD_START || phase == .ACTIVE) &&
            get_time() >= entity_win_delay_ends_at {
            end_match_entity_win();
            return;
        }

        if phase == .SURVIVOR_HEAD_START {
            if !round_start_positions_applied && role_selection_ends_at > 0.0 && get_time() >= get_intro_spawn_teleport_at() {
                teleport_players_to_round_start_positions();
            }
            if round_start_positions_applied && !round_start_transition_finished && get_time() >= get_intro_spawn_transition_ends_at() {
                round_start_transition_finished = true;
                remove_intro_popup_freeze_from_all_players();
            }
            if get_time() >= head_start_ends_at {
                end_head_start_and_begin_hunt();
            }
            return;
        }

        if phase == .ACTIVE {
            if !round_timer_paused {
                update_entity_ability_unlocks();
            }
            if !round_timer_paused && get_time() >= match_ends_at {
                end_match_entity_win();
                return;
            }
        }
    }

    // --- Queries ---

    is_entity_player :: method(player: Player) -> bool {
        if entity_user_id.count == 0 {
            return false;
        }
        return player.get_user_id() == entity_user_id;
    }

    is_survivor_player :: method(player: Player) -> bool {
        if entity_user_id.count == 0 {
            return false;
        }
        return player.get_user_id() != entity_user_id;
    }

    is_round_in_progress :: method() -> bool {
        return phase == .SURVIVOR_HEAD_START || phase == .ACTIVE;
    }

    sync_viewfinder_only_group_visibility :: method() {
        if !#alive(VO) {
            VO = Scene.get_entity_by_name("ViewfinderOnly");
        }
        if !#alive(VO) {
            return;
        }

        should_show := is_local_viewfinder_active();
        child := VO.get_first_child();
        while #alive(child) {
            child.set_local_enabled(true);
            child = child.get_next_sibling();
        }
        VO.set_local_enabled(should_show);
    }

    sync_dimensional_rift_enabled :: method() {
        if !#alive(dimensionalRift) {
            dimensionalRift = Scene.get_entity_by_name("dimensionalRift");
        }
        if !#alive(dimensionalRift) {
            return;
        }

        should_enable := is_round_in_progress() && get_round_tapes_found_count(this) >= TASK_TAPE_COUNT;
        dimensionalRift.set_local_enabled(should_enable);
    }

    set_round_timer_paused :: method(paused: bool) -> bool {
        if phase != .ACTIVE {
            return false;
        }

        now := get_time();
        if paused {
            if round_timer_paused {
                return true;
            }

            round_timer_paused = true;
            round_timer_pause_started_at = now;
            round_timer_paused_remaining_seconds = match_ends_at - now;
            if round_timer_paused_remaining_seconds < 0.0 {
                round_timer_paused_remaining_seconds = 0.0;
            }
            return true;
        }

        if !round_timer_paused {
            return true;
        }

        paused_for := now - round_timer_pause_started_at;
        if paused_for < 0.0 {
            paused_for = 0.0;
        }
        match_ends_at = now + round_timer_paused_remaining_seconds;
        if next_entity_ability_unlock_at > 0.0 {
            next_entity_ability_unlock_at += paused_for;
        }
        round_timer_paused = false;
        round_timer_paused_remaining_seconds = 0.0;
        round_timer_pause_started_at = 0.0;
        return true;
    }

    set_round_timer_seconds :: method(seconds: float) -> bool {
        if phase != .ACTIVE {
            return false;
        }

        remaining := seconds;
        if remaining < 0.0 {
            remaining = 0.0;
        }

        if round_timer_paused {
            round_timer_paused_remaining_seconds = remaining;
        }
        match_ends_at = get_time() + remaining;
        return true;
    }

    update_entity_ability_unlocks :: method() {
        if phase != .ACTIVE || next_entity_ability_unlock_at <= 0.0 {
            return;
        }

        now := get_time();
        if unlocked_entity_ability_count < 2 && now >= next_entity_ability_unlock_at {
            unlocked_entity_ability_count = 2;
            next_entity_ability_unlock_at = 0.0;
            notify_all_players(ENTITY_ABILITY_UNLOCK_NOTIFICATION);
        }
    }

    unlock_entity_abilities_to_count :: method(count: s64) {
        if unlocked_entity_ability_count >= count {
            return;
        }

        unlocked_entity_ability_count = count;
        notify_all_players(ENTITY_ABILITY_UNLOCK_NOTIFICATION);
    }

    register_survivor_reached_next_zone :: method(player: Player) {
        if phase != .ACTIVE {
            return;
        }
        if player == null || !is_survivor_player(player) {
            return;
        }

        unlocked_new_entity_power := false;
        if player.current_zone == .Zone2 {
            if !entity_next_zone_progression_unlocked {
                entity_next_zone_progression_unlocked = true;
                entity_jumpscare_sabotage_unlocked = true;
                this.unlock_entity_abilities_to_count(ENTITY_NEXT_ZONE_UNLOCKED_ABILITY_COUNT);
                unlocked_new_entity_power = true;
            }
        } else if player.current_zone == .Zone3 {
            if !entity_next_zone_progression_unlocked {
                entity_next_zone_progression_unlocked = true;
                entity_jumpscare_sabotage_unlocked = true;
            }
            if !entity_final_zone_progression_unlocked {
                entity_final_zone_progression_unlocked = true;
                this.unlock_entity_abilities_to_count(ENTITY_FINAL_ZONE_UNLOCKED_ABILITY_COUNT);
                unlocked_new_entity_power = true;
            }
        }

        if unlocked_new_entity_power {
            if entity_player, ok := find_player_by_user_id(entity_user_id); ok {
                entity_player.jumpscare_cooldown_ends_at = 0.0;
                entity_player.toxic_rain_cooldown_ends_at = 0.0;
            }
        }
        update_survivor_task_progression(player);
    }

    get_intro_spawn_fade_to_black_starts_at :: method() -> float {
        return role_selection_ends_at - INTRO_SPAWN_FADE_TO_BLACK_LEAD_SECONDS;
    }

    get_intro_spawn_fade_to_black_ends_at :: method() -> float {
        return get_intro_spawn_fade_to_black_starts_at() + INTRO_SPAWN_FADE_TO_BLACK_SECONDS;
    }

    get_intro_spawn_teleport_at :: method() -> float {
        return role_selection_ends_at + INTRO_SPAWN_BLACK_HOLD_SECONDS;
    }

    get_intro_spawn_transition_ends_at :: method() -> float {
        return get_intro_spawn_teleport_at() + INTRO_SPAWN_FADE_FROM_BLACK_SECONDS;
    }

    can_start_match :: method() -> bool {
        players: [..]Player;
        collect_players(ref players);
        n := players.count;
        players.clear();
        return n >= MIN_TOTAL_PLAYERS && n <= MAX_TOTAL_PLAYERS;
    }

    can_force_start_match :: method() -> bool {
        players: [..]Player;
        collect_players(ref players);
        n := players.count;
        players.clear();
        return n >= 2 && n <= MAX_TOTAL_PLAYERS;
    }

    cache_hearing_radius_sprite :: method() {
        if hearing_radius_sprite != null && #alive(hearing_radius_entity) {
            return;
        }
        if #alive(hearing_radius_entity) {
            hearing_radius_sprite = hearing_radius_entity.get_component(Sprite_Renderer);
        }
    }

    get_local_player :: method() -> Player {
        for player: component_iterator(Player) {
            if player.is_local() {
                return player;
            }
        }
        return null;
    }

    get_navmesh_to_lock_to :: method() -> Navmesh {
        if !#alive(navmesh_to_lock_to) {
            navmesh_to_lock_to = find_scene_navmesh();
        }
        return navmesh_to_lock_to;
    }

    get_task_zone_entity :: method() -> Entity {
        if !#alive(TaskZoneEntity) {
            TaskZoneEntity = Scene.get_entity_by_name("Task Zone");
        }
        return TaskZoneEntity;
    }

    get_lobby_spawn_entity :: method() -> Entity {
        if !#alive(LobbySpawn) {
            LobbySpawn = Scene.get_entity_by_name("LobbySpawn");
        }
        return LobbySpawn;
    }

    teleport_player_to_lobby_spawn :: method(player: Player) {
        if player == null || !#alive(player.entity) {
            return;
        }

        spawn := get_lobby_spawn_entity();
        if !#alive(spawn) {
            return;
        }

        player.entity.set_local_position(spawn.world_position);
        player.entity.mark_teleported();
        if #alive(player.agent) {
            player.agent.velocity = v2{0.0, 0.0};
        }
    }

    hide_task_zone :: method() {
        task_zone_task_id = "";
        zone := get_task_zone_entity();
        if #alive(zone) {
            zone.set_local_enabled(false);
        }
    }

    set_blast_door_sprite_enabled :: method(enabled: bool) {
        if !#alive(BlastDoor) {
            BlastDoor = Scene.get_entity_by_name("BlastDoor");
        }
        if !#alive(BlastDoor) {
            return;
        }

        sprite := BlastDoor.get_component(Sprite_Renderer);
        if sprite != null {
            sprite.set_enabled(enabled);
        }
    }

    random_task_zone_position_near :: method(station: Entity) -> v2 {
        angle := rng_range_float(ref match_rng, 0.0, 2.0 * PI);
        radius_t := rng_range_float(ref match_rng, 0.0, 1.0);
        radius := TASK_ZONE_RANDOM_RADIUS * sqrt(radius_t);
        offset := v2{cos(angle) * radius, sin(angle) * radius};
        return station.world_position + offset;
    }

    place_task_zone_near :: method(task_id: string, station: Entity) -> bool {
        if !#alive(station) {
            return false;
        }

        zone := get_task_zone_entity();
        if !#alive(zone) {
            return false;
        }

        zone.set_local_position(random_task_zone_position_near(station));
        zone.mark_teleported();
        zone.set_local_enabled(true);
        task_zone_task_id = task_id;
        return true;
    }

    place_task_zone_for_next_task :: method(task_id: string) {
        if task_id == TASK_ID_RESTART_GENERATOR {
            hide_task_zone();
            return;
        }

        if task_id == TASK_ID_RECONNECT_WIRE {
            place_task_zone_near(TASK_ID_RECONNECT_WIRE, get_reconnect_wires_entity());
            return;
        }

        hide_task_zone();
    }

    handle_completed_team_task :: method(task_id: string) {
        if task_id == TASK_ID_ENTER_KEYCODE {
            place_task_zone_for_next_task(TASK_ID_RESTART_GENERATOR);
            return;
        }

        if task_id == TASK_ID_RESTART_GENERATOR {
            place_task_zone_for_next_task(TASK_ID_RECONNECT_WIRE);
            return;
        }

        if task_id == TASK_ID_RECONNECT_WIRE {
            hide_task_zone();
            set_blast_door_sprite_enabled(false);
        }

        if task_id == TASK_ID_PULL_BOTH_LEVERS {
            notify_all_players("Blast doors are opening!");
            set_zone3_blast_doors_open(true);
        }
    }

    is_task_zone_active_for :: method(task_id: string) -> bool {
        if task_zone_task_id != task_id {
            return false;
        }
        return #alive(get_task_zone_entity());
    }

    sync_entity_hearing_radius_visual :: method(dt: float) {
        cache_hearing_radius_sprite();
        if !#alive(hearing_radius_entity) || hearing_radius_sprite == null {
            return;
        }

        target_alpha := 0.0;
        visual_radius := ENTITY_HEARING_RADIUS + ENTITY_HEARING_VISUAL_BUFFER;
        in_round := phase == .SURVIVOR_HEAD_START || phase == .ACTIVE;

        if in_round {
            if entity_player, ok := find_player_by_user_id(entity_user_id); ok && #alive(entity_player.entity) {
                hearing_radius_entity.set_local_position(entity_player.entity.world_position);

                local_player := get_local_player();
                if #alive(local_player) &&
                    local_player != entity_player &&
                    !local_player.is_round_dead() &&
                    !is_entity_player(local_player) &&
                    #alive(local_player.entity) {
                    delta := local_player.entity.world_position - entity_player.entity.world_position;
                    if length_squared(delta) <= visual_radius * visual_radius {
                        target_alpha = ENTITY_HEARING_VISUAL_MAX_ALPHA;
                    }
                }
            }
        }

        tint := hearing_radius_sprite.color;
        if dt <= 0.0 {
            tint.w = target_alpha;
        } else {
            fade_t := clamp(dt * ENTITY_HEARING_VISUAL_FADE_SPEED, 0.0, 1.0);
            tint.w = lerp(tint.w, target_alpha, fade_t);
        }
        hearing_radius_sprite.color = tint;
    }

    sync_player_navmesh_locks :: method(dt: float) {
        navmesh_lock_refresh_elapsed += dt;
        if navmesh_lock_refresh_elapsed < 0.75 {
            return;
        }
        navmesh_lock_refresh_elapsed = 0.0;

        if !#alive(navmesh_to_lock_to) {
            navmesh_to_lock_to = find_scene_navmesh();
        }
        if !#alive(navmesh_to_lock_to) {
            return;
        }

        for player: component_iterator(Player) {
            lock_player_to_navmesh(player);
        }
    }

    lock_player_to_navmesh :: method(player: Player) {
        if player == null || !#alive(player.agent) {
            return;
        }
        if player.is_round_dead() {
            player.agent.set_navmesh_to_lock_to(null);
            return;
        }
        if !#alive(navmesh_to_lock_to) {
            navmesh_to_lock_to = find_scene_navmesh();
        }
        if !#alive(navmesh_to_lock_to) {
            return;
        }
        player.agent.set_navmesh_to_lock_to(navmesh_to_lock_to);
    }

    teleport_survivors_to_spawn :: method(players: []Player) {
        if !#alive(SurvivorSpawn) {
            return;
        }

        spawn_origin := SurvivorSpawn.world_position;
        for i: 0..players.count - 1 {
            player := players[i];
            if player.get_user_id() == entity_user_id {
                continue;
            }
            if !#alive(player.entity) {
                continue;
            }
            if player.is_round_dead() {
                continue;
            }

            angle := rng_range_float(ref match_rng, 0.0, 2.0 * PI);
            radius_t := rng_range_float(ref match_rng, 0.0, 1.0);
            radius := SURVIVOR_SPAWN_RADIUS * sqrt(radius_t);
            offset := v2{cos(angle) * radius, sin(angle) * radius};
            player.entity.set_local_position(spawn_origin + offset);
            player.entity.mark_teleported();
            player.current_zone = .Zone1;
        }
    }

    pick_random_spawn :: method(spawns: []Entity, excluded_spawn: Entity = null) -> Entity {
        valid_spawns: [..]Entity;
        for i: 0..spawns.count - 1 {
            spawn := spawns[i];
            if #alive(spawn) && spawn != excluded_spawn {
                valid_spawns.append(spawn);
            }
        }
        if valid_spawns.count == 0 {
            valid_spawns.clear();
            return null;
        }

        spawn_idx := rng_range_int(ref match_rng, 0, valid_spawns.count - 1);
        chosen_spawn := valid_spawns[spawn_idx];
        valid_spawns.clear();
        return chosen_spawn;
    }

    pick_random_spawn_from_parent :: method(parent: Entity, excluded_spawn: Entity = null) -> Entity {
        child_spawns: [..]Entity;
        collect_child_entity_references(parent, ref child_spawns);

        chosen_spawn := pick_random_spawn(child_spawns, excluded_spawn);
        child_spawns.clear();
        return chosen_spawn;
    }

    collect_child_entity_references :: method(parent: Entity, spawns: ref [..]Entity) {
        spawns.clear();
        if !#alive(parent) {
            return;
        }

        current := parent.get_first_child();
        while #alive(current) {
            spawns.append(current);
            current = current.get_next_sibling();
        }
    }

    hide_spawn_reference_sprites :: method(spawn_parent: Entity) {
        if !#alive(spawn_parent) {
            return;
        }

        spawn_refs: [..]Entity;
        collect_child_entity_references(spawn_parent, ref spawn_refs);
        for i: 0..spawn_refs.count - 1 {
            spawn_ref := spawn_refs[i];
            if !#alive(spawn_ref) {
                continue;
            }

            sprite := spawn_ref.get_component(Sprite_Renderer);
            if sprite != null {
                sprite.set_enabled(false);
            }
        }
        spawn_refs.clear();
    }

    hide_round_spawn_sprites_for_round :: method() {
        if !#alive(ItemSpawns) {
            ItemSpawns = Scene.get_entity_by_name("ItemDropsSpawns");
        }
        hide_spawn_reference_sprites(ItemSpawns);

        if !#alive(BrokenCameraSpawns) {
            BrokenCameraSpawns = Scene.get_entity_by_name("BrokenCameraSpawns");
        }
        hide_spawn_reference_sprites(BrokenCameraSpawns);

        if !#alive(VhsTapeSpawns) {
            VhsTapeSpawns = Scene.get_entity_by_name("VhsTapeSpawns");
        }
        hide_spawn_reference_sprites(VhsTapeSpawns);
    }

    clear_spawned_round_items :: method() {
        i: s64 = 0;
        while i < spawned_round_items.count {
            dropped_item := spawned_round_items[i];
            if #alive(dropped_item) {
                // Only destroy the world-owned item instance. Claimed pickups may have
                // already moved their item into a player's inventory.
                if #alive(dropped_item.item) && dropped_item.item.inventory == null {
                    Items.destroy_item_instance(dropped_item.item);
                }
                if #alive(dropped_item.entity) {
                    dropped_item.entity.destroy();
                }
            }
            i += 1;
        }
        spawned_round_items.clear();
    }

    clear_spawned_entity_list :: method(entities: ref [..]Entity) {
        i: s64 = 0;
        while i < entities.count {
            spawned_entity := entities[i];
            if #alive(spawned_entity) {
                spawned_entity.destroy();
            }
            i += 1;
        }
        entities.clear();
    }

    clear_spawned_async_entities :: method() {
        clear_spawned_entity_list(ref spawned_async_deads);
        i: s64 = 0;
        while i < spawned_async_molds.count {
            spawned_entity := spawned_async_molds[i];
            if #alive(spawned_entity) {
                tripmine := spawned_entity.get_component(Mold_Vomit_Tripmine);
                if tripmine == null || !tripmine.DontDelete {
                    spawned_entity.destroy();
                }
            }
            i += 1;
        }
        spawned_async_molds.clear();
    }

    assign_mold_vomit_tripmine_owners_for_round :: method() {
        if entity_user_id.count == 0 {
            return;
        }

        for tripmine: component_iterator(Mold_Vomit_Tripmine) {
            tripmine.set_owner_user_id(entity_user_id);
        }
    }

    clear_all_player_round_inventories :: method() {
        for player: component_iterator(Player) {
            player.clear_round_inventory();
        }
    }

    give_round_start_flashbang :: method(player: Player) -> bool {
        if player == null {
            return false;
        }

        init_weapon_items();
        item_def := get_registered_item_def_by_id(ROUND_START_FLASHBANG_ITEM_ID);
        if item_def == null {
            return false;
        }

        item := Items.create_item_instance(item_def, 1);
        will_destroy_item: bool;
        if !Items.can_move_item_to_inventory(item, player.default_inventory, ref will_destroy_item) {
            Items.destroy_item_instance(item);
            return false;
        }

        Items.move_item_to_inventory(item, player.default_inventory);
        return true;
    }

    clear_round_item_state :: method() {
        clear_all_player_round_inventories();
        clear_spawned_round_items();
        clear_all_barricades();
    }

    get_round_item_weight :: method(index: s64) -> s64 {
        weight: s64 = 1;
        if index >= 0 && index < RoundItemWeights.count {
            weight = RoundItemWeights[index];
        }
        if weight < 0 {
            weight = 0;
        }
        return weight;
    }

    choose_round_item_def :: method() -> Item_Definition {
        if RoundItemIds.count == 0 {
            return null;
        }

        init_weapon_items();

        total_weight: s64 = 0;
        for i: 0..RoundItemIds.count - 1 {
            item_id := RoundItemIds[i];
            if item_id.count == 0 {
                continue;
            }

            item_def := get_registered_item_def_by_id(item_id);
            if item_def == null {
                continue;
            }

            weight := get_round_item_weight(i);
            if weight <= 0 {
                continue;
            }

            total_weight += weight;
        }

        if total_weight <= 0 {
            return null;
        }

        roll := rng_range_int(ref match_rng, 1, total_weight);
        cumulative: s64 = 0;
        for i: 0..RoundItemIds.count - 1 {
            item_id := RoundItemIds[i];
            if item_id.count == 0 {
                continue;
            }

            item_def := get_registered_item_def_by_id(item_id);
            if item_def == null {
                continue;
            }

            weight := get_round_item_weight(i);
            if weight <= 0 {
                continue;
            }

            cumulative += weight;
            if roll <= cumulative {
                return item_def;
            }
        }

        return null;
    }

    spawn_round_item_def_at_position :: method(item_def: Item_Definition, position: v2) -> Dropped_Item {
        if item_def == null {
            return null;
        }

        item := Items.create_item_instance(item_def, 1);
        dropped_item := Dropped_Item.spawn(position, item);
        if !#alive(dropped_item) {
            if #alive(item) {
                Items.destroy_item_instance(item);
            }
            return null;
        }

        install_ghost_item_ping_listener(dropped_item);
        if dropped_item.sprite != null {
            dropped_item.sprite.mask_in_shadow = true;
        }
        if dropped_item.starburst != null {
            dropped_item.starburst.mask_in_shadow = true;
        }
        if dropped_item.shadow != null {
            dropped_item.shadow.mask_in_shadow = true;
        }

        dropped_item.despawn_time_start = get_time() + (ROUND_ITEM_DESPAWN_TOTAL_SECONDS - ROUND_ITEM_ENGINE_DESPAWN_WINDOW_SECONDS);
        return dropped_item;
    }

    spawn_weighted_round_item_at_position :: method(position: v2) -> Dropped_Item {
        chosen_item_def := choose_round_item_def();
        return spawn_round_item_def_at_position(chosen_item_def, position);
    }

    spawn_round_item_at_reference :: method(spawn_ref: Entity) -> Dropped_Item {
        if !#alive(spawn_ref) {
            return null;
        }

        return spawn_weighted_round_item_at_position(spawn_ref.world_position);
    }

    spawn_broken_camera_item_at_reference :: method(spawn_ref: Entity) -> Dropped_Item {
        if !#alive(spawn_ref) {
            return null;
        }

        init_weapon_items();
        broken_camera_def := get_registered_item_def_by_id(BROKEN_CAMERA_ITEM_ID);
        if broken_camera_def == null {
            return null;
        }

        item := Items.create_item_instance(broken_camera_def, 1);
        dropped_item := Dropped_Item.spawn(spawn_ref.world_position, item);
        if !#alive(dropped_item) {
            if #alive(item) {
                Items.destroy_item_instance(item);
            }
            return null;
        }

        install_ghost_item_ping_listener(dropped_item);
        if dropped_item.sprite != null {
            dropped_item.sprite.mask_in_shadow = true;
        }
        if dropped_item.starburst != null {
            dropped_item.starburst.mask_in_shadow = true;
        }
        if dropped_item.shadow != null {
            dropped_item.shadow.mask_in_shadow = true;
        }
        dropped_item.despawn_time_start = get_time() + (ROUND_ITEM_DESPAWN_TOTAL_SECONDS - ROUND_ITEM_ENGINE_DESPAWN_WINDOW_SECONDS);
        return dropped_item;
    }

    spawn_broken_camera_items_for_match :: method() {
        if !#alive(BrokenCameraSpawns) {
            BrokenCameraSpawns = Scene.get_entity_by_name("BrokenCameraSpawns");
        }

        broken_camera_spawns: [..]Entity;
        collect_child_entity_references(BrokenCameraSpawns, ref broken_camera_spawns);

        valid_spawns: [..]Entity;
        for i: 0..broken_camera_spawns.count - 1 {
            spawn_ref := broken_camera_spawns[i];
            if !#alive(spawn_ref) {
                continue;
            }

            already_added := false;
            for j: 0..valid_spawns.count - 1 {
                if valid_spawns[j] == spawn_ref {
                    already_added = true;
                    break;
                }
            }

            if !already_added {
                valid_spawns.append(spawn_ref);
            }
        }

        for i: 0..valid_spawns.count - 1 {
            dropped_item := spawn_broken_camera_item_at_reference(valid_spawns[i]);
            if #alive(dropped_item) {
                spawned_round_items.append(dropped_item);
            }
        }

        broken_camera_spawns.clear();
        valid_spawns.clear();
    }

    get_vhs_tape_item_id_for_index :: method(index: s64) -> string {
        switch index {
            case 0: return TASK_TAPE_ITEM_YELLOW;
            case 1: return TASK_TAPE_ITEM_BLACK;
            case 2: return TASK_TAPE_ITEM_WHITE;
            case 3: return TASK_TAPE_ITEM_RED;
            case 4: return TASK_TAPE_ITEM_ORANGE;
            case 5: return TASK_TAPE_ITEM_PINK;
            case 6: return TASK_TAPE_ITEM_BLUE;
            case 7: return TASK_TAPE_ITEM_GREEN;
        }
        return "";
    }

    get_vhs_tape_zone_for_spawn_ref :: method(spawn_ref: Entity) -> CurrentZone {
        if !#alive(spawn_ref) {
            return .None;
        }

        spawn_name := spawn_ref.get_name();
        if spawn_name.count <= 0 {
            return .None;
        }

        zone_prefix := string_substring(spawn_name, 0, 1);
        switch zone_prefix {
            case "1": return .Zone1;
            case "2": return .Zone2;
            case "3": return .Zone3;
        }
        return .None;
    }

    get_vhs_tape_zone_for_index :: method(index: s64) -> CurrentZone {
        if index >= 0 && index <= 2 return .Zone1;
        if index >= 3 && index <= 5 return .Zone2;
        if index >= 6 && index <= 7 return .Zone3;
        return .None;
    }

    choose_vhs_tape_spawn_ref :: method(spawns: ref [..]Entity) -> Entity {
        if spawns.count <= 0 {
            return null;
        }

        spawn_index := rng_range_int(ref match_rng, 0, spawns.count - 1);
        spawn_ref := spawns[spawn_index];
        spawns.unordered_remove_by_index(spawn_index);
        return spawn_ref;
    }

    spawn_vhs_tape_item_at_reference :: method(spawn_ref: Entity, tape_index: s64) -> Dropped_Item {
        if !#alive(spawn_ref) {
            return null;
        }

        tape_item_id := get_vhs_tape_item_id_for_index(tape_index);
        if tape_item_id.count == 0 {
            return null;
        }

        init_weapon_items();
        tape_def := get_registered_item_def_by_id(tape_item_id);
        if tape_def == null {
            return null;
        }

        item := Items.create_item_instance(tape_def, 1);
        dropped_item := Dropped_Item.spawn(spawn_ref.world_position, item);
        if !#alive(dropped_item) {
            if #alive(item) {
                Items.destroy_item_instance(item);
            }
            return null;
        }

        configure_vhs_tape_dropped_item(dropped_item);
        dropped_item.despawn_time_start = get_time() + (ROUND_ITEM_DESPAWN_TOTAL_SECONDS - ROUND_ITEM_ENGINE_DESPAWN_WINDOW_SECONDS);
        return dropped_item;
    }

    spawn_vhs_tape_items_for_match :: method() {
        if !#alive(VhsTapeSpawns) {
            VhsTapeSpawns = Scene.get_entity_by_name("VhsTapeSpawns");
        }

        vhs_tape_spawns: [..]Entity;
        collect_child_entity_references(VhsTapeSpawns, ref vhs_tape_spawns);

        valid_spawns: [..]Entity;
        zone1_spawns: [..]Entity;
        zone2_spawns: [..]Entity;
        zone3_spawns: [..]Entity;
        for i: 0..vhs_tape_spawns.count - 1 {
            spawn_ref := vhs_tape_spawns[i];
            if !#alive(spawn_ref) {
                continue;
            }

            already_added := false;
            for j: 0..valid_spawns.count - 1 {
                if valid_spawns[j] == spawn_ref {
                    already_added = true;
                    break;
                }
            }

            if !already_added {
                valid_spawns.append(spawn_ref);
                spawn_zone := get_vhs_tape_zone_for_spawn_ref(spawn_ref);
                switch spawn_zone {
                    case .Zone1: zone1_spawns.append(spawn_ref);
                    case .Zone2: zone2_spawns.append(spawn_ref);
                    case .Zone3: zone3_spawns.append(spawn_ref);
                }
            }
        }

        for tape_index: 0..TASK_TAPE_COUNT - 1 {
            target_zone := get_vhs_tape_zone_for_index(tape_index);
            spawn_ref: Entity = null;
            switch target_zone {
                case .Zone1: spawn_ref = choose_vhs_tape_spawn_ref(ref zone1_spawns);
                case .Zone2: spawn_ref = choose_vhs_tape_spawn_ref(ref zone2_spawns);
                case .Zone3: spawn_ref = choose_vhs_tape_spawn_ref(ref zone3_spawns);
            }

            if !#alive(spawn_ref) {
                log_info("Game_Manager: no VHS tape spawn found for tape % in zone %", {tape_index, target_zone});
                continue;
            }

            dropped_item := spawn_vhs_tape_item_at_reference(spawn_ref, tape_index);
            if #alive(dropped_item) {
                round_tape_zones[tape_index] = get_vhs_tape_zone_for_spawn_ref(spawn_ref);
                spawned_round_items.append(dropped_item);
            }
        }

        vhs_tape_spawns.clear();
        valid_spawns.clear();
        zone1_spawns.clear();
        zone2_spawns.clear();
        zone3_spawns.clear();
    }

    spawn_async_corpse_loot :: method(position: v2) -> bool {
        init_weapon_items();
        keycard_def := get_registered_item_def_by_id(ASYNC_KEYCARD_ITEM_ID);
        if keycard_def == null {
            return false;
        }

        item := Items.create_item_instance(keycard_def, 1);
        dropped_item := Dropped_Item.spawn(position, item);
        if !#alive(dropped_item) {
            if #alive(item) {
                Items.destroy_item_instance(item);
            }
            return false;
        }

        install_ghost_item_ping_listener(dropped_item);
        if dropped_item.sprite != null {
            dropped_item.sprite.mask_in_shadow = true;
        }
        if dropped_item.starburst != null {
            dropped_item.starburst.mask_in_shadow = true;
        }
        if dropped_item.shadow != null {
            dropped_item.shadow.mask_in_shadow = true;
        }
        dropped_item.despawn_time_start = get_time() + (ROUND_ITEM_DESPAWN_TOTAL_SECONDS - ROUND_ITEM_ENGINE_DESPAWN_WINDOW_SECONDS);
        spawned_round_items.append(dropped_item);
        return true;
    }

    spawn_round_items_for_match :: method() {
        clear_spawned_round_items();

        item_spawns: [..]Entity;
        collect_child_entity_references(ItemSpawns, ref item_spawns);

        if item_spawns.count == 0 || RoundItemIds.count == 0 {
            item_spawns.clear();
            return;
        }

        valid_spawns: [..]Entity;
        for i: 0..item_spawns.count - 1 {
            spawn_ref := item_spawns[i];
            if !#alive(spawn_ref) {
                continue;
            }

            already_added := false;
            for j: 0..valid_spawns.count - 1 {
                if valid_spawns[j] == spawn_ref {
                    already_added = true;
                    break;
                }
            }

            if !already_added {
                valid_spawns.append(spawn_ref);
            }
        }

        if valid_spawns.count == 0 {
            item_spawns.clear();
            valid_spawns.clear();
            return;
        }

        target_min := MinRoundItemSpawnCount;
        if target_min < 0 {
            target_min = 0;
        }

        target_max := valid_spawns.count;
        if target_max < target_min {
            target_max = target_min;
        }
        if target_min > target_max {
            target_min = target_max;
        }

        target_count := rng_range_int(ref match_rng, target_min, target_max);
        spawned_item_count: s64 = 0;
        while spawned_item_count < target_count && valid_spawns.count > 0 {
            spawn_idx := rng_range_int(ref match_rng, 0, valid_spawns.count - 1);
            spawn_ref := valid_spawns[spawn_idx];
            valid_spawns.unordered_remove_by_index(spawn_idx);

            dropped_item := spawn_round_item_at_reference(spawn_ref);
            if #alive(dropped_item) {
                spawned_round_items.append(dropped_item);
                spawned_item_count += 1;
            }
        }

        item_spawns.clear();
        valid_spawns.clear();
    }

    spawn_async_dead_at_reference :: method(spawn_ref: Entity) {
        if !#alive(spawn_ref) {
            return;
        }

        dead_prefab := get_asset(Prefab_Asset, "AsyncDead.prefab");
        if dead_prefab != null {
            dead_entity := Scene.instantiate(dead_prefab, spawn_ref.world_position);
            if #alive(dead_entity) {
                dead_entity.mark_teleported();
                if dead_entity.get_component(DeadAsync) == null {
                    dead_entity.add_component(DeadAsync);
                }
                spawned_async_deads.append(dead_entity);
            }
        }

        mold_prefab := get_asset(Prefab_Asset, ENTITY_VOMIT_PREFAB_PATH);
        if mold_prefab != null {
            mold_entity := Scene.instantiate(mold_prefab, spawn_ref.world_position);
            if #alive(mold_entity) {
                mold_entity.mark_teleported();
                tripmine := mold_entity.get_component(Mold_Vomit_Tripmine);
                if tripmine == null {
                    tripmine = mold_entity.add_component(Mold_Vomit_Tripmine);
                }
                tripmine.setup(null);
                spawned_async_molds.append(mold_entity);
            }
        }
    }

    spawn_async_entities_for_match :: method() {
        clear_spawned_async_entities();

        if !#alive(AsyncSpawns) {
            AsyncSpawns = Scene.get_entity_by_name("AsyncSpawns");
        }

        async_spawns: [..]Entity;
        collect_child_entity_references(AsyncSpawns, ref async_spawns);

        if async_spawns.count == 0 {
            async_spawns.clear();
            return;
        }

        target_count := AsyncSpawnCount;
        if target_count <= 0 {
            target_count = 3;
        }

        valid_spawns: [..]Entity;
        for i: 0..async_spawns.count - 1 {
            spawn_ref := async_spawns[i];
            if !#alive(spawn_ref) {
                continue;
            }

            already_added := false;
            for j: 0..valid_spawns.count - 1 {
                if valid_spawns[j] == spawn_ref {
                    already_added = true;
                    break;
                }
            }

            if !already_added {
                valid_spawns.append(spawn_ref);
            }
        }

        if target_count > valid_spawns.count {
            target_count = valid_spawns.count;
        }

        while spawned_async_deads.count < target_count && valid_spawns.count > 0 {
            spawn_idx := rng_range_int(ref match_rng, 0, valid_spawns.count - 1);
            spawn_ref := valid_spawns[spawn_idx];
            valid_spawns.unordered_remove_by_index(spawn_idx);

            spawn_async_dead_at_reference(spawn_ref);
        }

        async_spawns.clear();
        valid_spawns.clear();
    }

    teleport_entity_to_random_spawn :: method() -> Entity {
        if entity_player, ok := find_player_by_user_id(entity_user_id); ok {
            if !#alive(entity_player.entity) {
                return null;
            }

            spawn := pick_random_spawn_from_parent(EntitySpawns);
            if !#alive(spawn) {
                return null;
            }

            entity_player.entity.set_local_position(spawn.world_position);
            entity_player.entity.mark_teleported();
            return spawn;
        }

        return null;
    }

    get_reconnect_wires_entity :: method() -> Entity {
        if #alive(ReconnectWiresEntity) {
            return ReconnectWiresEntity;
        }

        for wire: component_iterator(Wire_Puzzle) {
            if #alive(wire.entity) {
                return wire.entity;
            }
        }
        return null;
    }

    teleport_reconnect_wires_to_random_spawn :: method() -> bool {
        wire_entity := get_reconnect_wires_entity();
        if !#alive(wire_entity) {
            return false;
        }

        if !#alive(ReconnectWiresSpawns) {
            ReconnectWiresSpawns = Scene.get_entity_by_name("ReconnectWiresSpawns");
        }

        spawn := pick_random_spawn_from_parent(ReconnectWiresSpawns);
        if !#alive(spawn) {
            return false;
        }

        wire_entity.set_local_position(spawn.world_position);
        wire_entity.mark_teleported();
        return true;
    }

    teleport_radio_puzzle_to_random_spawn :: method() {
        if !#alive(RadioPuzzle) {
            return;
        }

        spawn := pick_random_spawn_from_parent(RadioSpawns);
        if !#alive(spawn) {
            return;
        }

        RadioPuzzle.set_local_position(spawn.world_position);
        RadioPuzzle.mark_teleported();
    }

    teleport_players_to_round_start_positions :: method() {
        round_start_positions_applied = true;

        if entity_player, ok := find_player_by_user_id(entity_user_id); ok && #alive(entity_player.entity) && #alive(round_entity_spawn) {
            entity_player.entity.set_local_position(round_entity_spawn.world_position);
            entity_player.entity.mark_teleported();
        }

        players: [..]Player;
        collect_players(ref players);
        teleport_survivors_to_spawn(players);
        players.clear();
    }

    remove_intro_popup_freeze_from_all_players :: method() {
        for player: component_iterator(Player) {
            player.remove_freeze_reason(FREEZE_INTRO_POPUP);
        }
    }

    reset_round_tapes_collected :: method() {
        for i: 0..7 {
            round_tapes_collected[i] = false;
            round_tape_zones[i] = .None;
        }
    }

    reset_generator_for_round :: method(round_seed_key: u64) {
        if !#alive(GeneratorEntity) {
            return;
        }

        generator := GeneratorEntity.get_component(Generator);
        if generator == null {
            return;
        }

        generator.reset_for_round(round_seed_key);
    }

    get_generator_component :: method() -> Generator {
        if !#alive(GeneratorEntity) {
            return null;
        }
        return GeneratorEntity.get_component(Generator);
    }

    start_lights_out_sabotage :: method(caller: Player) -> bool {
        if caller == null || !#alive(caller.entity) || !is_entity_player(caller) {
            return false;
        }
        if phase != .SURVIVOR_HEAD_START && phase != .ACTIVE {
            return false;
        }
        if lights_out_active {
            return false;
        }
        if get_time() < lights_out_cooldown_ends_at {
            return false;
        }

        generator := get_generator_component();
        if generator == null {
            return false;
        }
        if generator.in_use {
            return false;
        }

        lights_out_previous_task_zone_task_id = task_zone_task_id;
        lights_out_had_previous_task_zone = task_zone_task_id.count > 0;
        if lights_out_had_previous_task_zone {
            previous_zone := get_task_zone_entity();
            if #alive(previous_zone) {
                lights_out_previous_task_zone_position = previous_zone.world_position;
            } else {
                lights_out_had_previous_task_zone = false;
            }
        }
        lights_out_active = true;
        lights_out_cooldown_ends_at = get_time() + LIGHTS_OUT_SABOTAGE_COOLDOWN_SECONDS;
        lights_out_generator_was_solved = generator.solved;

        generator.reset_for_round((head_start_ends_at * 1000.0).(u64));
        assign_lights_out_generator_tasks();
        notify_survivors("Lights Out! Restart the generator.");
        return true;
    }

    end_lights_out_sabotage :: method(player_who_completed: Player) {
        if !lights_out_active {
            return;
        }

        complete_lights_out_generator_tasks(player_who_completed);
        lights_out_active = false;

        generator := get_generator_component();
        if generator != null {
            if lights_out_generator_was_solved {
                generator.solved = true;
                generator.in_use = false;
                generator.set_text(GENERATOR_COMPLETE_PROMPT);
            } else {
                generator.reset_for_round((head_start_ends_at * 1000.0).(u64));
            }
        }
        lights_out_generator_was_solved = false;

        if lights_out_had_previous_task_zone && lights_out_previous_task_zone_task_id.count > 0 {
            zone := get_task_zone_entity();
            if #alive(zone) {
                zone.set_local_position(lights_out_previous_task_zone_position);
                zone.mark_teleported();
                zone.set_local_enabled(true);
                task_zone_task_id = lights_out_previous_task_zone_task_id;
            } else {
                hide_task_zone();
            }
        } else {
            hide_task_zone();
        }
        lights_out_previous_task_zone_task_id = "";
        lights_out_had_previous_task_zone = false;
        lights_out_previous_task_zone_position = v2.{0.0, 0.0};

        remove_lights_out_generator_tasks();
        if player_who_completed != null {
            notify_survivors("% restored the lights.", {player_who_completed.get_username()});
        } else {
            notify_survivors("The lights are back on.");
        }
    }

    update_lobby_autostart :: method() {
        n := count_players();

        if n < MIN_TOTAL_PLAYERS || n > MAX_TOTAL_PLAYERS {
            lobby_countdown_ends_at = 0.0;
            return;
        }

        if lobby_countdown_ends_at <= 0.0 {
            lobby_countdown_ends_at = get_time() + LOBBY_COUNTDOWN_SECONDS;
        }

        if get_time() >= lobby_countdown_ends_at {
            lobby_countdown_ends_at = 0.0;
            start_match();
        }
    }

    // --- Lobby → round ---

    // Picks one Entity (random among connected players). Survivors are everyone else.
    // `ignore_min_players` is only for admin cheats and still respects MAX_TOTAL_PLAYERS.
    start_match :: method(ignore_min_players: bool = false) -> bool {
        if phase != .LOBBY {
            return false;
        }
        if ignore_min_players {
            if !can_force_start_match() {
                return false;
            }
        } else if !can_start_match() {
            return false;
        }

        players: [..]Player;
        collect_players(ref players);
        min_players := MIN_TOTAL_PLAYERS;
        if ignore_min_players {
            min_players = 2;
        }
        if players.count < min_players || players.count > MAX_TOTAL_PLAYERS {
            players.clear();
            return false;
        }

        pool: [..]Player;
        for i: 0..players.count - 1 {
            if players[i].entity_opt_in {
                pool.append(players[i]);
            }
        }
        if pool.count == 0 {
            for i: 0..players.count - 1 {
                pool.append(players[i]);
            }
        }

        pick_idx := rng_range_int(ref match_rng, 0, pool.count - 1);
        chosen := pool[pick_idx];
        entity_user_id = chosen.get_user_id();
        survivors_alive = players.count - 1;
        entity_spawn := pick_random_spawn_from_parent(EntitySpawns);
        if !#alive(entity_spawn) {
            entity_user_id = "";
            survivors_alive = 0;
            players.clear();
            pool.clear();
            return false;
        }

        if !#alive(GeneratorEntity) {
            entity_user_id = "";
            survivors_alive = 0;
            players.clear();
            pool.clear();
            return false;
        }

        now := get_time();
        emergency_systems_online = false;
        result = .NONE;
        hide_task_zone();
        lights_out_active = false;
        lights_out_cooldown_ends_at = now + LIGHTS_OUT_SABOTAGE_COOLDOWN_SECONDS * SABOTAGE_START_COOLDOWN_FRACTION;
        lights_out_generator_was_solved = false;
        lights_out_previous_task_zone_task_id = "";
        lights_out_had_previous_task_zone = false;
        lights_out_previous_task_zone_position = v2.{0.0, 0.0};
        clear_all_footstep_echoes();
        clear_all_corpses();
        clear_all_barricades();
        reset_round_tapes_collected();
        async_keycard_pickup_notifications_sent = 0;
        reset_all_keycard_scanners_for_round();
        reset_all_door_levels_for_round();
        set_zone3_blast_doors_open(false);
        hide_round_spawn_sprites_for_round();
        set_blast_door_sprite_enabled(true);

        next_role_selection_ends_at := now + ROLE_SELECTION_SECONDS;
        intro_spawn_after_popup_seconds := INTRO_SPAWN_BLACK_HOLD_SECONDS + INTRO_SPAWN_FADE_FROM_BLACK_SECONDS;
        next_head_start_ends_at := next_role_selection_ends_at + intro_spawn_after_popup_seconds + HEAD_START_SECONDS;
        round_entity_spawn = entity_spawn;
        round_start_positions_applied = false;
        round_start_transition_finished = false;
        teleport_reconnect_wires_to_random_spawn();
        teleport_radio_puzzle_to_random_spawn();
        reset_generator_for_round((next_head_start_ends_at * 1000.0).(u64));
        reset_all_wire_puzzles_for_round((next_head_start_ends_at * 1000.0).(u64));

        for i: 0..players.count - 1 {
            if players[i].get_user_id() == entity_user_id {
                players[i].current_zone = .None;
            } else {
                players[i].current_zone = .Zone1;
            }
            players[i].clear_round_minion_state();
            players[i].clear_round_death_state(false);
            clear_player_tasks(players[i]);
            players[i].vent_cooldown_ends_at = 0.0;
            players[i].jumpscare_request_target_user_id = "";
            players[i].jumpscare_request_id = 0;
            players[i].jumpscare_processed_request_id = 0;
            players[i].jumpscare_cooldown_ends_at = 0.0;
            players[i].toxic_rain_cooldown_ends_at = 0.0;
            players[i].stop_toxic_rain_targeting();
            players[i].add_freeze_reason(FREEZE_INTRO_POPUP);
            if #alive(players[i].agent) {
                players[i].agent.velocity = v2{0.0, 0.0};
            }
            if players[i].get_user_id() != entity_user_id {
                assign_default_survivor_tasks(players[i]);
            }
            give_round_start_flashbang(players[i]);
        }
        spawn_round_items_for_match();
        spawn_broken_camera_items_for_match();
        spawn_vhs_tape_items_for_match();
        spawn_async_entities_for_match();
        assign_mold_vomit_tripmine_owners_for_round();
        players.clear();
        pool.clear();

        if entity_player, ok := find_player_by_user_id(entity_user_id); ok {
            entity_player.current_zone = .Zone1;
            entity_player.add_freeze_reason(FREEZE_ENTITY_HEAD_START);
        }

        head_start_ends_at = next_head_start_ends_at;
        role_selection_started_at = now;
        role_selection_ends_at = next_role_selection_ends_at;
        hunt_started_at = 0.0;
        next_entity_ability_unlock_at = 0.0;
        unlocked_entity_ability_count = 1;
        entity_next_zone_progression_unlocked = false;
        entity_final_zone_progression_unlocked = false;
        entity_jumpscare_sabotage_unlocked = false;
        exit_unlocked_at = 0.0;
        // Match clock starts after head start (full hunt window).
        match_ends_at = head_start_ends_at + MATCH_MAX_SECONDS;
        round_timer_paused = false;
        round_timer_paused_remaining_seconds = 0.0;
        round_timer_pause_started_at = 0.0;
        entity_win_delay_ends_at = 0.0;
        phase = .SURVIVOR_HEAD_START;
        set_matchmaking_priority_for_phase(phase);

        log_info("Game_Manager: Entity is % (role reveal during head start % sec, head start % sec)", {entity_user_id, ROLE_SELECTION_SECONDS, HEAD_START_SECONDS});
        return true;
    }

    end_head_start_and_begin_hunt :: method() {
        if phase != .SURVIVOR_HEAD_START {
            return;
        }

        if entity_player, ok := find_player_by_user_id(entity_user_id); ok {
            clear_player_ability_cooldowns(entity_player);
            entity_player.remove_freeze_reason(FREEZE_ENTITY_HEAD_START);
        }

        braam_desc := SFX.default_sfx_desc();
        braam_desc.volume = 0.7;
        braam_desc.channel = .MUSIC;
        SFX.play(get_asset(SFX_Asset, "SFX/braam.wav"), braam_desc);

        hunt_started_at = get_time();
        next_entity_ability_unlock_at = hunt_started_at + ENTITY_SCREAM_UNLOCK_DELAY_SECONDS;
        phase = .ACTIVE;
        set_matchmaking_priority_for_phase(phase);
        log_info("Game_Manager: Hunt started; match ends at t=%", {match_ends_at});
    }

    // --- World systems (exit, objectives) call into these ---

    set_emergency_systems_online :: method(online: bool) {
        emergency_systems_online = online;
    }

    // When a Survivor is eliminated (death, disconnect handling, etc.).
    register_survivor_eliminated :: method() {
        if phase != .ACTIVE && phase != .SURVIVOR_HEAD_START {
            return;
        }
        if survivors_alive > 0 {
            survivors_alive -= 1;
        }
        if survivors_alive <= 0 && entity_win_delay_ends_at <= 0.0 {
            entity_win_delay_ends_at = get_time() + LAST_SURVIVOR_ENTITY_WIN_DELAY_SECONDS;
        }
    }

    handle_round_player_joined :: method(player: Player) {
        if player == null || !is_round_in_progress() {
            return;
        }
        if !is_survivor_player(player) {
            return;
        }

        clear_player_tasks(player);
        player.mark_round_dead(false);
        player.enter_round_dead_ghost_state();
        log_info("Game_Manager: late joiner % entered as a dead survivor", {player.get_user_id()});
    }

    handle_round_player_left :: method(player: Player) {
        if player == null || !is_round_in_progress() {
            return;
        }
        if is_entity_player(player) {
            end_match_survivors_win();
            return;
        }
        if player.is_round_minion() {
            return;
        }
        if !is_survivor_player(player) || player.is_round_dead() {
            return;
        }

        register_survivor_eliminated();
        log_info("Game_Manager: survivor % left during the round", {player.get_user_id()});
    }

    // Survivor reaches exit with all emergency systems online — team win.
    survivor_team_escape :: method(exiting_player: Player) {
        if !SURVIVOR_ESCAPE_ENABLED {
            return;
        }
        if phase != .ACTIVE {
            return;
        }
        if !is_survivor_player(exiting_player) || !exiting_player.is_round_survivor() {
            return;
        }
        if !emergency_systems_online {
            return;
        }
        end_match_survivors_win();
    }

    // --- Internal ---

    reset_to_lobby :: method() {
        finish_end_game_cutscene();
        clear_all_footstep_echoes();
        for player: component_iterator(Player) {
            player.current_zone = .None;
            player.stop_toxic_rain_targeting();
            player.clear_round_minion_state();
            player.clear_round_death_state(false);
            clear_player_tasks(player);
            player.vent_cooldown_ends_at = 0.0;
            player.remove_freeze_reason(FREEZE_ENTITY_HEAD_START);
            player.remove_freeze_reason(FREEZE_INTRO_POPUP);
        }
        clear_round_item_state();
        clear_spawned_async_entities();
        clear_all_corpses();
        reset_all_keypad_puzzles_for_round(0);
        reset_all_radio_puzzles_for_round(0);
        reset_generator_for_round(0);
        reset_all_wire_puzzles_for_round(0);
        reset_all_keycard_scanners_for_round();
        reset_all_door_levels_for_round();
        set_zone3_blast_doors_open(false);
        set_blast_door_sprite_enabled(true);
        lights_out_active = false;
        lights_out_cooldown_ends_at = 0.0;
        lights_out_generator_was_solved = false;
        lights_out_previous_task_zone_task_id = "";
        lights_out_had_previous_task_zone = false;
        lights_out_previous_task_zone_position = v2.{0.0, 0.0};
        phase = .LOBBY;
        set_matchmaking_priority_for_phase(phase);
        result = .NONE;
        entity_user_id = "";
        survivors_alive = 0;
        emergency_systems_online = false;
        head_start_ends_at = 0.0;
        role_selection_started_at = 0.0;
        role_selection_ends_at = 0.0;
        hunt_started_at = 0.0;
        next_entity_ability_unlock_at = 0.0;
        unlocked_entity_ability_count = 0;
        exit_unlocked_at = 0.0;
        match_ends_at = 0.0;
        round_timer_paused = false;
        round_timer_paused_remaining_seconds = 0.0;
        round_timer_pause_started_at = 0.0;
        entity_win_delay_ends_at = 0.0;
        ended_at = 0.0;
        end_game_cutscene_ends_at = 0.0;
        lobby_countdown_ends_at = 0.0;
        round_entity_spawn = null;
        round_start_positions_applied = false;
        round_start_transition_finished = false;
        entity_next_zone_progression_unlocked = false;
        entity_final_zone_progression_unlocked = false;
        entity_jumpscare_sabotage_unlocked = false;
        async_keycard_pickup_notifications_sent = 0;
        hide_task_zone();
        sync_dimensional_rift_enabled();
    }

    is_end_game_cutscene_active :: method() -> bool {
        return phase == .ENDED && end_game_cutscene_ends_at > 0.0 && get_time() < end_game_cutscene_ends_at;
    }

    get_end_game_cutscene_position :: method() -> v2 {
        if #alive(EndOfGameWarp) {
            return EndOfGameWarp.world_position;
        }

        fallback := Scene.get_entity_by_name("EndOfGameWarp");
        if #alive(fallback) {
            EndOfGameWarp = fallback;
            return fallback.world_position;
        }

        return v2{0.0, 0.0};
    }

    begin_end_game_cutscene :: method() {
        center := get_end_game_cutscene_position();
        end_game_cutscene_ends_at = get_time() + END_GAME_CUTSCENE_SECONDS;

        for player: component_iterator(Player) {
            if !#alive(player.entity) {
                continue;
            }

            angle := rng_range_float(ref match_rng, 0.0, 2.0 * PI);
            radius_t := rng_range_float(ref match_rng, 0.0, 1.0);
            radius := END_GAME_CUTSCENE_RADIUS * sqrt(radius_t);
            offset := v2{cos(angle) * radius, sin(angle) * radius};
            dance_index := rng_range_int(ref match_rng, 0, 4);
            player.prepare_for_end_game_cutscene(center + offset, center, dance_index);
        }
    }

    finish_end_game_cutscene :: method() {
        if end_game_cutscene_ends_at <= 0.0 {
            return;
        }

        for player: component_iterator(Player) {
            player.cleanup_end_game_cutscene();
        }
        end_game_cutscene_ends_at = 0.0;
    }

    restore_round_end_name_visibility :: method() {
        for player: component_iterator(Player) {
            player.entity_name_hidden = false;
            player.remove_name_invisibility_reason(ENTITY_NAME_INVISIBILITY_REASON);
        }
    }

    award_player_wins :: method(winning_result: Match_Result) {
        for player: component_iterator(Player) {
            if winning_result == .SURVIVORS_WIN && is_survivor_player(player) {
                player.increment_player_wins();
            } else if winning_result == .ENTITY_WIN && is_entity_player(player) {
                player.increment_player_wins();
            }
        }
    }

    record_game_data_result :: method(winning_result: Match_Result) {
        if !Game.is_server() {
            return;
        }

        Save.increment_game_int(GAMES_PLAYED_SAVE_KEY, 1);
        if winning_result == .SURVIVORS_WIN {
            Save.increment_game_int(SURVIVOR_WINS_SAVE_KEY, 1);
        } else if winning_result == .ENTITY_WIN {
            Save.increment_game_int(MONSTER_WINS_SAVE_KEY, 1);
        }
    }

    end_match_survivors_win :: method() {
        if phase == .ENDED {
            return;
        }
        stop_entity_ambience_sound();
        record_game_data_result(.SURVIVORS_WIN);
        award_player_wins(.SURVIVORS_WIN);
        clear_all_footstep_echoes();
        clear_round_item_state();
        clear_spawned_async_entities();
        clear_all_corpses();
        for player: component_iterator(Player) {
            player.current_zone = .None;
            player.stop_toxic_rain_targeting();
            player.clear_round_minion_state();
        }
        phase = .ENDED;
        set_matchmaking_priority_for_phase(phase);
        result = .SURVIVORS_WIN;
        entity_win_delay_ends_at = 0.0;
        ended_at = get_time();
        unfreeze_entity_if_needed();
        restore_round_end_name_visibility();
        begin_end_game_cutscene();
        log_info("Game_Manager: Survivors win", {});
    }

    end_match_entity_win :: method() {
        if phase == .ENDED {
            return;
        }
        stop_entity_ambience_sound();
        record_game_data_result(.ENTITY_WIN);
        award_player_wins(.ENTITY_WIN);
        clear_all_footstep_echoes();
        clear_round_item_state();
        clear_spawned_async_entities();
        clear_all_corpses();
        for player: component_iterator(Player) {
            player.current_zone = .None;
            player.stop_toxic_rain_targeting();
            player.clear_round_minion_state();
        }
        phase = .ENDED;
        set_matchmaking_priority_for_phase(phase);
        result = .ENTITY_WIN;
        entity_win_delay_ends_at = 0.0;
        ended_at = get_time();
        unfreeze_entity_if_needed();
        restore_round_end_name_visibility();
        begin_end_game_cutscene();
        log_info("Game_Manager: Entity win", {});
    }

    unfreeze_entity_if_needed :: method() {
        remove_intro_popup_freeze_from_all_players();
        if entity_player, ok := find_player_by_user_id(entity_user_id); ok {
            entity_player.remove_freeze_reason(FREEZE_ENTITY_HEAD_START);
        }
    }

    recalculate_survivors_alive :: method() {
        if phase != .SURVIVOR_HEAD_START && phase != .ACTIVE {
            survivors_alive = 0;
            return;
        }

        alive_count := 0;
        for player: component_iterator(Player) {
            if player == null || !#alive(player.entity) {
                continue;
            }
            if !is_survivor_player(player) || player.is_round_dead() || player.is_round_minion() {
                continue;
            }
            alive_count += 1;
        }

        survivors_alive = alive_count;
        if survivors_alive > 0 {
            entity_win_delay_ends_at = 0.0;
        }
    }
}

start :: proc(player: Player) {
    gm := get_game_manager();
    if !#alive(gm) {
        log_info("start: no game manager found", {});
        return;
    }

    if gm.start_match(true) {
        log_info("start: % force-started the match", {player.get_username()});
    } else {
        log_info("start: unable to start match from current state", {});
    }
} @chat_command @youtuber

revive :: proc(player: Player, target: Player = null) {
    gm := get_game_manager();
    if !#alive(gm) {
        Notifier.notify(player, "No match manager found.");
        return;
    }
    if gm.phase != .SURVIVOR_HEAD_START && gm.phase != .ACTIVE {
        Notifier.notify(player, "Start a round before using /revive.");
        return;
    }

    revive_target := target;
    if revive_target == null {
        revive_target = player;
    }
    if revive_target == null || !#alive(revive_target.entity) {
        Notifier.notify(player, "Revive target not found.");
        return;
    }
    if gm.is_entity_player(revive_target) {
        Notifier.notify(player, "The Entity cannot be revived as a Survivor.");
        return;
    }
    if revive_target.round_dead_was_minion || revive_target.is_round_minion() {
        Notifier.notify(player, "Minions cannot be revived as Survivors.");
        return;
    }

    if revive_target.is_round_dead() {
        if !revive_target.revive_from_dead() {
            Notifier.notify(player, "Could not revive %.", {revive_target.get_username()});
            return;
        }
        gm.recalculate_survivors_alive();
    } else if revive_target.is_round_downed() {
        if !revive_target.revive_from_downed() {
            Notifier.notify(player, "Could not revive %.", {revive_target.get_username()});
            return;
        }
    } else {
        Notifier.notify(player, "% is not dead or downed.", {revive_target.get_username()});
        return;
    }

    Notifier.notify(player, "Revived %.", {revive_target.get_username()});
    if revive_target != player {
        Notifier.notify(revive_target, "You were revived.");
    }
    log_info("revive: % revived %", {player.get_username(), revive_target.get_username()});
} @chat_command @youtuber

task :: proc(player: Player) {
    gm := get_game_manager();
    if !#alive(gm) {
        Notifier.notify(player, "No match manager found.");
        return;
    }
    if gm.phase != .SURVIVOR_HEAD_START && gm.phase != .ACTIVE {
        Notifier.notify(player, "No active task to complete.");
        return;
    }
    if !player.is_round_survivor() {
        Notifier.notify(player, "Only living Survivors have assigned tasks.");
        return;
    }

    completed_task_id := complete_current_assigned_task_cheat(player);
    if completed_task_id.count == 0 {
        Notifier.notify(player, "No available assigned task to complete.");
        return;
    }

    Notifier.notify(player, "Completed task: %.", {get_task_display_name(completed_task_id)});
    log_info("task: % completed % with cheat", {player.get_username(), completed_task_id});
} @chat_command @youtuber

find_zone_cheat_warp :: proc(target_zone: CurrentZone, target_position: v2) -> WarpToBackrooms {
    best_warp: WarpToBackrooms = null;
    best_dist_sq := 999999.0;

    for warp: component_iterator(WarpToBackrooms) {
        if !#alive(warp.entity) || !#alive(warp.destination_entity) {
            continue;
        }
        if warp.current_zone != target_zone {
            continue;
        }

        dist_sq := length_squared(warp.entity.world_position - target_position);
        if dist_sq < best_dist_sq {
            best_dist_sq = dist_sq;
            best_warp = warp;
        }
    }

    return best_warp;
}

zone :: proc(player: Player, zone_number: int) {
    if player == null || !#alive(player.entity) {
        return;
    }

    target_zone: CurrentZone = .None;
    target_position := v2{0.0, 0.0};
    switch zone_number {
        case 1: {
            target_zone = .Zone1;
            target_position = v2{220.1728363037109375, -80.4986801147460938};
        }
        case 2: {
            target_zone = .Zone2;
            target_position = v2{187.8609771728515625, 43.1976203918457031};
        }
        case 3: {
            target_zone = .Zone3;
            target_position = v2{216.7621459960937500, 139.2165527343750000};
        }
        default: {
            Notifier.notify(player, "Usage: /zone 1, /zone 2, or /zone 3.");
            return;
        }
    }

    warp := find_zone_cheat_warp(target_zone, target_position);
    if !#alive(warp) {
        Notifier.notify(player, "Zone % warp not found.", {zone_number});
        return;
    }

    warp.warp_player(player, true);
    Notifier.notify(player, "Warped to zone %.", {zone_number});
    log_info("zone: % warped to zone %", {player.get_username(), zone_number});
} @chat_command @youtuber

end :: proc(player: Player) {
    gm := get_game_manager();
    if !#alive(gm) {
        log_info("end: no game manager found", {});
        return;
    }

    if gm.phase != .SURVIVOR_HEAD_START && gm.phase != .ACTIVE {
        log_info("end: unable to end match from current state", {});
        return;
    }

    gm.end_match_survivors_win();
    log_info("end: % forced a Survivor win", {player.get_username()});
} @chat_command @youtuber

pause :: proc(player: Player) {
    gm := get_game_manager();
    if !#alive(gm) {
        Notifier.notify(player, "No match manager found.");
        return;
    }

    if gm.set_round_timer_paused(true) {
        Notifier.notify(player, "Round timer paused.");
        log_info("pause: % paused the round timer", {player.get_username()});
    } else {
        Notifier.notify(player, "Round timer can only be paused during the hunt.");
    }
} @chat_command @youtuber

resume :: proc(player: Player) {
    gm := get_game_manager();
    if !#alive(gm) {
        Notifier.notify(player, "No match manager found.");
        return;
    }

    if gm.set_round_timer_paused(false) {
        Notifier.notify(player, "Round timer resumed.");
        log_info("resume: % resumed the round timer", {player.get_username()});
    } else {
        Notifier.notify(player, "Round timer can only be resumed during the hunt.");
    }
} @chat_command @youtuber

teleport_player_to_cheat_destination :: proc(player: Player, position: v2, zone: CurrentZone) {
    if player == null || !#alive(player.entity) {
        return;
    }

    if player.security_cameras_open {
        close_security_cameras_for_player(player);
    }

    player.entity.set_local_position(position);
    player.entity.mark_teleported();
    player.current_zone = zone;
    if #alive(player.agent) {
        player.agent.velocity = v2{0.0, 0.0};
    }
    player.snap_local_camera_to_player();
}

find_warp_destination_for_zone :: proc(zone: CurrentZone) -> Entity {
    for warp: component_iterator(WarpToBackrooms) {
        if warp.current_zone == zone && #alive(warp.destination_entity) {
            return warp.destination_entity;
        }
    }
    return null;
}

tp :: proc(player: Player, destination: string = "zone1") {
    gm := get_game_manager();
    if !#alive(gm) {
        Notifier.notify(player, "No match manager found.");
        return;
    }

    target: Entity;
    zone := player.current_zone;

    if destination == "zone1" || destination == "Zone1" || destination == "1" {
        target = find_warp_destination_for_zone(.Zone1);
        if !#alive(target) {
            target = gm.SurvivorSpawn;
        }
        zone = .Zone1;
    } else if destination == "zone2" || destination == "Zone2" || destination == "2" || destination == "entry" || destination == "Entry" {
        target = find_warp_destination_for_zone(.Zone2);
        if !#alive(target) {
            target = Scene.get_entity_by_name("EntryPoint");
        }
        zone = .Zone2;
    } else if destination == "zone3" || destination == "Zone3" || destination == "3" {
        target = Scene.get_entity_by_name("Zone3_GRP");
        zone = .Zone3;
    } else if destination == "lobby" || destination == "Lobby" {
        target = gm.LobbySpawn;
        zone = .None;
    } else if destination == "survivor" || destination == "Survivor" || destination == "spawn" || destination == "Spawn" {
        target = gm.SurvivorSpawn;
        zone = .Zone1;
    } else if destination == "entity" || destination == "Entity" || destination == "entityspawn" || destination == "EntitySpawn" {
        if #alive(gm.round_entity_spawn) {
            target = gm.round_entity_spawn;
        } else {
            target = Scene.get_entity_by_name("EntitySpawns");
        }
        zone = .Zone1;
    }

    if !#alive(target) {
        Notifier.notify(player, "Unknown or unavailable tp target: %", {destination});
        return;
    }

    teleport_player_to_cheat_destination(player, target.world_position, zone);
    Notifier.notify(player, "Teleported to %.", {destination});
} @chat_command @youtuber

set_round_timer :: proc(player: Player, seconds: float) {
    gm := get_game_manager();
    if !#alive(gm) {
        Notifier.notify(player, "No match manager found.");
        return;
    }

    if gm.set_round_timer_seconds(seconds) {
        countdown := get_match_countdown_seconds(gm);
        Notifier.notify(player, "Round timer set to %.", {format_countdown_mm_ss(countdown)});
        log_info("set_round_timer: % set the round timer to % seconds", {player.get_username(), seconds});
    } else {
        Notifier.notify(player, "Round timer can only be set during the hunt.");
    }
} @chat_command @youtuber

fulldie :: proc(player: Player) {
    gm := get_game_manager();
    if !#alive(gm) {
        log_info("fulldie: no game manager found", {});
        return;
    }

    if gm.phase != .SURVIVOR_HEAD_START && gm.phase != .ACTIVE {
        log_info("fulldie: unable to kill player from current state", {});
        return;
    }

    if !player.is_round_survivor() || !#alive(player.entity) {
        log_info("fulldie: % is not a living survivor", {player.get_username()});
        return;
    }

    death_effect := new(Entity_Death_Effect);
    player.entity.set_active_effect(death_effect);
    log_info("fulldie: % forced their own full death", {player.get_username()});
} @chat_command @youtuber

kill_all :: proc(player: Player) {
    gm := get_game_manager();
    if !#alive(gm) {
        log_info("kill_all: no game manager found", {});
        return;
    }

    if gm.phase != .SURVIVOR_HEAD_START && gm.phase != .ACTIVE {
        log_info("kill_all: unable to bite survivors from current state", {});
        return;
    }

    entity_player, found_entity := find_player_by_user_id(gm.entity_user_id);
    if found_entity && #alive(entity_player.entity) {
        entity_player.ensure_entity_override_rig();
        if entity_player.entity_override_state_machine != null {
            entity_player.entity_override_state_machine.set_trigger("bite");
        }
        play_entity_bite_sfx(entity_player);
    }

    downed_count := 0;
    killed_count := 0;
    for survivor: component_iterator(Player) {
        if !survivor.is_round_survivor() {
            continue;
        }
        if !#alive(survivor.entity) {
            continue;
        }

        was_downed := survivor.is_round_downed();
        if !apply_entity_bite_to_survivor(survivor) {
            continue;
        }

        if was_downed {
            killed_count += 1;
        } else {
            downed_count += 1;
        }
    }

    log_info("kill_all: % forced Bite on all survivors (% downed, % killed)", {player.get_username(), downed_count, killed_count});
} @chat_command @youtuber

g :: proc(player: Player, item_id: string) {
    init_weapon_items();

    item_def := get_registered_item_def_by_id(item_id);
    if item_def == null {
        Notifier.notify(player, "Unknown item id: %", {item_id});
        return;
    }

    item := Items.create_item_instance(item_def, 1);
    will_destroy_item: bool;
    if !Items.can_move_item_to_inventory(item, player.default_inventory, ref will_destroy_item) {
        Items.destroy_item_instance(item);
        Notifier.notify(player, "No room for %", {item_def.get_name()});
        return;
    }

    Items.move_item_to_inventory(item, player.default_inventory);
    Notifier.notify(player, "Gave % (%).", {item_def.get_name(), item_def.get_id()});
} @chat_command @youtuber

spawn :: proc(player: Player, item_id: string) {
    if player == null || !#alive(player.entity) {
        return;
    }

    gm := get_game_manager();
    if !#alive(gm) {
        Notifier.notify(player, "No match manager found.");
        return;
    }

    init_weapon_items();
    item_def := get_registered_item_def_by_id(item_id);
    if item_def == null {
        Notifier.notify(player, "Unknown item id: %", {item_id});
        return;
    }

    dropped_item := gm.spawn_round_item_def_at_position(item_def, player.entity.world_position);
    if !#alive(dropped_item) {
        Notifier.notify(player, "Could not spawn %.", {item_def.get_name()});
        return;
    }

    gm.spawned_round_items.append(dropped_item);
    Notifier.notify(player, "Spawned % (%).", {item_def.get_name(), item_def.get_id()});
    log_info("spawn: % spawned % at their position", {player.get_username(), item_def.get_id()});
} @chat_command @youtuber
