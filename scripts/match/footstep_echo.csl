// Expanding ring at a footstep: scales up, fades sprite alpha, self-destructs after `duration_seconds`.
//
// Spine "footstep" animation events are not exposed in the current CSL API bundle for this project.
// We approximate step timing with a stride distance along movement speed and place echoes at the
// streamed character IK foot bones (`foot_L_IK` / `foot_R_IK`). When the engine adds event polling,
// swap `tick_footstep_echo_for_player` to drain `"footstep"` events and use each event's world position.

FOOTSTEP_STRIDE_DISTANCE :: 2.16; // ~1/3 spawn rate vs 0.72
FOOTSTEP_FIRST_SPRINT_DISTANCE :: 0.1;
FOOTSTEP_MIN_SPEED :: 0.12;
FOOTSTEP_MAX_DT :: 0.25;
FOOTSTEP_MAX_ECHOES_PER_TICK :: 3;
ENTITY_HEARING_RADIUS :: 5.0;
ENTITY_HEARING_MIN_SPEED :: 0.02;

FootstepEcho :: class : Component {
    target_scale: v2 @ao_serialize;
    duration_seconds: float @ao_serialize;
    start_alpha: float @ao_serialize;
    owner_user_id: string;

    elapsed: float;
    start_scale: v2;
    sprite: Sprite_Renderer;

    ao_start :: method() {
        elapsed = 0.0;
        if duration_seconds <= 0.0 {
            duration_seconds = 1.0;
        }
        sprite = entity.get_component(Sprite_Renderer);
        if #alive(sprite) {
            start_scale = sprite.scale;
            start_alpha = sprite.color.w;
        } else {
            start_scale = entity.local_scale;
            start_alpha = 1.0;
        }
    }

    ao_update :: method(dt: float) {
        elapsed += dt;
        t := elapsed / duration_seconds;
        if t >= 1.0 {
            entity.destroy();
            return;
        }

        u := 1.0 - pow(1.0 - t, 2.0);

        new_s := v2{
            lerp(start_scale.x, target_scale.x, u),
            lerp(start_scale.y, target_scale.y, u),
        };
        new_a := lerp(start_alpha, 0.0, u);

        if #alive(sprite) {
            sprite.scale = new_s;
            c := sprite.color;
            c.w = new_a;
            sprite.color = c;
        } else {
            entity.set_local_scale(new_s);
        }
    }
}

clear_footstep_echoes_for_user_id :: proc(user_id: string) {
    if user_id.count <= 0 {
        return;
    }

    to_destroy: [..]Entity;
    for echo: component_iterator(FootstepEcho) {
        if echo.owner_user_id == user_id && #alive(echo.entity) {
            to_destroy.append(echo.entity);
        }
    }

    for e: to_destroy {
        if #alive(e) {
            e.destroy();
        }
    }
    to_destroy.clear();
}

clear_footstep_echoes_for_player :: proc(player: Player) {
    if player == null {
        return;
    }

    player.footstep_stride_accum = 0.0;
    clear_entity_local_view_reveal(player);
    clear_footstep_echoes_for_user_id(player.get_user_id());
}

clear_all_footstep_echoes :: proc() {
    to_destroy: [..]Entity;
    for echo: component_iterator(FootstepEcho) {
        if #alive(echo.entity) {
            to_destroy.append(echo.entity);
        }
    }

    for e: to_destroy {
        if #alive(e) {
            e.destroy();
        }
    }
    to_destroy.clear();
}

spawn_footstep_echo :: proc(world_pos: v2, prefab_path: string, owner: Player = null) {
    e: Entity;
    prefab: Prefab_Asset;
    if prefab_path.count > 0 {
        prefab = get_asset(Prefab_Asset, prefab_path);
    }
    if prefab != null {
        e = Scene.instantiate(prefab, world_pos);
    } else {
        e = Scene.create_entity();
        e.set_local_position(world_pos);
        e.set_local_scale({1.0, 1.0});

        sr := e.add_component(Sprite_Renderer);
        tex := get_asset(Texture_Asset, "$AO/circle.png");
        sr.set_texture(tex);
        sr.color = v4{0.85, 0.9, 1.0, 0.45};
        sr.layer = -8;

        fe := e.add_component(FootstepEcho);
        fe.target_scale = v2{2.8, 2.8};
        fe.duration_seconds = 1.0;
        fe.start_alpha = 0.45;
    }

    if e == null return;
    fe2 := e.get_component(FootstepEcho);
    if fe2 == null {
        fe2 = e.add_component(FootstepEcho);
        if fe2.target_scale.x <= 0.0 {
            fe2.target_scale = {2.8, 2.8};
        }
        if fe2.duration_seconds <= 0.0 {
            fe2.duration_seconds = 1.0;
        }
    }

    if owner != null {
        fe2.owner_user_id = owner.get_user_id();
    }
}

get_visible_player_spine :: proc(player: Player) -> Spine_Animator {
    if player.is_round_entity() && #alive(player.override_rig) && #alive(player.override_rig.entity) && player.override_rig.entity.get_local_enabled() {
        return player.override_rig;
    }
    return player.animator;
}

get_footstep_bone_name :: proc(player: Player, left_foot: bool) -> string {
    if player.is_round_entity() && #alive(player.override_rig) && #alive(player.override_rig.entity) && player.override_rig.entity.get_local_enabled() {
        if left_foot return "IK_LegL3";
        return "IK_LegR3";
    }

    if left_foot return "foot_L_IK";
    return "foot_R_IK";
}

spine_bone_to_world :: proc(player: Player, bone_name: string) -> v2 {
    spine := get_visible_player_spine(player);
    if !#alive(spine) || spine.instance == null || !#alive(spine.entity) {
        if #alive(player.entity) {
            return player.entity.world_position;
        }
        return v2{0.0, 0.0};
    }

    local := spine.get_bone_local_position(bone_name);
    sc := spine.scale;
    scaled := v2{local.x * sc.x, local.y * sc.y};
    th := spine.entity.world_rotation;
    c := cos(th);
    s := sin(th);
    rot := v2{scaled.x * c - scaled.y * s, scaled.x * s + scaled.y * c};
    return spine.entity.world_position + rot;
}

ping_player_with_footstep_echo :: proc(player: Player, fade_out_seconds: float) {
    if player == null || !#alive(player.entity) return;
    if player.is_round_entity() || player.is_round_minion() return;
    if is_entity_sound_sight_interfered() return;

    if fade_out_seconds <= 0.0 {
        fade_out_seconds = ENTITY_VIEW_PLAYER_REVEAL_FADE_OUT_SECONDS;
    }

    bone := get_footstep_bone_name(player, player.footstep_left_next);
    wp := spine_bone_to_world(player, bone);
    spawn_footstep_echo(wp, "Echo.prefab", player);
    player.reveal_for_entity_local_view_with_duration(fade_out_seconds);
}

clear_entity_local_view_reveal :: proc(player: Player) {
    if player == null {
        return;
    }

    player.entity_local_view_alpha = 0.0;
    player.entity_local_view_is_active = false;
    player.entity_local_view_fade_out_seconds = ENTITY_VIEW_PLAYER_REVEAL_FADE_OUT_SECONDS;
    player.entity_scream_reveal_remaining = 0.0;
}

is_player_within_entity_hearing_radius :: proc(player: Player) -> bool {
    if player == null || !#alive(player.entity) {
        return false;
    }
    if player.is_round_entity() || player.is_round_minion() || player.is_round_dead() {
        return false;
    }

    radius_sq := ENTITY_HEARING_RADIUS * ENTITY_HEARING_RADIUS;
    origin := player.entity.world_position;
    for other: component_iterator(Player) {
        if other == player continue;
        if !other.is_round_entity() continue;
        if !#alive(other.entity) continue;

        delta := other.entity.world_position - origin;
        distance_sq := delta.x * delta.x + delta.y * delta.y;
        if distance_sq <= radius_sq {
            return true;
        }
    }

    return false;
}

tick_footstep_echo_for_player :: proc(player: Player, dt: float) {
    if player == null return;
    if !#alive(player.entity) return;

    gm := get_game_manager();
    if !#alive(gm) || (gm.phase != .SURVIVOR_HEAD_START && gm.phase != .ACTIVE) {
        player.footstep_stride_accum = 0.0;
        return;
    }

    if player.is_round_dead() {
        player.footstep_stride_accum = 0.0;
        return;
    }
    if player.is_round_downed() {
        player.footstep_stride_accum = 0.0;
        return;
    }
    if player.is_round_entity() || player.is_round_minion() {
        player.footstep_stride_accum = 0.0;
        return;
    }

    if is_entity_sound_sight_interfered() {
        player.footstep_stride_accum = 0.0;
        clear_entity_local_view_reveal(player);
        return;
    }

    agent := player.agent;
    if !#alive(agent) {
        player.footstep_stride_accum = 0.0;
        return;
    }

    speed := length(agent.velocity);
    within_entity_hearing_radius := is_player_within_entity_hearing_radius(player);
    min_speed := FOOTSTEP_MIN_SPEED;
    if !player.sprint_active && within_entity_hearing_radius {
        min_speed = ENTITY_HEARING_MIN_SPEED;
    }

    if speed < min_speed {
        player.footstep_stride_accum = 0.0;
        return;
    }

    if !player.sprint_active && !within_entity_hearing_radius {
        player.footstep_stride_accum = 0.0;
        return;
    }

    if player.footstep_stride_accum <= 0.0 {
        player.footstep_stride_accum = FOOTSTEP_STRIDE_DISTANCE - FOOTSTEP_FIRST_SPRINT_DISTANCE;
    }

    clamped_dt := min(dt, FOOTSTEP_MAX_DT);
    player.footstep_stride_accum += speed * clamped_dt;

    max_stride_accum := FOOTSTEP_STRIDE_DISTANCE * FOOTSTEP_MAX_ECHOES_PER_TICK.(float);
    if player.footstep_stride_accum > max_stride_accum {
        player.footstep_stride_accum = max_stride_accum;
    }

    emitted: s64 = 0;
    while player.footstep_stride_accum >= FOOTSTEP_STRIDE_DISTANCE && emitted < FOOTSTEP_MAX_ECHOES_PER_TICK {
        player.footstep_stride_accum -= FOOTSTEP_STRIDE_DISTANCE;

        ping_player_with_footstep_echo(player, ENTITY_VIEW_PLAYER_REVEAL_FADE_OUT_SECONDS);
        player.footstep_left_next = !player.footstep_left_next;
        emitted += 1;
    }

    if emitted >= FOOTSTEP_MAX_ECHOES_PER_TICK && player.footstep_stride_accum >= FOOTSTEP_STRIDE_DISTANCE {
        player.footstep_stride_accum = FOOTSTEP_STRIDE_DISTANCE - FOOTSTEP_FIRST_SPRINT_DISTANCE;
    }
}
