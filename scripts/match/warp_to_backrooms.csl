import "core:ao"

WARP_TO_BACKROOMS_PROMPT :: "Enter the Backrooms";
WARP_TO_NEXT_LEVEL_PROMPT :: "To Next Level";

WarpToBackrooms :: class : Interactable {
    destination_entity: Entity @ao_serialize;
    RequireReconnectWires: bool @ao_serialize;
    RequireLevers: bool @ao_serialize;
    current_zone: CurrentZone @ao_serialize;

    ao_start :: method() {
        this.set_listener(this);
        if RequireReconnectWires || RequireLevers {
            this.set_text(WARP_TO_NEXT_LEVEL_PROMPT);
        } else {
            this.set_text(WARP_TO_BACKROOMS_PROMPT);
        }
        required_hold_time = 0.0;
        priority = 10;
    }

    can_use :: method(player: Player) -> bool {
        if player == null || !#alive(player.entity) {
            return false;
        }
        if !#alive(destination_entity) {
            return false;
        }

        is_survivor := player.is_round_survivor();
        is_entity := player.is_round_entity();
        if !is_survivor && !is_entity {
            return false;
        }

        if is_survivor && RequireReconnectWires && !is_task_completed(player, TASK_ID_RECONNECT_WIRE) {
            return false;
        }
        if is_survivor && RequireLevers && !is_task_completed(player, TASK_ID_PULL_BOTH_LEVERS) {
            return false;
        }
        return true;
    }

    on_interact :: method(player: Player) {
        if !can_use(player) {
            return;
        }

        this.warp_player(player, true);
    }

    warp_player :: method(player: Player, register_zone_progression: bool) {
        if player == null || !#alive(player.entity) || !#alive(destination_entity) {
            return;
        }

        if player.security_cameras_open {
            close_security_cameras_for_player(player);
        }

        player.entity.set_local_position(destination_entity.world_position);
        player.entity.mark_teleported();
        player.current_zone = current_zone;
        if #alive(player.agent) {
            player.agent.velocity = v2{0.0, 0.0};
        }

        if register_zone_progression && player.is_round_survivor() && RequireReconnectWires {
            gm := get_game_manager();
            if #alive(gm) {
                gm.register_survivor_reached_next_zone(player);
            }
        }

        player.snap_local_camera_to_player();
        player.trigger_warp_to_backrooms_static();
    }
}
