import "core:ao"

ENTITY_SCREAM_EFFECT_SECONDS :: 0.8;
ENTITY_SCREAM_COOLDOWN_SECONDS :: 15.0;
ENTITY_SCREAM_REVEAL_FADE_OUT_SECONDS :: 5.0;
ENTITY_SCREAM_ARROW_SECONDS :: 5.0;

play_entity_scream_sfx :: proc(player: Player) {
    if player == null || !#alive(player.entity) return;

    desc := SFX.default_sfx_desc();
    desc.entity_to_follow = player.entity.id;
    desc.volume = 1;
    desc.range_multiplier = 7.0;
    SFX.play(get_asset(SFX_Asset, "SFX/entityscream.wav"), desc);
}

players_are_in_same_active_zone :: proc(a: Player, b: Player) -> bool {
    if a == null || b == null {
        return false;
    }
    if a.current_zone == .None || b.current_zone == .None {
        return false;
    }
    return a.current_zone == b.current_zone;
}

entity_player_has_active_action_ping_for_survivor :: proc(entity_player: Player, survivor: Player) -> bool {
    if entity_player == null || survivor == null {
        return false;
    }
    if entity_player.entity_target_ping_remaining <= 0.0 {
        return false;
    }
    if entity_player.entity_target_ping_user_id != survivor.get_user_id() {
        return false;
    }
    if entity_player.entity_target_ping_requires_same_zone {
        zone := entity_player.entity_target_ping_source_zone;
        if zone == .None || entity_player.current_zone != zone || survivor.current_zone != zone {
            return false;
        }
    }

    return true;
}

ping_survivor_with_entity_scream :: proc(entity_player: Player, survivor: Player, require_same_zone: bool = false, show_action_ping: bool = true) {
    if survivor == null || !#alive(survivor.entity) {
        return;
    }
    if !survivor.is_round_survivor() || survivor.is_round_dead() {
        return;
    }
    if require_same_zone && !players_are_in_same_active_zone(entity_player, survivor) {
        return;
    }

    sound_sight_interfered := is_entity_sound_sight_interfered();
    ping_player_with_footstep_echo(survivor, ENTITY_SCREAM_REVEAL_FADE_OUT_SECONDS);
    survivor.reveal_for_entity_scream_local_view(ENTITY_SCREAM_REVEAL_FADE_OUT_SECONDS);

    if entity_player == null || !#alive(entity_player.entity) {
        return;
    }

    if show_action_ping && !entity_player_has_active_action_ping_for_survivor(entity_player, survivor) {
        entity_player.show_entity_target_ping_arrow(survivor, ENTITY_SCREAM_ARROW_SECONDS, require_same_zone);
    }

    if !sound_sight_interfered {
        gm := get_game_manager();
        navmesh: Navmesh;
        if #alive(gm) {
            navmesh = gm.get_navmesh_to_lock_to();
        }
        spawn_entity_scream_nav_path_probe(entity_player, survivor, navmesh, ENTITY_SCREAM_PATH_SECONDS, require_same_zone);
    }
}

ping_all_survivors_with_entity_scream :: proc(entity_player: Player) {
    if entity_player != null {
        entity_player.show_entity_scream_arrows(ENTITY_SCREAM_ARROW_SECONDS, false);
    }

    pinged_user_ids: [..]string;
    for other: component_iterator(Player) {
        if other == entity_player continue;
        if !other.is_round_survivor() continue;
        if other.is_round_dead() continue;
        if entity_player_has_active_action_ping_for_survivor(entity_player, other) continue;

        other_user_id := other.get_user_id();
        if other_user_id.count <= 0 continue;

        already_pinged := false;
        for pinged_user_id: pinged_user_ids {
            if pinged_user_id == other_user_id {
                already_pinged = true;
                break;
            }
        }
        if already_pinged continue;

        pinged_user_ids.append(other_user_id);
        entity_player.add_entity_scream_arrow_target(other);
        ping_survivor_with_entity_scream(entity_player, other, false, false);
    }
}

Entity_Scream_Effect :: class : Effect_Base {
    effect_start :: method() {
        player_specific.freeze_player = true;
        set_duration(ENTITY_SCREAM_EFFECT_SECONDS);

        if player == null return;
        if !player.ensure_entity_override_rig() return;
        if player.entity_override_state_machine == null return;

        player.entity_override_state_machine.set_trigger("scream");
    }
}

Entity_Scream_Ability :: class : Ability_Base {
    on_init :: method() {
        name = "Scream";
        icon = get_asset(Texture_Asset, "AbilityIcons/Scream.png");
    }

    can_use :: method() -> bool {
        if player == null || !player.is_round_entity() {
            return false;
        }

        gm := get_game_manager();
        if !#alive(gm) || gm.phase != .ACTIVE {
            return false;
        }

        if !player.ensure_entity_override_rig() {
            return false;
        }

        return player.entity.get_active_effect() == null;
    }

    on_update :: method(params: ref Ability_Update_Params) {
        if !params.clicked || !params.can_use {
            return;
        }

        effect := new(Entity_Scream_Effect);
        player.entity.set_active_effect(effect);

        play_entity_scream_sfx(player);
        ping_all_survivors_with_entity_scream(player);

        current_cooldown = ENTITY_SCREAM_COOLDOWN_SECONDS;
    }

    on_draw_button :: proc(instance: Entity_Scream_Ability, rect: Rect) {
		draw_ability_name_label(rect, "Scream");
	}

    
}
