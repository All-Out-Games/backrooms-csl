ROLE_SELECTION_UI_LAYER :: 9800;
SURVIVOR_INTRO_STATIC_UI_LAYER :: 9900;
SURVIVOR_INTRO_STATIC_SECONDS :: 1.0;
SURVIVOR_INTRO_CHROMATIC_TARGET := v3.{0.25, 0.1, 0.3};

Round_Role :: enum {
    NONE;
    SURVIVOR;
    ENTITY;
}

role_selection_player_role :: proc(player: Player) -> Round_Role {
    gm := get_game_manager();
    if !#alive(gm) || player == null {
        return .NONE;
    }
    if gm.is_entity_player(player) {
        return .ENTITY;
    }
    if gm.is_survivor_player(player) {
        return .SURVIVOR;
    }
    return .NONE;
}

role_selection_role_name :: proc(role: Round_Role) -> string {
    switch role {
        case .SURVIVOR: return "Survivor";
        case .ENTITY: return "Bacteria Monster";
        default: {}
    }
    return "Unknown";
}

role_selection_category_name :: proc(role: Round_Role) -> string {
    switch role {
        case .SURVIVOR: return "SURVIVOR";
        case .ENTITY: return "Monster";
        default: {}
    }
    return "UNKNOWN";
}

role_selection_role_color :: proc(role: Round_Role) -> v4 {
    switch role {
        case .SURVIVOR: return v4{0.20, 0.72, 1.0, 1.0};
        case .ENTITY: return v4{1.0, 0.16, 0.12, 1.0};
        default: {}
    }
    return v4{1.0, 1.0, 1.0, 1.0};
}

draw_survivor_intro_static_ui :: proc(player: Player) {
    gm := get_game_manager();
    if !#alive(gm) || player == null || !player.is_local() {
        return;
    }
    if gm.phase != .SURVIVOR_HEAD_START || role_selection_player_role(player) == .NONE {
        return;
    }
    if gm.role_selection_started_at <= 0.0 || gm.role_selection_ends_at <= 0.0 {
        return;
    }

    now := get_time();
    start_elapsed := now - gm.role_selection_started_at;
    end_elapsed := now - gm.role_selection_ends_at;
    post_fade_elapsed := now - gm.get_intro_spawn_transition_ends_at();
    static_alpha := 0.0;
    chromatic_t := 0.0;

    if start_elapsed >= 0.0 && start_elapsed < SURVIVOR_INTRO_STATIC_SECONDS {
        t := clamp(start_elapsed / SURVIVOR_INTRO_STATIC_SECONDS, 0.0, 1.0);
        static_alpha = 1.0 - pow(t, 2.0);
        chromatic_t = t;
    } else if start_elapsed >= SURVIVOR_INTRO_STATIC_SECONDS && start_elapsed < SURVIVOR_INTRO_STATIC_SECONDS * 2.0 {
        t := clamp((start_elapsed - SURVIVOR_INTRO_STATIC_SECONDS) / SURVIVOR_INTRO_STATIC_SECONDS, 0.0, 1.0);
        chromatic_t = 1.0 - t;
    } else if end_elapsed >= 0.0 && end_elapsed < SURVIVOR_INTRO_STATIC_SECONDS {
        t := clamp(end_elapsed / SURVIVOR_INTRO_STATIC_SECONDS, 0.0, 1.0);
        static_alpha = 1.0 - pow(t, 2.0);
        chromatic_t = t;
    } else if end_elapsed >= SURVIVOR_INTRO_STATIC_SECONDS && end_elapsed < SURVIVOR_INTRO_STATIC_SECONDS * 2.0 {
        t := clamp((end_elapsed - SURVIVOR_INTRO_STATIC_SECONDS) / SURVIVOR_INTRO_STATIC_SECONDS, 0.0, 1.0);
        chromatic_t = 1.0 - t;
    } else if post_fade_elapsed >= 0.0 && post_fade_elapsed < SURVIVOR_INTRO_STATIC_SECONDS {
        t := clamp(post_fade_elapsed / SURVIVOR_INTRO_STATIC_SECONDS, 0.0, 1.0);
        static_alpha = 1.0 - pow(t, 2.0);
        chromatic_t = t;
    } else if post_fade_elapsed >= SURVIVOR_INTRO_STATIC_SECONDS && post_fade_elapsed < SURVIVOR_INTRO_STATIC_SECONDS * 2.0 {
        t := clamp((post_fade_elapsed - SURVIVOR_INTRO_STATIC_SECONDS) / SURVIVOR_INTRO_STATIC_SECONDS, 0.0, 1.0);
        chromatic_t = 1.0 - t;
    }

    if static_alpha <= 0.0 && chromatic_t <= 0.0 {
        return;
    }

    if chromatic_t > 0.0 {
        chromatic := Post_Processing.Chromatic_Aberration_Config{
            channel_offsets = v3{
                lerp(0.0, SURVIVOR_INTRO_CHROMATIC_TARGET.x, chromatic_t),
                lerp(0.0, SURVIVOR_INTRO_CHROMATIC_TARGET.y, chromatic_t),
                lerp(0.0, SURVIVOR_INTRO_CHROMATIC_TARGET.z, chromatic_t)
            },
            focal_point = v2{0.5, 0.5}
        };
        Post_Processing.chromatic_aberration(chromatic);
    }

    if static_alpha <= 0.0 {
        return;
    }

    UI.push_screen_draw_context();
    defer UI.pop_draw_context();
    UI.push_layer(SURVIVOR_INTRO_STATIC_UI_LAYER);
    defer UI.pop_layer();

    screen := UI.get_screen_rect();
    UI.quad(screen, core_globals.white_sprite, v4{0.02, 0.025, 0.03, 0.42 * static_alpha});

    stripe_height := 4.0;
    stripe_gap := 14.0;
    stripe_offset := (get_time() * 190.0) % stripe_gap;
    y := screen.min.y - stripe_offset;
    while y < screen.max.y {
        stripe_rect := Rect{
            min = v2{screen.min.x, y},
            max = v2{screen.max.x, y + stripe_height}
        };
        UI.quad(stripe_rect, core_globals.white_sprite, v4{1.0, 1.0, 1.0, 0.16 * static_alpha});
        y += stripe_gap;
    }

    rng: u64 = get_frame_number() * 1103515245 + 12345;
    for i: 0..17 {
        block_w := rng_range_float(ref rng, 45.0, 220.0);
        block_h := rng_range_float(ref rng, 3.0, 12.0);
        block_x := rng_range_float(ref rng, screen.min.x, screen.max.x - block_w);
        block_y := rng_range_float(ref rng, screen.min.y, screen.max.y - block_h);
        block_alpha := rng_range_float(ref rng, 0.08, 0.26) * static_alpha;
        block_rect := Rect{
            min = v2{block_x, block_y},
            max = v2{block_x + block_w, block_y + block_h}
        };
        UI.quad(block_rect, core_globals.white_sprite, v4{0.75, 0.9, 1.0, block_alpha});
    }
}

draw_role_selection_ui :: proc(player: Player) {
    gm := get_game_manager();
    if !#alive(gm) || gm.phase != .SURVIVOR_HEAD_START || gm.role_selection_ends_at <= 0.0 || get_time() >= gm.role_selection_ends_at {
        return;
    }

    target_role := role_selection_player_role(player);
    if target_role == .NONE {
        return;
    }

    elapsed := get_time() - gm.role_selection_started_at;
    if elapsed < 0.0 {
        elapsed = 0.0;
    }

    UI.push_screen_draw_context();
    defer UI.pop_draw_context();
    UI.push_layer(ROLE_SELECTION_UI_LAYER);
    defer UI.pop_layer();

    screen := UI.get_screen_rect();

    fade_in := clamp(elapsed / 0.25, 0.0, 1.0);
    fade_out := clamp((gm.role_selection_ends_at - get_time()) / 0.35, 0.0, 1.0);
    alpha := min(fade_in, fade_out);

    bg_progress := clamp(elapsed / 0.5, 0.0, 1.0);
    player_progress := clamp((elapsed - 0.3) / 0.8, 0.0, 1.0);
    type_progress := clamp((elapsed - 0.6) / 0.6, 0.0, 1.0);
    role_progress := clamp((elapsed - 0.9) / 0.6, 0.0, 1.0);

    bg_alpha := Ease.out_cubic(bg_progress) * alpha;
    player_scale := Ease.out_back(player_progress);
    type_ease := Ease.out_back(type_progress) * alpha;
    role_ease := Ease.out_elastic(role_progress) * alpha;

    bg_texture := get_asset(Texture_Asset, "UI/IntroBackdrop.png");
    if bg_texture != null {
        bg_rect := screen.fit_aspect(bg_texture.get_aspect(), .KEEP_BIGGER);
        UI.quad(bg_rect, bg_texture, v4{1.0, 1.0, 1.0, bg_alpha});
    } else {
        UI.quad(screen, core_globals.white_sprite, v4{0.0, 0.0, 0.0, bg_alpha});
    }

    spine_size := 150.0 * player_scale;
    spine_rect := screen.center_rect().grow(spine_size);
    spine_rect = spine_rect.offset(0.0, -400.0);

    if player != null && target_role == .ENTITY && player.ensure_entity_override_rig() && #alive(player.override_rig) && player.override_rig.instance != null {
        player.override_rig.set_animation("idle", true, 0);
        UI.spine(spine_rect.center(), player.override_rig.instance, v2{200.0, 200.0}, 0.0);
    } else if player != null && player.animator != null && player.animator.instance != null {
        UI.push_player_material(player);
        UI.spine(spine_rect.center(), player.animator.instance, v2{200.0, 200.0}, 0.0);
        UI.pop_material();
    }

    type_color := role_selection_role_color(target_role);

    role_name := role_selection_role_name(target_role);
    if target_role != .NONE && role_name != "" {
        rs := UI.default_text_settings();
        rs.size = 64;
        rs.color = v4{1.0, 0.9, 0.3, role_ease};
        rs.outline_color.w = role_ease;
        rs.drop_shadow_color.w = role_ease;
        rs.halign = .CENTER;
        rs.valign = .CENTER;

        role_rect := screen.center_rect().grow(200.0);
        role_rect = role_rect.offset(0.0, 90.0 + 50.0 * (1.0 - role_ease));
        UI.text(role_rect, rs, role_name);
    }

    label_ts := UI.default_text_settings();
    label_ts.size = 45;
    label_ts.color = v4{1.0, 1.0, 1.0, type_ease * 0.8};
    label_ts.outline_color.w = type_ease * 0.8;
    label_ts.drop_shadow_color.w = type_ease * 0.8;
    label_ts.halign = .CENTER;
    label_ts.valign = .CENTER;

    label_rect := screen.center_rect().grow(150.0);
    label_rect = label_rect.offset(0.0, 200.0);
    UI.text(label_rect, label_ts, "You are a...");
}
