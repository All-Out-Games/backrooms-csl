import "core:ao"

ENTITY_BITE_RANGE :: 1.5;
ENTITY_BITE_EFFECT_SECONDS :: 0.567;
ENTITY_BITE_COOLDOWN_SECONDS :: 5.0;
ENTITY_BITE_DEATH_FREEZE_SECONDS :: 2.0;

play_entity_bite_sfx :: proc(player: Player) {
    if player == null || !#alive(player.entity) return;

    desc := SFX.default_sfx_desc();
    desc.entity_to_follow = player.entity.id;
    desc.local_only = false;
    desc.volume = 1.15;
    SFX.play(get_asset(SFX_Asset, "SFX/entitybite.wav"), desc);
}

find_entity_bite_target :: proc(entity_player: Player) -> Player {
    if entity_player == null || !#alive(entity_player.entity) {
        return null;
    }

    best_target: Player;
    best_distance_sq := ENTITY_BITE_RANGE * ENTITY_BITE_RANGE;
    found_target := false;
    origin := entity_player.entity.world_position;

    for other: component_iterator(Player) {
        if other == entity_player continue;
        if !other.is_round_survivor() continue;
        if !#alive(other.entity) continue;
        if other.entity_local_view_alpha <= 0.0 continue;

        delta := other.entity.world_position - origin;
        distance_sq := delta.x * delta.x + delta.y * delta.y;
        if distance_sq > ENTITY_BITE_RANGE * ENTITY_BITE_RANGE continue;

        if !found_target || distance_sq < best_distance_sq {
            best_target = other;
            best_distance_sq = distance_sq;
            found_target = true;
        }
    }

    if !found_target {
        return null;
    }
    return best_target;
}

Entity_Death_Effect :: class : Effect_Base {
    effect_start :: method() {
        if player == null {
            return;
        }

        player.mark_round_dead();
        player_specific.freeze_player = true;
        set_duration(ENTITY_BITE_DEATH_FREEZE_SECONDS);

        if player.animator != null && player.animator.instance != null {
            player.animator.state_machine.set_bool("ghost_form", false);
            player.animator.set_animation("Death_No_HP", false, 0);
        }
    }

    effect_end :: method(interrupt: bool) {
        if player == null {
            return;
        }

        gm := get_game_manager();
        if !#alive(gm) || (gm.phase != .SURVIVOR_HEAD_START && gm.phase != .ACTIVE) {
            return;
        }

        player.add_invisibility_reason(ENTITY_DEAD_INVISIBILITY_REASON);
        if player.animator != null && player.animator.instance != null {
            player.animator.state_machine.set_bool("ghost_form", true);
            player.animator.state_machine.set_trigger("RESET");
        }
    }
}

Entity_Bite_Effect :: class : Effect_Base {
    effect_start :: method() {
        player_specific.freeze_player = true;
        set_duration(ENTITY_BITE_EFFECT_SECONDS);

        if player == null {
            return;
        }
        if !player.ensure_entity_override_rig() {
            return;
        }
        if player.entity_override_state_machine == null {
            return;
        }

        player.entity_override_state_machine.set_trigger("bite");

        target := find_entity_bite_target(player);
        if target == null {
            return;
        }

        death_effect := new(Entity_Death_Effect);
        target.entity.set_active_effect(death_effect);
    }
}

Entity_Bite_Ability :: class : Ability_Base {
    on_init :: method() {
        name = "Bite";
        icon = get_asset(Texture_Asset, "AbilityIcons/Bite.png");
    }

    can_use :: method() -> bool {
        if player == null || !player.is_round_entity() {
            return false;
        }

        gm := get_game_manager();
        if !#alive(gm) || gm.phase != .ACTIVE {
            return false;
        }

        if !player.ensure_entity_override_rig() {
            return false;
        }

        return player.entity.get_active_effect() == null;
    }

    on_update :: method(params: ref Ability_Update_Params) {
        if !params.clicked || !params.can_use {
            return;
        }

        effect := new(Entity_Bite_Effect);
        player.entity.set_active_effect(effect);
        play_entity_bite_sfx(player);
        current_cooldown = ENTITY_BITE_COOLDOWN_SECONDS;
    }

    on_draw_button :: proc(instance: Entity_Bite_Ability, rect: Rect) {
        draw_ability_name_label(rect, "Bite");
    }
}
