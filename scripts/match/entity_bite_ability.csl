import "core:ao"

ENTITY_BITE_RANGE :: 2.25;
ENTITY_BITE_EFFECT_SECONDS :: 0.567;
ENTITY_BITE_COOLDOWN_SECONDS :: 5.0;
ENTITY_BITE_DEATH_FREEZE_SECONDS :: 2.0;
DOWNED_SCREAM_EFFECT_SECONDS :: 0.9;
DOWNED_SURVIVOR_SCREAM_SFX_PATH :: "SFX/battle_cry.wav";

play_entity_bite_sfx :: proc(player: Player) {
    if player == null || !#alive(player.entity) return;

    desc := SFX.default_sfx_desc();
    desc.entity_to_follow = player.entity.id;
    desc.local_only = false;
    desc.volume = 1.15;
    SFX.play(get_asset(SFX_Asset, "SFX/entitybite.wav"), desc);
}

play_downed_survivor_scream_sfx :: proc(player: Player) {
    if player == null || !#alive(player.entity) return;

    desc := SFX.default_sfx_desc();
    desc.entity_to_follow = player.entity.id;
    desc.local_only = false;
    desc.volume = 0.9;
    desc.range_multiplier = 5.0;
    desc.speed_perturb = 0.08;
    SFX.play(get_asset(SFX_Asset, DOWNED_SURVIVOR_SCREAM_SFX_PATH), desc);
}

reveal_downed_player_with_echo :: proc(player: Player, fade_out_seconds: float = ENTITY_VIEW_PLAYER_REVEAL_FADE_OUT_SECONDS) {
    if player == null || !#alive(player.entity) {
        return;
    }
    if player.is_round_entity() || player.is_round_dead() {
        return;
    }
    if is_entity_sound_sight_interfered() {
        return;
    }

    if fade_out_seconds <= 0.0 {
        fade_out_seconds = ENTITY_VIEW_PLAYER_REVEAL_FADE_OUT_SECONDS;
    }

    spawn_footstep_echo(player.entity.world_position, "Echo.prefab", player);
    player.reveal_for_entity_local_view_with_duration(fade_out_seconds);
}

find_entity_bite_target :: proc(entity_player: Player) -> Player {
    if entity_player == null || !#alive(entity_player.entity) {
        return null;
    }

    best_target: Player;
    best_distance_sq := ENTITY_BITE_RANGE * ENTITY_BITE_RANGE;
    found_target := false;
    origin := entity_player.entity.world_position;

    for other: component_iterator(Player) {
        if other == entity_player continue;
        if !other.is_round_survivor() continue;
        if !#alive(other.entity) continue;
        if !other.is_round_downed() && other.entity_local_view_alpha <= 0.0 continue;

        delta := other.entity.world_position - origin;
        distance_sq := delta.x * delta.x + delta.y * delta.y;
        if distance_sq > ENTITY_BITE_RANGE * ENTITY_BITE_RANGE continue;

        if !found_target || distance_sq < best_distance_sq {
            best_target = other;
            best_distance_sq = distance_sq;
            found_target = true;
        }
    }

    if !found_target {
        return null;
    }
    return best_target;
}

Entity_Death_Effect :: class : Effect_Base {
    effect_start :: method() {
        if player == null || !#alive(player.entity) {
            return;
        }

        player_specific.freeze_player = true;
        set_duration(ENTITY_BITE_DEATH_FREEZE_SECONDS);

        if player.animator != null && player.animator.instance != null {
            player.start_round_death_animation();
        }

        // End the round only after the death effect is fully configured.
        player.mark_round_dead();
    }

    effect_end :: method(interrupt: bool) {
        if player == null || !#alive(player.entity) {
            return;
        }
        player.enter_round_dead_ghost_state();
    }
}

Entity_Downed_Effect :: class : Effect_Base {
    effect_start :: method() {
        if player == null || !#alive(player.entity) {
            return;
        }

        player_specific.freeze_player = true;
        set_duration(ENTITY_BITE_EFFECT_SECONDS);
        player.mark_round_downed();
        player.start_downed_hit_reaction();
    }

    effect_end :: method(interrupt: bool) {
        if player == null || !#alive(player.entity) {
            return;
        }

        player.end_downed_hit_reaction();
    }
}

Downed_Scream_Effect :: class : Effect_Base {
    effect_start :: method() {
        if player == null || !#alive(player.entity) {
            return;
        }

        player_specific.freeze_player = true;
        set_duration(DOWNED_SCREAM_EFFECT_SECONDS);

        if #alive(player.agent) {
            player.agent.velocity = v2{0.0, 0.0};
        }

        player.start_downed_hit_reaction();
        play_downed_survivor_scream_sfx(player);
        reveal_downed_player_with_echo(player);
    }

    effect_end :: method(interrupt: bool) {
        if player == null || !#alive(player.entity) {
            return;
        }

        player.end_downed_hit_reaction();
    }
}

apply_entity_bite_to_survivor :: proc(target: Player) -> bool {
    if target == null || !#alive(target.entity) {
        return false;
    }
    if !target.is_round_survivor() {
        return false;
    }

    if target.is_round_downed() {
        death_effect := new(Entity_Death_Effect);
        target.entity.set_active_effect(death_effect);
        return true;
    }

    downed_effect := new(Entity_Downed_Effect);
    target.entity.set_active_effect(downed_effect);
    return true;
}

Entity_Bite_Effect :: class : Effect_Base {
    effect_start :: method() {
        player_specific.freeze_player = true;
        set_duration(ENTITY_BITE_EFFECT_SECONDS);

        if player == null {
            return;
        }
        if !player.ensure_entity_override_rig() {
            return;
        }
        if player.entity_override_state_machine == null {
            return;
        }

        player.entity_override_state_machine.set_trigger("bite");

        target := find_entity_bite_target(player);
        if target == null {
            return;
        }

        apply_entity_bite_to_survivor(target);
    }
}

Entity_Bite_Ability :: class : Ability_Base {
    on_init :: method() {
        name = "Bite";
        icon = get_asset(Texture_Asset, "AbilityIcons/Bite.png");
    }

    can_use :: method() -> bool {
        if player == null || !player.is_round_entity() {
            return false;
        }

        gm := get_game_manager();
        if !#alive(gm) || gm.phase != .ACTIVE {
            return false;
        }

        if !player.ensure_entity_override_rig() {
            return false;
        }

        return player.entity.get_active_effect() == null;
    }

    on_update :: method(params: ref Ability_Update_Params) {
        if !params.clicked || !params.can_use {
            return;
        }

        effect := new(Entity_Bite_Effect);
        player.entity.set_active_effect(effect);
        play_entity_bite_sfx(player);
        current_cooldown = ENTITY_BITE_COOLDOWN_SECONDS;
    }

    on_draw_button :: proc(instance: Entity_Bite_Ability, rect: Rect) {
        draw_ability_name_label(rect, "Bite");
    }
}
